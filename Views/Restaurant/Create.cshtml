@model DACS.Models.Restaurant
@{
    ViewData["Title"] = "Gửi yêu cầu thêm quán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="admin-container animate-in">
    <div class="section-header">
        <h1 class="section-title">
            <span class="icon">➕</span> Gửi yêu cầu thêm quán
        </h1>
        <a asp-action="Index" asp-controller="Home" class="btn-outline-custom">⬅️ Quay lại map</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-glass success mb-4">
            ✅ @TempData["Success"]
        </div>
    }

    <div class="card-glass p-0">
        <div class="row g-0">
            @* ── Left Form ── *@
            <div class="col-md-6 border-end" style="border-color:var(--border)!important">
                <form asp-action="Create" enctype="multipart/form-data" class="p-4 p-md-5">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label-custom">Tên quán ăn *</label>
                        <input asp-for="Name" class="form-control-custom" placeholder="Nhập tên quán..." />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label-custom">Số điện thoại liên hệ</label>
                        <input asp-for="PhoneNumber" class="form-control-custom" placeholder="VD: 0901234567..." />
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PriceRange" class="form-label-custom">Tầm giá (VD: 50k - 200k)</label>
                        <input asp-for="PriceRange" class="form-control-custom" placeholder="Nhập khoảng giá..." />
                        <span asp-validation-for="PriceRange" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label-custom">Địa chỉ chi tiết</label>
                        <input asp-for="Address" class="form-control-custom" placeholder="Ví dụ: 123 Lê Lợi..." />
                        <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <label asp-for="Latitude" class="form-label-custom">Vĩ độ (Lat)</label>
                            <input asp-for="Latitude" id="lat" class="form-control-custom" placeholder="10.8231" readonly />
                        </div>
                        <div class="col-6">
                            <label asp-for="Longitude" class="form-label-custom">Kinh độ (Lng)</label>
                            <input asp-for="Longitude" id="lng" class="form-control-custom" placeholder="106.6297" readonly />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="IsCafe" class="form-label-custom">Loại hình địa điểm</label>
                        <select asp-for="IsCafe" class="form-control-custom">
                            <option value="false">🍴 Nhà hàng / Quán ăn</option>
                            <option value="true">☕ Quán Cafe / Trà sữa</option>
                        </select>
                        <span asp-validation-for="IsCafe" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label-custom">Mô tả thêm</label>
                        <textarea asp-for="Description" class="form-control-custom" rows="3" placeholder="Ghi chú về địa điểm này..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label-custom">Hình ảnh đại diện</label>
                        <div class="drag-drop-zone" id="dragDropZone">
                            <span class="drag-drop-icon">☁️</span>
                            <span class="drag-drop-text">Kéo thả hình ảnh vào đây hoặc nhấp để chọn file</span>
                            <span class="drag-drop-subtext">Hỗ trợ các định dạng: PNG, JPG, JPEG, WEBP</span>
                            <input type="file" name="image" id="imageInput" class="d-none" accept="image/*" />
                        </div>
                        <div class="mt-3 text-center" style="display:none;" id="imagePreviewContainer">
                            <img id="imagePreview" src="" alt="Image Preview" style="max-width: 100%; height: auto; border-radius: 10px; max-height: 200px; object-fit: cover; border: 1px solid var(--border);" />
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-custom w-100 justify-content-center">
                        💾 Gửi yêu cầu xét duyệt
                    </button>
                    
                    <div class="text-center mt-3 text-muted small">
                        Latitude & Longitude sẽ tự động điền khi click trên bản đồ
                    </div>
                </form>
            </div>

            @* ── Right Mini Map ── *@
            <div class="col-md-6 p-4 p-md-5 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <label class="form-label-custom mb-0">Chọn vị trí trên bản đồ</label>
                    <button type="button" id="locateMe" class="btn-locate-me">
                        <span id="locateMeIcon">📍</span>
                        <span id="locateMeText">Vị trí của tôi</span>
                    </button>
                </div>
                <div class="mini-map-wrapper flex-grow-1" style="min-height:450px;">
                    <div id="mini-map" style="height: 100%; min-height: 450px;"></div>
                </div>
                <div class="mini-map-tip mt-3">
                    <span style="font-size:1.2rem">👆</span>
                    <span>Click vào bản đồ để thả ghim 📍 hoặc dùng nút <strong>Vị trí của tôi</strong> để tự động định vị!</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
    .btn-locate-me {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        border: none;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 2px 10px rgba(102,126,234,0.35);
        white-space: nowrap;
    }
    .btn-locate-me:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(102,126,234,0.5);
    }
    .btn-locate-me:active {
        transform: translateY(0);
    }
    .btn-locate-me.loading {
        opacity: 0.75;
        cursor: not-allowed;
        pointer-events: none;
    }
    .locate-pulse {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.5);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
<script>
    var map = L.map('mini-map').setView([10.8231, 106.6297], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

    setTimeout(function() {
        map.invalidateSize();
    }, 500);

    new ResizeObserver(function() {
        map.invalidateSize();
    }).observe(document.getElementById('mini-map'));

    var marker = null;
    var myLocationMarker = null;
    var latInput = document.getElementById('lat');
    var lngInput = document.getElementById('lng');

    function reverseGeocode(lat, lng) {
        const addressInput = document.getElementById('Address');
        if (!addressInput) return;
        
        addressInput.value = '⏳ Đang định vị địa chỉ...';
        
        const url = `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json&accept-language=vi`;
        
        fetch(url, {
            headers: {
                'User-Agent': 'FoodRadar-DACS-App/1.0'
            }
        })
            .then(res => res.json())
            .then(data => {
                if (data && data.display_name) {
                    addressInput.value = data.display_name;
                } else {
                    addressInput.value = '';
                }
            })
            .catch(err => {
                console.error("Geocoding error:", err);
                addressInput.value = '';
            });
    }

    function placeMarker(latlng) {
        latInput.value = latlng.lat.toFixed(6);
        lngInput.value = latlng.lng.toFixed(6);
        if (marker) {
            marker.setLatLng(latlng);
        } else {
            marker = L.marker(latlng).addTo(map);
        }
        reverseGeocode(latlng.lat, latlng.lng);
    }

    map.on('click', function(e) {
        placeMarker(e.latlng);
    });

    if (latInput.value && lngInput.value) {
        var lat = parseFloat(latInput.value);
        var lng = parseFloat(lngInput.value);
        if (!isNaN(lat) && !isNaN(lng)) {
            placeMarker(L.latLng(lat, lng));
            map.setView([lat, lng], 15);
        }
    }

    // ── My Location Button ──
    var locateBtn = document.getElementById('locateMe');
    var locateIcon = document.getElementById('locateMeIcon');
    var locateText = document.getElementById('locateMeText');

    locateBtn.addEventListener('click', function () {
        if (!navigator.geolocation) {
            alert('Trình duyệt của bạn không hỗ trợ định vị GPS.');
            return;
        }

        // Show loading state
        locateBtn.classList.add('loading');
        locateIcon.innerHTML = '<span class="locate-pulse"></span>';
        locateText.textContent = 'Đang định vị...';

        navigator.geolocation.getCurrentPosition(
            function (pos) {
                var latlng = L.latLng(pos.coords.latitude, pos.coords.longitude);

                // Place the restaurant marker at user's location
                placeMarker(latlng);
                map.setView(latlng, 17);

                // Show a subtle blue dot for the user's actual GPS position
                if (myLocationMarker) map.removeLayer(myLocationMarker);
                var blueIcon = L.divIcon({
                    className: '',
                    html: '<div style="width:14px;height:14px;background:#4285F4;border:3px solid #fff;border-radius:50%;box-shadow:0 0 0 4px rgba(66,133,244,0.3);"></div>',
                    iconSize: [14, 14],
                    iconAnchor: [7, 7]
                });
                myLocationMarker = L.marker(latlng, { icon: blueIcon, zIndexOffset: -100 })
                    .addTo(map)
                    .bindPopup('📍 Vị trí hiện tại của bạn')
                    .openPopup();

                // Restore button
                locateBtn.classList.remove('loading');
                locateIcon.textContent = '✅';
                locateText.textContent = 'Đã định vị!';
                setTimeout(function() {
                    locateIcon.textContent = '📍';
                    locateText.textContent = 'Vị trí của tôi';
                }, 3000);
            },
            function (err) {
                locateBtn.classList.remove('loading');
                locateIcon.textContent = '❌';
                locateText.textContent = 'Không thể định vị';
                setTimeout(function() {
                    locateIcon.textContent = '📍';
                    locateText.textContent = 'Vị trí của tôi';
                }, 3000);
                var msg = 'Không thể lấy vị trí.';
                if (err.code === 1) msg = 'Bạn đã từ chối quyền truy cập vị trí. Hãy cho phép trong cài đặt trình duyệt.';
                else if (err.code === 2) msg = 'Không xác định được vị trí. Vui lòng thử lại.';
                else if (err.code === 3) msg = 'Quá thời gian định vị. Vui lòng thử lại.';
                alert(msg);
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    });

    // ── Modern Drag & Drop Image Handler ──
    const zone = document.getElementById('dragDropZone');
    const imgInput = document.getElementById('imageInput');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const preview = document.getElementById('imagePreview');

    if (zone && imgInput) {
        zone.addEventListener('click', () => imgInput.click());

        zone.addEventListener('dragover', (e) => {
            e.preventDefault();
            zone.classList.add('dragover');
        });

        ['dragleave', 'dragend'].forEach(type => {
            zone.addEventListener(type, () => zone.classList.remove('dragover'));
        });

        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            zone.classList.remove('dragover');
            
            if (e.dataTransfer.files.length) {
                imgInput.files = e.dataTransfer.files;
                handleImageFile(e.dataTransfer.files[0]);
            }
        });

        imgInput.addEventListener('change', () => {
            if (imgInput.files.length) {
                handleImageFile(imgInput.files[0]);
            }
        });
    }

    function handleImageFile(file) {
        if (!file || !file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            preview.src = e.target.result;
            previewContainer.style.display = 'block';
        };
        reader.readAsDataURL(file);
    }

</script>
}
