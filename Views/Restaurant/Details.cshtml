<script>
(function () {
    var hints = ['', 'Tệ', 'Không hay', 'Bình thường', 'Tốt', 'Tuyệt vời'];
    var currentRating = 5;

    var picker   = document.getElementById('star-picker');
    var valInput = document.getElementById('rating-value');
    var hintEl   = document.getElementById('star-hint');
    if (!picker) return;

    var btns = picker.querySelectorAll('.star-btn');

    function setRating(val) {
        currentRating = val;
        if (valInput) valInput.value = val;
        if (hintEl)   hintEl.textContent = hints[val] || '';
        btns.forEach(function(b) {
            var v = parseInt(b.dataset.value);
            b.classList.toggle('active', v <= val);
        });
    }

    // Hover effect
    btns.forEach(function(btn) {
        btn.addEventListener('mouseenter', function() {
            var v = parseInt(this.dataset.value);
            btns.forEach(function(b) {
                b.classList.toggle('hover', parseInt(b.dataset.value) <= v);
            });
            if (hintEl) hintEl.textContent = hints[v] || '';
        });
        btn.addEventListener('mouseleave', function() {
            btns.forEach(function(b) { b.classList.remove('hover'); });
            if (hintEl) hintEl.textContent = hints[currentRating] || '';
        });
        btn.addEventListener('click', function() {
            setRating(parseInt(this.dataset.value));
        });
    });

    // Init with 5 stars
    setRating(5);
})();
</script>

<script>
// ── Dynamic AI Summary Pill Renderer & Staggered Fade-in ──
(function () {
    const container = document.querySelector('.ai-summary-content');
    if (!container) return;
    
    const rawHtml = container.innerHTML.trim();
    if (!rawHtml || rawHtml.includes('Đang tải')) return;

    // Split text into lines based on <br> tags
    const rawLines = rawHtml.split(/<br\s*\/?>/gi);
    container.innerHTML = ''; // Clear container

    let delay = 100;
    rawLines.forEach(line => {
        let trimmed = line.trim();
        if (!trimmed) return;

        let isPos = trimmed.includes('💚') || trimmed.includes('Ưu điểm');
        let isNeg = trimmed.includes('⚠️') || trimmed.includes('lưu ý');

        // Extract and replace strong tags with structured badge pills
        trimmed = trimmed.replace(/<strong>(.*?)<\/strong>/gi, (match, word) => {
            if (isPos) {
                return `<span class="ai-pill positive">✨ ${word}</span>`;
            } else if (isNeg) {
                return `<span class="ai-pill negative">⚠️ ${word}</span>`;
            }
            return `<strong style="color:var(--primary); font-weight:700;">${word}</strong>`;
        });

        const lineEl = document.createElement('div');
        lineEl.className = 'ai-summary-line mb-3';
        lineEl.innerHTML = trimmed;
        container.appendChild(lineEl);

        setTimeout(() => {
            lineEl.classList.add('visible');
        }, delay);
        delay += 200;
    });
})();

// ── Image Slider Controller ──
(function () {
    var slides = document.querySelectorAll('#restaurantSlider .slider-slide');
    var dots   = document.querySelectorAll('#sliderDots .dot');
    var prevBtn = document.getElementById('sliderPrev');
    var nextBtn = document.getElementById('sliderNext');
    if (!slides.length) return;

    var current = 0;
    var total   = slides.length;
    var timer;

    function goTo(idx) {
        slides[current].classList.remove('active');
        if (dots[current]) dots[current].classList.remove('active');
        current = (idx + total) % total;
        slides[current].classList.add('active');
        if (dots[current]) dots[current].classList.add('active');
    }

    function startAuto() {
        if (total <= 1) return;
        timer = setInterval(function () { goTo(current + 1); }, 4500);
    }
    function stopAuto() { clearInterval(timer); }

    if (prevBtn) prevBtn.addEventListener('click', function () { stopAuto(); goTo(current - 1); startAuto(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { stopAuto(); goTo(current + 1); startAuto(); });

    dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
            stopAuto();
            goTo(parseInt(this.dataset.dot));
            startAuto();
        });
    });

    var slider = document.getElementById('restaurantSlider');
    if (slider) {
        slider.addEventListener('mouseenter', stopAuto);
        slider.addEventListener('mouseleave', startAuto);
    }

    startAuto();
})();
</script>
