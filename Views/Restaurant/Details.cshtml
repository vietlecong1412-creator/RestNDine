    @model DACS.Models.Restaurant
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUser = await UserManager.GetUserAsync(User);
    
    bool isCafe = !string.IsNullOrEmpty(Model.Name) && (Model.Name.ToLower().Contains("coffee") || Model.Name.ToLower().Contains("tea") || Model.Name.ToLower().Contains("cà phê") || Model.Name.ToLower().Contains("cafe") || Model.Name.ToLower().Contains("phúc long") || Model.Name.ToLower().Contains("highlands") || Model.Name.ToLower().Contains("trung nguyên") || Model.Name.ToLower().Contains("katinat") || Model.Name.ToLower().Contains("gong cha") || Model.Name.ToLower().Contains("the coffee house"));
    var placeTypeName = isCafe ? "quán cafe" : "quán ăn";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container py-5 animate-in">
    @if (TempData["Success"] != null)
    {
        <div class="alert-glass success mb-4">
            ✅ @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-glass mb-4" style="background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.3); color: #ef4444;">
            ❌ @TempData["Error"]
        </div>
    }

    <div class="row g-4">
        @* ── Left Column: Info ── *@
        <div class="col-lg-8">
            <div class="card-glass p-0 overflow-hidden mb-4">
                @{
                    // Build combined slide list: legacy ImageUrl first, then gallery images
                    var slides = new System.Collections.Generic.List<(string Url, int? ImageId)>();
                    if (!string.IsNullOrEmpty(Model.ImageUrl))
                        slides.Add((Model.ImageUrl, null));
                    foreach (var gi in Model.Images)
                        slides.Add((gi.ImageUrl, gi.Id));

                    bool isOwnerOrAdmin = User.Identity!.IsAuthenticated &&
                        (Model.OwnerId == currentUser?.Id || User.IsInRole("Admin"));
                }

                @* ── Image Slider ── *@
                <div class="restaurant-slider" id="restaurantSlider">
                    @if (slides.Count == 0)
                    {
                        <div class="slider-empty-placeholder">
                            <span>@(isCafe ? "☕" : "🍽")</span>
                            <p>Chưa có ảnh</p>
                        </div>
                    }
                    else
                    {
                        <div class="slider-track" id="sliderTrack">
                            @for (int i = 0; i < slides.Count; i++)
                            {
                                <div class="slider-slide @(i == 0 ? "active" : "")" data-index="@i"
                                     style="background-image:url('@slides[i].Url')">
                                    <div class="hero-overlay"></div>

                                    @* Delete button — owner/admin only *@
                                    @if (isOwnerOrAdmin && slides[i].ImageId != null)
                                    {
                                        <form method="post" asp-action="DeleteImage"
                                              class="slider-delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="imageId" value="@slides[i].ImageId" />
                                            <input type="hidden" name="restaurantId" value="@Model.Id" />
                                            <button type="submit" class="slider-delete-btn"
                                                    onclick="return confirm('Xóa ảnh này?')">
                                                🗑
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>

                        @if (slides.Count > 1)
                        {
                            <button class="slider-nav prev" id="sliderPrev" aria-label="Ảnh trước">&#8249;</button>
                            <button class="slider-nav next" id="sliderNext" aria-label="Ảnh sau">&#8250;</button>

                            <div class="slider-dots" id="sliderDots">
                                @for (int i = 0; i < slides.Count; i++)
                                {
                                    <span class="dot @(i == 0 ? "active" : "")" data-dot="@i"></span>
                                }
                            </div>
                        }
                    }

                    @* Add Image button — owner/admin only *@
                    @if (isOwnerOrAdmin)
                    {
                        <div class="slider-add-zone">
                            <form method="post" asp-action="AddImage"
                                  enctype="multipart/form-data" class="slider-add-form" id="addImageForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="restaurantId" value="@Model.Id" />
                                <label for="sliderImageInput" class="slider-add-btn" title="Thêm ảnh">
                                    <span>＋</span>
                                </label>
                                <input type="file" id="sliderImageInput" name="image"
                                       accept="image/*" class="d-none"
                                       onchange="document.getElementById('addImageForm').submit()" />
                            </form>
                        </div>
                    }
                </div>

                <div class="p-4 p-md-5 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="details-title mb-1">@Model.Name</h1>
                            @if (isCafe)
                            {
                                <span class="badge" style="background: linear-gradient(135deg, #854d0e, #a16207); color: white; padding: 4px 10px; border-radius: 50px; font-size: 0.75rem; font-weight: bold; display: inline-flex; align-items: center; gap: 4px; border: none; line-height: 1;">☕ Quán Cafe</span>
                            }
                            else
                            {
                                <span class="badge" style="background: linear-gradient(135deg, #ef4444, #dc2626); color: white; padding: 4px 10px; border-radius: 50px; font-size: 0.75rem; font-weight: bold; display: inline-flex; align-items: center; gap: 4px; border: none; line-height: 1;">🍴 Nhà hàng</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(Model.PriceRange))
                        {
                            <span class="details-price-badge">💰 @Model.PriceRange</span>
                        }
                    </div>

                    <div class="details-meta mb-4">
                        <div class="meta-item">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>@(string.IsNullOrEmpty(Model.Address) ? "Chưa có địa chỉ" : Model.Address)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <div class="meta-item">
                                <i class="fa-solid fa-phone"></i>
                                <span>@Model.PhoneNumber</span>
                            </div>
                        }
                    </div>

                    <div class="details-section">
                        <h3 class="section-subtitle">Mô tả</h3>
                        <p class="details-text">
                            @(string.IsNullOrEmpty(Model.Description) ? $"Chưa có mô tả cho {placeTypeName} này." : Model.Description)
                        </p>
                    </div>
                </div>
            </div>

            @* ── Premium Local AI Summary Widget ── *@
            @{
                string FormatMarkdown(string txt)
                {
                    if (string.IsNullOrEmpty(txt)) return "";
                    var parts = txt.Split("**");
                    var sb = new System.Text.StringBuilder();
                    for (int i = 0; i < parts.Length; i++)
                    {
                        if (i % 2 == 1)
                            sb.Append("<strong>" + parts[i] + "</strong>");
                        else
                            sb.Append(parts[i]);
                    }
                    return sb.ToString().Replace("\n", "<br/>");
                }
            }

            <div class="card-glass-ai p-4 p-md-5 mb-4 position-relative overflow-hidden">
                <div style="position: absolute; top: -50px; right: -50px; width: 200px; height: 200px; background: radial-gradient(circle, rgba(59, 130, 246, 0.2) 0%, transparent 70%); filter: blur(30px); pointer-events: none;"></div>
                <div style="position: absolute; bottom: -50px; left: -50px; width: 200px; height: 200px; background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%); filter: blur(30px); pointer-events: none;"></div>
                
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="ai-icon-pulse" style="width: 48px; height: 48px; background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; box-shadow: 0 0 15px rgba(59, 130, 246, 0.4); animation: pulse-glow 2s infinite alternate;">
                        ✨
                    </div>
                    <div>
                        <h3 class="section-subtitle mb-0" style="background: linear-gradient(to right, #60a5fa, #c084fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 0.15rem;">
                            Tóm tắt Đánh giá AI
                        </h3>
                        <span class="text-muted small">Phân tích cảm xúc & bình luận cộng đồng cục bộ</span>
                    </div>
                </div>

                <div class="ai-summary-content" style="font-size: 0.96rem; line-height: 1.7; color: #e2e8f0;">
                    @if (ViewBag.AiSummary != null)
                    {
                        @Html.Raw(FormatMarkdown((string)ViewBag.AiSummary))
                    }
                    else
                    {
                        <span class="text-muted">Đang tải báo cáo tóm tắt từ AI...</span>
                    }
                </div>
                
                <div class="mt-4 pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2" style="border-top-color: rgba(255, 255, 255, 0.08) !important;">
                    <span class="text-muted small d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                        ⚡ Phân tích bằng mô hình xử lý ngôn ngữ tự nhiên 100% Cục bộ & Bảo mật
                    </span>
                    <button class="btn btn-sm btn-outline-primary" style="font-size: 0.72rem; border-radius: 20px; border-color: rgba(59, 130, 246, 0.4); color: #60a5fa; padding: 4px 12px; background: rgba(59, 130, 246, 0.05);" onclick="location.reload();">
                        🔄 Phân tích lại
                    </button>
                </div>
            </div>

            <style>
                @@keyframes pulse-glow {
                    0% { transform: scale(1); box-shadow: 0 0 10px rgba(59, 130, 246, 0.4); }
                    100% { transform: scale(1.05); box-shadow: 0 0 20px rgba(139, 92, 246, 0.6); }
                }
            </style>


        @* ── Comments Section ── *@
        <div class="card-glass p-4 p-md-5">
            @{
                var ratedComments = Model.Comments.Where(c => c.Rating > 0).ToList();
                var avgRating = ratedComments.Any() ? ratedComments.Average(c => c.Rating) : 0;
                var totalReviews = Model.Comments.Count;
            }

            @* Overall Rating Header *@
            <div class="rating-overall mb-4">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div>
                        <h3 class="section-subtitle mb-1">
                            <i class="fa-solid fa-comments me-2"></i> Đánh giá & Bình luận
                        </h3>
                        <span class="text-muted small">@totalReviews bình luận</span>
                    </div>
                    @if (ratedComments.Any())
                    {
                        <div class="overall-rating-badge">
                            <span class="overall-score">@avgRating.ToString("F1")</span>
                            <div class="overall-stars">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    if (s <= Math.Round(avgRating))
                                    {
                                        <span class="star filled">★</span>
                                    }
                                    else
                                    {
                                        <span class="star empty">★</span>
                                    }
                                }
                            </div>
                            <span class="overall-label">/ 5</span>
                        </div>
                    }
                </div>
                @* Rating distribution bar *@
                @if (ratedComments.Any())
                {
                    <div class="rating-bars mt-3">
                        @for (int star = 5; star >= 1; star--)
                        {
                            var count = ratedComments.Count(c => c.Rating == star);
                            var pct = totalReviews > 0 ? (count * 100.0 / totalReviews) : 0;
                            <div class="rating-bar-row">
                                <span class="rating-bar-label">@star ★</span>
                                <div class="rating-bar-track">
                                    <div class="rating-bar-fill" style="width: @pct.ToString("F0")%"></div>
                                </div>
                                <span class="rating-bar-count">@count</span>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <form asp-action="AddComment" method="post" class="mb-5">
                    <input type="hidden" name="restaurantId" value="@Model.Id" />
                    <input type="hidden" name="rating" id="rating-value" value="5" />

                    @* Star Picker *@
                    <div class="star-picker mb-3">
                        <div class="star-picker-label">Đánh giá của bạn</div>
                        <div class="star-picker-stars" id="star-picker">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <button type="button" class="star-btn @(s <= 5 ? "active" : "")" data-value="@s">★</button>
                            }
                        </div>
                        <span class="star-picker-hint" id="star-hint">Tuyệt vời</span>
                    </div>

                    <div class="comment-input-wrapper">
                        <textarea name="content" class="form-control-custom" rows="3"
                                  placeholder="Chia sẻ cảm nhận của bạn về quán này..." required></textarea>
                        <button type="submit" class="btn-primary-custom mt-3">
                            <span>Gửi bình luận</span>
                            <i class="fa-solid fa-paper-plane ms-2"></i>
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert-glass mb-5 text-center">
                    Vui lòng <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path">đăng nhập</a> để để lại bình luận.
                </div>
            }

            <div class="comments-list">
                @if (Model.Comments.Any())
                {
                    @foreach (var c in Model.Comments.OrderByDescending(x => x.CreatedAt))
                    {
                        <div class="comment-item">
                            <div class="comment-avatar">
                                @(c.User?.Email?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="comment-body">
                                <div class="comment-header">
                                    <span class="comment-user">@c.User?.Email</span>
                                    <span class="comment-date">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                @* Stars per comment *@
                                <div class="comment-stars mb-1">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <span class="cstar @(s <= c.Rating ? "filled" : "empty")">★</span>
                                    }
                                    <span class="comment-rating-num">@c.Rating/5</span>
                                </div>
                                <div class="comment-content">
                                    @c.Content
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        Chưa có bình luận nào. Hãy là người đầu tiên!
                    </div>
                }
            </div>
        </div>
        </div> @* end col-lg-8 *@

        @* ── Right Column ── *@
        <div class="col-lg-4">

            @* Quick Info Card *@
            <div class="card-glass p-4 mb-4">
                <h3 class="section-subtitle mb-3">📋 Thông tin nhanh</h3>
                <div class="quick-info-list">
                    @{
                        var qi_rated = Model.Comments.Where(c => c.Rating > 0).ToList();
                        var qi_avg   = qi_rated.Any() ? qi_rated.Average(c => c.Rating) : 0;
                    }
                    @* Rating summary *@
                    <div class="quick-info-row">
                        <span class="qi-icon">⭐</span>
                        <div class="qi-body">
                            @if (qi_rated.Any())
                            {
                                <span class="qi-label">Đánh giá trung bình</span>
                                <span class="qi-value text-warning fw-bold">@qi_avg.ToString("F1") / 5</span>
                                <div class="qi-stars">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <span class="cstar @(s <= Math.Round(qi_avg) ? "filled" : "empty")">★</span>
                                    }
                                    <span class="ms-1 small text-muted">(@qi_rated.Count đánh giá)</span>
                                </div>
                            }
                            else
                            {
                                <span class="qi-label">Chưa có đánh giá</span>
                            }
                        </div>
                    </div>

                    @* Address *@
                    <div class="quick-info-row">
                        <span class="qi-icon">📍</span>
                        <div class="qi-body">
                            <span class="qi-label">Địa chỉ</span>
                            <span class="qi-value">@(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật" : Model.Address)</span>
                        </div>
                    </div>

                    @* Phone *@
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <div class="quick-info-row">
                            <span class="qi-icon">📞</span>
                            <div class="qi-body">
                                <span class="qi-label">Điện thoại</span>
                                <a href="tel:@Model.PhoneNumber" class="qi-value text-primary">@Model.PhoneNumber</a>
                            </div>
                        </div>
                    }

                    @* Price range *@
                    @if (!string.IsNullOrEmpty(Model.PriceRange))
                    {
                        <div class="quick-info-row">
                            <span class="qi-icon">💰</span>
                            <div class="qi-body">
                                <span class="qi-label">Tầm giá</span>
                                <span class="qi-value">@Model.PriceRange</span>
                            </div>
                        </div>
                    }


                </div>

                @* Owner actions *@
                @if (User.Identity.IsAuthenticated && (Model.OwnerId == currentUser?.Id || User.IsInRole("Admin")))
                {
                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-outline-custom flex-grow-1 justify-content-center">
                            <i class="fa-solid fa-pen me-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-danger-custom justify-content-center">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </div>
                }
            </div>

            @* Banner Card (owner/admin only) *@
            @if (User.Identity.IsAuthenticated && (Model.OwnerId == currentUser?.Id || User.IsInRole("Admin")))
            {
                <div class="card-glass p-4 mb-4" style="border-color: rgba(251, 191, 36, 0.4);">
                    <h3 class="section-subtitle mb-2 text-warning">
                        <i class="fa-solid fa-bullhorn me-2"></i> Banner quảng cáo
                    </h3>

                    @* Status badge *@
                    @if (Model.BannerStatus == DACS.Models.BannerStatus.Active)
                    {
                        <div class="mb-3">
                            <span class="badge" style="background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.3);">
                                ✅ Đang hiển thị trên trang chủ
                            </span>
                            <img src="@Model.BannerUrl" class="mt-2" style="width:100%;border-radius:8px;border:1px solid var(--border);" alt="Banner" />
                        </div>
                    }
                    else if (Model.BannerStatus == DACS.Models.BannerStatus.PendingPayment)
                    {
                        <div class="mb-3" style="background:rgba(251,191,36,.07);border:1px solid rgba(251,191,36,.2);border-radius:10px;padding:.9rem 1rem;">
                            <span class="badge mb-2" style="background:rgba(251,191,36,.15);color:#fbbf24;border:1px solid rgba(251,191,36,.3);">
                                🕒 Đang chờ Admin xác nhận
                            </span>
                            <div style="font-size:.8rem;color:#94a3b8;">
                                Banner của bạn đã được gửi. Admin sẽ kiểm tra biên lai và duyệt trong vòng 24 giờ.
                            </div>
                            @if (!string.IsNullOrEmpty(Model.BannerUrl))
                            {
                                <img src="@Model.BannerUrl" class="mt-2" style="width:100%;border-radius:8px;border:1px solid rgba(251,191,36,.2);opacity:.6;" alt="Banner (chưa duyệt)" />
                            }
                        </div>
                    }
                    else if (Model.BannerStatus == DACS.Models.BannerStatus.Rejected)
                    {
                        <div class="mb-3" style="background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.2);border-radius:10px;padding:.9rem 1rem;">
                            <span class="badge mb-2" style="background:rgba(239,68,68,.15);color:#ef4444;border:1px solid rgba(239,68,68,.3);">
                                ❌ Yêu cầu đã bị từ chối
                            </span>
                            <div style="font-size:.8rem;color:#94a3b8;">
                                Biên lai thanh toán không hợp lệ. Vui lòng liên hệ Admin hoặc thử lại.
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-3">Đặt banner để quán hiện trong slider trang chủ!</p>
                    }

                    @* Actions *@
                    @{
                        bool canUpload = Model.BannerStatus == DACS.Models.BannerStatus.None
                                      || Model.BannerStatus == DACS.Models.BannerStatus.Rejected;
                        bool canDelete = !string.IsNullOrEmpty(Model.BannerUrl)
                                      && Model.BannerStatus != DACS.Models.BannerStatus.PendingPayment;
                    }
                    <div class="d-flex gap-2 mt-1">
                        @if (canUpload || User.IsInRole("Admin"))
                        {
                            <a asp-action="Payment" asp-route-id="@Model.Id"
                               class="btn-primary-custom flex-grow-1 justify-content-center"
                               style="background:rgba(251,191,36,.1);color:#fbbf24;border:1px solid rgba(251,191,36,.3);text-decoration:none;">
                                ⬆️ Úp Banner
                            </a>
                        }
                        @if (canDelete)
                        {
                            <form method="post" asp-action="DeleteBanner" style="margin:0;">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn-outline-custom text-danger" title="Xóa banner">
                                    🗑️
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }

            @* Map Card *@
            <div class="card-glass p-4">
                <h3 class="section-subtitle mb-3">🗺 Vị trí quán</h3>
                <div id="details-map" style="height: 280px; border-radius: 12px; border: 1px solid var(--border)"></div>
                <div class="mt-3">
                    <a href="https://www.google.com/maps/dir/?api=1&destination=@Model.Latitude,@Model.Longitude"
                       target="_blank" class="btn-outline-custom w-100 justify-content-center">
                        <i class="fa-solid fa-signs-post me-2"></i> Chỉ đường (Google Maps)
                    </a>
                </div>
            </div>

        </div> @* end col-lg-4 *@
    </div> @* end row *@
</div> @* end container *@


@section Scripts {
<style>
/* ── Restaurant Image Slider ── */
.restaurant-slider {
    position: relative;
    width: 100%;
    height: 340px;
    overflow: hidden;
    background: var(--surface-light, #1e293b);
}
.slider-track {
    display: flex;
    height: 100%;
    transition: none;
}
.slider-slide {
    min-width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    position: relative;
    display: none;
    flex-shrink: 0;
}
.slider-slide.active {
    display: block;
    animation: slideIn .45s cubic-bezier(.4,0,.2,1);
}
@@keyframes slideIn {
    from { opacity: 0; transform: scale(1.04); }
    to   { opacity: 1; transform: scale(1); }
}

/* Nav arrows */
.slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,.45);
    color: #fff;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
