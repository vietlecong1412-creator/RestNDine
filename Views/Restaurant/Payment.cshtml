@model DACS.Models.Restaurant
@{
    ViewData["Title"] = "Thanh toán phí quảng cáo – " + Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Thông tin ngân hàng (tuỳ chỉnh theo thực tế)
    var bankId      = "970436";   // Vietcombank
    var accountNo   = "0001028780";
    var accountName = "LE CONG VIET";
    var amount      = 10000;
    var description = $"Quang cao {Model.Id}";

    // Sinh URL QR qua VietQR API
    var qrUrl = $"https://img.vietqr.io/image/{bankId}-{accountNo}-compact2.png" +
                $"?amount={amount}&addInfo={Uri.EscapeDataString(description)}&accountName={Uri.EscapeDataString(accountName)}";
}

<style>
    .payment-wrapper {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .payment-card {
        background: linear-gradient(145deg, rgba(22, 27, 47, 0.97), rgba(15, 19, 35, 0.99));
        border: 1px solid rgba(251, 191, 36, 0.25);
        border-radius: 24px;
        padding: 2.5rem;
        max-width: 520px;
        width: 100%;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5), 0 0 60px rgba(251, 191, 36, 0.06);
        position: relative;
        overflow: hidden;
        animation: slide-up 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .payment-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 0%, rgba(251, 191, 36, 0.07) 0%, transparent 60%);
        pointer-events: none;
    }

    @@keyframes slide-up {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0);    }
    }

    .payment-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(251, 191, 36, 0.1);
        border: 1px solid rgba(251, 191, 36, 0.3);
        color: #fbbf24;
        padding: 0.4rem 1rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin-bottom: 1.2rem;
    }

    .payment-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #f1f5f9;
        margin-bottom: 0.3rem;
        line-height: 1.3;
    }

    .payment-subtitle {
        font-size: 0.9rem;
        color: #94a3b8;
        margin-bottom: 2rem;
    }

    /* QR wrapper */
    .qr-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.8rem;
    }

    .qr-glow {
        position: absolute;
        inset: -20px;
        background: radial-gradient(circle, rgba(34, 197, 94, 0.15), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: pulse-glow 3s ease-in-out infinite;
    }

    @@keyframes pulse-glow {
        0%, 100% { opacity: 0.7; transform: scale(0.95); }
        50%       { opacity: 1;   transform: scale(1.05); }
    }

    .qr-frame {
        background: #ffffff;
        border-radius: 20px;
        padding: 16px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.1);
        position: relative;
        z-index: 1;
    }

    .qr-frame img {
        display: block;
        width: 220px;
        height: 220px;
        border-radius: 8px;
    }

    .qr-loading {
        width: 220px;
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f4f8;
        border-radius: 8px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #e2e8f0;
        border-top-color: #22c55e;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Bank info */
    .bank-info {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 1.2rem 1.4rem;
        margin-bottom: 1.5rem;
    }

    .bank-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .bank-row:last-child { border-bottom: none; }

    .bank-label {
        font-size: 0.8rem;
        color: #64748b;
        font-weight: 500;
    }

    .bank-value {
        font-size: 0.9rem;
        color: #e2e8f0;
        font-weight: 600;
        text-align: right;
    }

    .bank-value.highlight {
        color: #fbbf24;
        font-size: 1.1rem;
    }

    .bank-value.green { color: #4ade80; }

    /* Steps */
    .steps-section { margin-bottom: 1.8rem; }

    .steps-title {
        font-size: 0.78rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 0.8rem;
    }

    .step-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.45rem 0;
    }

    .step-num {
        width: 22px;
        height: 22px;
        min-width: 22px;
        background: linear-gradient(135deg, #f97316, #ea580c);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 700;
        color: white;
        margin-top: 2px;
    }

    .step-text {
        font-size: 0.85rem;
        color: #94a3b8;
        line-height: 1.5;
    }

    /* Actions */
    .payment-actions { display: flex; gap: 0.75rem; }

    .btn-pay-done {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.85rem 1.5rem;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        box-shadow: 0 4px 20px rgba(34, 197, 94, 0.3);
    }

    .btn-pay-done:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(34, 197, 94, 0.45);
        color: white;
    }

    .btn-pay-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.85rem 1.2rem;
        background: transparent;
        color: #94a3b8;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        font-weight: 500;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-pay-back:hover {
        background: rgba(255, 255, 255, 0.05);
        color: #e2e8f0;
        border-color: rgba(255, 255, 255, 0.2);
    }

    /* Note */
    .payment-note {
        margin-top: 1.2rem;
        padding: 0.85rem 1.1rem;
        background: rgba(251, 191, 36, 0.05);
        border: 1px solid rgba(251, 191, 36, 0.15);
        border-radius: 10px;
        font-size: 0.8rem;
        color: #94a3b8;
        line-height: 1.6;
    }

    .payment-note strong { color: #fbbf24; }

    /* Upload section */
    .upload-section {
        display: none;
        margin-top: 1.5rem;
        border-top: 1px solid rgba(255,255,255,0.08);
        padding-top: 1.5rem;
    }

    .upload-section.visible {
        display: block;
        animation: slide-up 0.35s ease both;
    }
</style>

<div class="payment-wrapper">
    <div class="payment-card">

        @* Badge *@
        <div class="payment-badge">
            <i class="fa-solid fa-bullhorn"></i>
            Thanh toán quảng cáo
        </div>

        <div class="payment-title">Đặt banner cho <em>@Model.Name</em></div>
        <div class="payment-subtitle">
            Quét mã QR bên dưới để thanh toán. Banner sẽ được hiển thị trên trang chủ sau khi xác nhận.
        </div>

        @* QR Code *@
        <div class="qr-wrapper">
            <div class="qr-glow"></div>
            <div class="qr-frame">
                <div class="qr-loading" id="qrLoading">
                    <div class="spinner"></div>
                </div>
                <img id="qrImg"
                     src="@qrUrl"
                     alt="QR Vietcombank thanh toán phí quảng cáo"
                     style="display:none;"
                     onload="document.getElementById('qrLoading').style.display='none'; this.style.display='block';"
                     onerror="document.getElementById('qrLoading').innerHTML='<div style=\'color:#ef4444;font-size:.8rem;padding:1rem;text-align:center;\'>Không tải được QR.<br/>Vui lòng chuyển khoản thủ công.</div>';" />
            </div>
        </div>

        @* Bank Details *@
        <div class="bank-info">
            <div class="bank-row">
                <span class="bank-label">Ngân hàng</span>
                <span class="bank-value">🏦 Vietcombank</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">Số tài khoản</span>
                <span class="bank-value green">@accountNo</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">Chủ tài khoản</span>
                <span class="bank-value">@accountName</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">Số tiền</span>
                <span class="bank-value highlight">10,000 VNĐ</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">Nội dung CK</span>
                <span class="bank-value" style="font-family: 'Courier New', monospace;">Quang cao @Model.Id</span>
            </div>
        </div>

        @* Steps *@
        <div class="steps-section">
            <div class="steps-title">Hướng dẫn</div>
            <div class="step-item">
                <div class="step-num">1</div>
                <div class="step-text">
                    Mở app ngân hàng → Quét mã QR hoặc chuyển khoản thủ công theo thông tin trên.
                </div>
            </div>
            <div class="step-item">
                <div class="step-num">2</div>
                <div class="step-text">
                    Nhập đúng nội dung chuyển khoản:
                    <strong style="color:#e2e8f0;">Quang cao @Model.Id</strong>
                </div>
            </div>
            @* Change step 3 text *@
        <div class="step-item">
                <div class="step-num">3</div>
                <div class="step-text">
                    Nhấn <strong style="color:#4ade80;">"Đã thanh toán – Úp Banner"</strong>,
                    upload ảnh banner + <strong style="color:#fbbf24;">ảnh chụp biên lai</strong> để Admin xác nhận.
                </div>
            </div>
        </div>

        @* Action buttons *@
        <div class="payment-actions">
            <a href="@Url.Action("Details", "Restaurant", new { id = Model.Id })"
               class="btn-pay-back">
                <i class="fa-solid fa-arrow-left"></i> Quay lại
            </a>
            <button type="button" class="btn-pay-done" id="btnPaid" onclick="showUploadSection()">
                <i class="fa-solid fa-circle-check"></i> Đã thanh toán – Úp Banner
            </button>
        </div>

        @* Upload form (revealed after clicking "Đã thanh toán") *@
        <div class="upload-section" id="uploadSection">
            <div style="background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.2); border-radius: 10px; padding: 0.85rem 1rem; margin-bottom: 1.2rem; font-size: 0.85rem; color: #4ade80;">
                ✅ Tốt! Hãy tải lên ảnh banner <strong>và ảnh chụp biên lai chuyển khoản</strong> để Admin xác nhận.
            </div>
            <form method="post" enctype="multipart/form-data"
                  action="@Url.Action("UpdateBanner", "Restaurant")">
                <input type="hidden" name="id" value="@Model.Id" />

                @* Banner image *@
                <div class="mb-3">
                    <div style="font-size: 0.78rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem; font-weight: 600;">
                        1. Ảnh Banner quảng cáo <span style="color:#ef4444">*</span>
                    </div>
                    <input class="form-control-custom" type="file" name="bannerImage"
                           accept="image/*" required
                           style="background: rgba(255,255,255,0.05); border-color: rgba(34,197,94,0.3);" />
                    <div class="mt-1" style="font-size: 0.75rem; color: #475569;">
                        Khuyến nghị: ảnh ngang (16:9), tối thiểu 1200 × 400 px
                    </div>
                </div>

                @* Payment proof *@
                <div class="mb-3">
                    <div style="font-size: 0.78rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem; font-weight: 600;">
                        2. Ảnh biên lai chuyển khoản <span style="color:#ef4444">*</span>
                    </div>
                    <input class="form-control-custom" type="file" name="paymentProof"
                           accept="image/*" required
                           style="background: rgba(255,255,255,0.05); border-color: rgba(251,191,36,0.3);" />
                    <div class="mt-1" style="font-size: 0.75rem; color: #475569;">
                        Chụp màn hình xác nhận giao dịch từ app ngân hàng
                    </div>
                </div>

                <button type="submit" class="btn-pay-done" style="width: 100%;">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Gửi yêu cầu banner
                </button>
            </form>
        </div>

        @* Note *@
        <div class="payment-note">
            <strong>Lưu ý:</strong> Sau khi gửi, Admin sẽ kiểm tra biên lai và <strong>duyệt trong vòng 24 giờ</strong>.
            Banner sẽ xuất hiện trên trang chủ khi được xác nhận. Liên hệ Admin nếu cần hỗ trợ.
        </div>


    </div>
</div>

@section Scripts {
<script>
    function showUploadSection() {
        var sec = document.getElementById('uploadSection');
        var btn = document.getElementById('btnPaid');
        sec.classList.add('visible');
        btn.style.display = 'none';
        setTimeout(function () {
            sec.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 150);
    }
</script>
}
