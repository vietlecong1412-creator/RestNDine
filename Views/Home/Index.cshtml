            (r.isCafe ? 'https://images.unsplash.com/photo-1507133750040-4a8f57021571?w=500' : 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=500');
        detailImg.src = r.imageUrl || fallbackImg;
        
        // Distance badge
        var distBadge = document.getElementById('detail-distance');
        if (userLatLng && r.latitude && r.longitude) {
            var d = calcDistance(userLatLng.lat, userLatLng.lng, r.latitude, r.longitude);
            distBadge.textContent = '🚶 ' + formatDistance(d) + ' từ vị trí của bạn';
            distBadge.style.display = 'inline-block';
        } else {
            distBadge.style.display = 'none';
