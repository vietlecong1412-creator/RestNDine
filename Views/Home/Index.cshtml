        chip.classList.add('active');
        activeCategoryFilter = chip.dataset.category;
        applyFilters();
    });

    // ── Price chip buttons ──
    document.getElementById('price-chips').addEventListener('click', function(e) {
        var chip = e.target.closest('.price-chip');
        if (!chip) return;
        document.querySelectorAll('#price-chips .price-chip').forEach(function(c) { c.classList.remove('active'); });
        chip.classList.add('active');
