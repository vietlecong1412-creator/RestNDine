    // ── User location marker icon ──
    var userLocationIcon = L.divIcon({
        className: '',
        html: '<div class="user-location-marker"><div class="user-location-pulse"></div><div class="user-location-dot"></div></div>',
        iconSize: [24,24], iconAnchor: [12,12], popupAnchor: [0,-16]
    });

    function locateUser() {
        if (!navigator.geolocation) { showToast('Trình duyệt không hỗ trợ định vị GPS.','error'); return; }
        var btnSidebar = document.getElementById('btn-my-location');
        var btnMap     = document.getElementById('btn-locate-map');
        var txtEl      = document.getElementById('btn-location-text');
        
        txtEl.textContent = 'Định vị...';
        btnSidebar.classList.add('loading');
        btnMap.classList.add('loading');

        navigator.geolocation.getCurrentPosition(
            function(pos) {
                var lat = pos.coords.latitude, lng = pos.coords.longitude, acc = pos.coords.accuracy;
                userLatLng = {lat: lat, lng: lng};

                if (userMarker)         map.removeLayer(userMarker);
                if (userAccuracyCircle) map.removeLayer(userAccuracyCircle);

                userAccuracyCircle = L.circle([lat, lng], {
                    radius: acc, color:'#3b82f6', fillColor:'#3b82f6',
                    fillOpacity:.1, weight:1.5, dashArray:'4 4'
                }).addTo(map);

                userMarker = L.marker([lat, lng], {icon: userLocationIcon, zIndexOffset: 1000})
                    .addTo(map)
                    .bindPopup('<div class="popup-card">'+
                        '<div class="popup-name" style="color:#3b82f6">📡 Vị trí của bạn</div>'+
                        '<div class="popup-addr">Độ chính xác: ~'+Math.round(acc)+' m</div>'+
                        '</div>');

                map.setView([lat, lng], 15, {animate: true});

                txtEl.textContent = 'Vị trí của tôi ✓';
                btnSidebar.classList.remove('loading'); btnSidebar.classList.add('located');
                btnMap.classList.remove('loading');     btnMap.classList.add('located');

                document.getElementById('user-location-bar').style.display = 'inline';
                document.getElementById('user-location-coords').textContent =
                    lat.toFixed(5)+', '+lng.toFixed(5);

                document.getElementById('nearby-badge').style.display = 'inline-flex';

                applyFilters();
                renderDealsCarousel();         // Re-render floating carousel
                renderDealsBannerSection();     // Re-render section bên dưới với sort theo khoảng cách
                
                allPlaces.forEach(function(r, i) {
                    if (markers[i]) markers[i].setPopupContent(buildPopup(r));
                });

                showToast('🎯 Đã định vị thành công! Đang ưu tiên địa điểm gần bạn.', 'success');
            },
            function(err) {
                txtEl.textContent = 'Vị trí của tôi';
                btnSidebar.classList.remove('loading'); btnMap.classList.remove('loading');
                var msg = 'Không thể lấy vị trí.';
                if (err.code === 1) msg = 'Bạn đã từ chối quyền truy cập vị trí.';
                else if (err.code === 2) msg = 'Không xác định được vị trí. Kiểm tra GPS.';
                else if (err.code === 3) msg = 'Hết thời gian lấy vị trí. Thử lại nhé.';
                showToast(msg, 'error');
            },
            {enableHighAccuracy: true, timeout: 10000, maximumAge: 60000}
        );
    }

    // ── Button listeners ──
    document.getElementById('btn-my-location').addEventListener('click', locateUser);
    document.getElementById('btn-locate-map').addEventListener('click', locateUser);

    // ── Real Routing using Free Open Source Routing Machine (OSRM) ──
    function drawRouteTo(place) {
        if (!userLatLng) return;
        
        if (currentRouteLine) {
            map.removeLayer(currentRouteLine);
            currentRouteLine = null;
        }
        if (currentRouteAnimMarker) {
            map.removeLayer(currentRouteAnimMarker);
            currentRouteAnimMarker = null;
        }
        
        var startLat = userLatLng.lat;
        var startLng = userLatLng.lng;
        var endLat = place.latitude;
        var endLng = place.longitude;
        
        showToast('🧭 Đang tính toán tuyến đường đi bộ tốt nhất...', 'info');
        
        var url = 'https://router.project-osrm.org/route/v1/foot/' + startLng + ',' + startLat + ';' + endLng + ',' + endLat + '?overview=full&geometries=geojson';
        
        fetch(url)
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.code === 'Ok' && data.routes && data.routes.length > 0) {
                    var route = data.routes[0];
                    var geojson = route.geometry;
                    
                    var shadowLine = L.geoJSON(geojson, {
                        style: {
                            color: '#1d4ed8',
                            weight: 9,
                            opacity: 0.4,
                            lineCap: 'round',
                            lineJoin: 'round'
                        }
                    });
                    
                    var pathLine = L.geoJSON(geojson, {
                        style: {
                            color: '#3b82f6',
                            weight: 6,
                            opacity: 0.95,
                            lineCap: 'round',
                            lineJoin: 'round',
                            className: 'route-animated'
                        }
                    });
                    
                    currentRouteLine = L.featureGroup([shadowLine, pathLine]).addTo(map);
                    map.fitBounds(currentRouteLine.getBounds(), { padding: [50, 50], animate: true });
                    
                    var dist = route.distance / 1000;
                    var time = route.duration / 60;
                    
                    showToast('🚶 Đường đi bộ: ' + dist.toFixed(2) + ' km (Khoảng ' + Math.round(time) + ' phút)', 'success');
                    animateRouteMarker(geojson.coordinates);
                } else {
                    drawDirectLineFallback(startLat, startLng, endLat, endLng);
                }
            })
            .catch(function(err) {
                console.warn("OSRM error, falling back to direct line:", err);
                drawDirectLineFallback(startLat, startLng, endLat, endLng);
            });
    }
    
    function animateRouteMarker(coordinates) {
        if (!coordinates || coordinates.length === 0) return;
        var latlngs = coordinates.map(function(c) { return L.latLng(c[1], c[0]); });
        
        var animDotIcon = L.divIcon({
            className: '',
            html: '<div class="route-anim-dot"></div>',
            iconSize: [12, 12], iconAnchor: [6, 6]
        });
        
        currentRouteAnimMarker = L.marker(latlngs[0], {icon: animDotIcon}).addTo(map);
        
        var step = 0;
        var totalSteps = latlngs.length;
        
        function moveDot() {
            if (!currentRouteAnimMarker || !map.hasLayer(currentRouteAnimMarker)) return;
            currentRouteAnimMarker.setLatLng(latlngs[step]);
            step = (step + 1) % totalSteps;
            setTimeout(moveDot, 350);
        }
        
        moveDot();
    }
    
    function drawDirectLineFallback(startLat, startLng, endLat, endLng) {
        currentRouteLine = L.polyline([[startLat, startLng], [endLat, endLng]], {
            color: '#3b82f6',
            weight: 5,
            opacity: 0.9,
            className: 'route-animated'
        }).addTo(map);
        
        map.fitBounds(currentRouteLine.getBounds(), { padding: [50, 50] });
        var d = calcDistance(startLat, startLng, endLat, endLng);
        showToast('📍 Đã nối đường thẳng chim bay: ' + formatDistance(d), 'success');
    }

    // ── Dynamic Floating Carousel (trên bản đồ) ──
    function renderDealsCarousel() {
        var container = document.getElementById('dynamic-carousel-container');
        if (!container) return;

        var bannerPlaces = allPlaces.filter(function(r) { return r.bannerUrl && r.bannerStatus === 2; });
        if (bannerPlaces.length === 0) {
            container.innerHTML = '';
            return;
        }

        if (userLatLng) {
            bannerPlaces = bannerPlaces.slice().sort(function(a, b) {
                var da = (a.latitude && a.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, a.latitude, a.longitude) : 9999;
                var db = (b.latitude && b.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, b.latitude, b.longitude) : 9999;
                return da - db;
            });
        } else {
            bannerPlaces = bannerPlaces.slice().sort(function(a, b) { return b.id - a.id; });
        }
        bannerPlaces = bannerPlaces.slice(0, 5);

        var slideCount = bannerPlaces.length;
        var currentSlide = 0;
        var autoplayTimer = null;

        function buildSlides(activeIdx) {
            return bannerPlaces.map(function(r, i) {
                var distBadge = '';
                if (userLatLng && r.latitude && r.longitude) {
                    var d = calcDistance(userLatLng.lat, userLatLng.lng, r.latitude, r.longitude);
                    distBadge = '<span class="fc-dist-badge">📍 '+formatDistance(d)+'</span>';
                }
                var label = r.itemType === 'hotel' ? '🏨 Khách sạn' : (r.isCafe ? '☕ Quán Cafe' : '🍴 Nhà hàng');
                return '<div class="fc-slide'+(i === activeIdx ? ' active' : '')+'" data-index="'+i+'" onclick="window.triggerDetailView('+allPlaces.indexOf(r)+')">'+
                    '<img src="'+r.bannerUrl+'" alt="'+r.name+'" class="fc-img" />'+
                    '<div class="fc-caption">'+
                        '<div class="fc-caption-name">'+r.name+' ('+label+')'+distBadge+'</div>'+
                    '</div>'+
                '</div>';
            }).join('');
        }

        function buildDots(activeIdx) {
            if (slideCount <= 1) return '';
            var d = '';
            for (var i = 0; i < slideCount; i++) {
                d += '<button class="fc-dot'+(i === activeIdx ? ' active' : '')+'" data-dot="'+i+'"></button>';
            }
            return '<div class="fc-dots">'+d+'</div>';
        }

        function goTo(idx) {
            currentSlide = (idx + slideCount) % slideCount;
            document.getElementById('fc-slides-wrap').innerHTML = buildSlides(currentSlide);
            var dotsWrap = document.getElementById('fc-dots-wrap');
            if (dotsWrap) dotsWrap.innerHTML = buildDots(currentSlide);
            bindDots();
        }

        function bindDots() {
            var dotsWrap = document.getElementById('fc-dots-wrap');
            if (!dotsWrap) return;
            dotsWrap.querySelectorAll('.fc-dot').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    clearInterval(autoplayTimer);
                    goTo(parseInt(this.dataset.dot));
                    startAutoplay();
                });
            });
        }

        function startAutoplay() {
            clearInterval(autoplayTimer);
            autoplayTimer = setInterval(function() { goTo(currentSlide + 1); }, 4500);
        }

        var nearbyLabel = userLatLng ? '<span class="fc-nearby-label">📍 Gần bạn</span>' : '';

        var html = '<div class="fc-wrapper" id="fc-wrapper" style="pointer-events:all;">'+
            '<div class="fc-header">'+
                '<span class="fc-title">✨ Địa điểm gợi ý cho bạn</span>'+
                nearbyLabel+
                '<button class="fc-close" id="fc-close" title="Đóng">✕</button>'+
            '</div>'+
            '<div class="fc-body">'+
                '<div class="fc-slides" id="fc-slides-wrap">'+buildSlides(0)+'</div>'+
                (slideCount > 1 ?
                    '<button class="fc-nav fc-prev" id="fc-prev">&#8249;</button>'+
                    '<button class="fc-nav fc-next" id="fc-next">&#8250;</button>' : '')+
            '</div>'+
            '<div id="fc-dots-wrap">'+buildDots(0)+'</div>'+
        '</div>';

        container.innerHTML = html;

        var closeBtn = document.getElementById('fc-close');
        if (closeBtn) closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            document.getElementById('fc-wrapper').style.display = 'none';
            clearInterval(autoplayTimer);
        });

        var prevBtn = document.getElementById('fc-prev');
        var nextBtn = document.getElementById('fc-next');
        if (prevBtn) prevBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            clearInterval(autoplayTimer);
            goTo(currentSlide - 1);
            startAutoplay();
        });
        if (nextBtn) nextBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            clearInterval(autoplayTimer);
            goTo(currentSlide + 1);
            startAutoplay();
        });

        bindDots();
        if (slideCount > 1) startAutoplay();
    }

    // ── "Ưu đãi siêu hời" Section (below map) ──
    function renderDealsBannerSection() {
        var track   = document.getElementById('deals-scroll-track');
        var section = document.getElementById('deals-section');
        var nearbyHint  = document.getElementById('deals-nearby-hint');
        var countLabel  = document.getElementById('deals-count-label');
        if (!track) return;

        var bannerPlaces = allPlaces.filter(function(r) { return r.bannerUrl && r.bannerStatus === 2; });
        if (bannerPlaces.length === 0) {
            if (section) section.style.display = 'none';
            return;
        }

        var hasGps = !!userLatLng;
        if (hasGps) {
            bannerPlaces = bannerPlaces.slice().sort(function(a, b) {
                var da = (a.latitude && a.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, a.latitude, a.longitude) : 9999;
                var db = (b.latitude && b.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, b.latitude, b.longitude) : 9999;
                return da - db;
            });
        } else {
            bannerPlaces = bannerPlaces.slice().sort(function(a, b) { return b.id - a.id; });
        }
        bannerPlaces = bannerPlaces.slice(0, 8);

        if (section) section.style.display = 'block';
        if (nearbyHint) nearbyHint.style.display = hasGps ? 'inline-flex' : 'none';
        if (countLabel) countLabel.textContent = bannerPlaces.length + ' địa điểm';

        var html = '';
        bannerPlaces.forEach(function(r) {
            var distHtml = '';
            if (hasGps && r.latitude && r.longitude) {
                var d = calcDistance(userLatLng.lat, userLatLng.lng, r.latitude, r.longitude);
                distHtml = '<div class="deal-banner-dist">📍 '+formatDistance(d)+'</div>';
            }
            var controller = r.itemType === 'hotel' ? 'Hotel' : 'Restaurant';
            html += '<a class="deal-banner-card" href="/'+controller+'/Details/'+r.id+'">'+
                        '<div class="deal-banner-img-wrap">'+
                            '<img src="'+r.bannerUrl+'" alt="'+r.name+'" />'+
                            '<div class="deal-banner-overlay"></div>'+
                        '</div>'+
                        '<div class="deal-banner-info">'+
                            '<div class="deal-banner-name">'+r.name+'</div>'+
                            distHtml+
                        '</div>'+
                    '</a>';
        });

        track.querySelectorAll('.deal-banner-card').forEach(function(el) { el.remove(); });
        track.insertAdjacentHTML('afterbegin', html);
    }

    // ── Xử lý Thu nhỏ/Mở rộng Sidebar trên Mobile ──
    function initMobileSidebarToggle() {
        var toggleBtn = document.getElementById('toggle-sidebar-btn');
        var sidebar = document.querySelector('.map-sidebar');
        var mapLayout = document.querySelector('.map-layout');
        
        if (toggleBtn && sidebar && mapLayout) {
            toggleBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                var isCollapsed = sidebar.classList.toggle('collapsed');
                mapLayout.classList.toggle('sidebar-collapsed', isCollapsed);
                
                var icon = toggleBtn.querySelector('.toggle-icon');
                if (isCollapsed) {
                    icon.textContent = '▲'; // Nhấn để mở rộng
                    if (typeof showToast === 'function') {
                        showToast('Đã thu nhỏ thanh tìm kiếm. Bạn có thể xem bản đồ rộng hơn!', 'info');
                    }
                } else {
                    icon.textContent = '▼'; // Nhấn để thu nhỏ
                }
                
                // Cập nhật lại kích thước bản đồ Leaflet sau khi co giãn
                setTimeout(function() {
                    if (typeof map !== 'undefined' && map) {
                        map.invalidateSize({ animate: true });
                    }
                }, 300);
            });
        }
    }

    // Call initially
    initMobileSidebarToggle();
    renderDealsCarousel();
    renderDealsBannerSection();

    setTimeout(function() {
        if (typeof showToast === 'function' && allPlaces.length > 0)
            showToast('Tìm thấy ' + allPlaces.length + ' địa điểm ẩm thực & lưu trú trên bản đồ!', 'success');
    }, 600);

})();
</script>
}