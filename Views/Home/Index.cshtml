    // ── Helper to start/stop Leaflet marker bounce animation ──
    function startMarkerBounce(idx) {
        if (markers[idx]) {
            var el = markers[idx].getElement();
            if (el) {
                var container = el.querySelector('.g-marker-container');
                if (container) container.classList.add('marker-bounce-active');
            }
        }
    }
    function stopMarkerBounce(idx) {
        if (markers[idx]) {
            var el = markers[idx].getElement();
            if (el) {
                var container = el.querySelector('.g-marker-container');
                if (container) container.classList.remove('marker-bounce-active');
            }
        }
    }

    // ── Render sidebar list ──
    function render(list) {
        var listEl = document.getElementById('restaurant-list');
        listEl.innerHTML = '';
        if (list.length === 0) {
            var icon = activeCategoryFilter === 'hotel' ? '🏨' : (activeCategoryFilter === 'cafe' ? '☕' : '🍴');
            var name = activeCategoryFilter === 'hotel' ? 'khách sạn' : (activeCategoryFilter === 'cafe' ? 'quán cafe' : (activeCategoryFilter === 'restaurant' ? 'nhà hàng' : 'địa điểm'));
            listEl.innerHTML = '<div class="empty-state"><div class="empty-state-icon">' + icon + '</div>'+
                '<div class="empty-state-title">Không tìm thấy ' + name + ' nào</div>'+
                '<div class="empty-state-desc">Thử thay đổi bộ lọc hoặc từ khoá khác</div></div>';
            document.getElementById('count-text').textContent = '0 ' + name;
            document.getElementById('count-badge').textContent = '0';
            return;
        }
        
        list.forEach(function(r) { 
            var actualIdx = allPlaces.indexOf(r);
            listEl.innerHTML += buildCard(r, actualIdx); 
        });
        
        var categoryName = activeCategoryFilter === 'hotel' ? ' khách sạn' : (activeCategoryFilter === 'cafe' ? ' quán cafe' : (activeCategoryFilter === 'restaurant' ? ' nhà hàng' : ' địa điểm'));
        document.getElementById('count-text').textContent = list.length + categoryName;
        document.getElementById('count-badge').textContent = list.length;
        
        listEl.querySelectorAll('.restaurant-item').forEach(function(el) {
            el.addEventListener('click', function() {
                var idx = parseInt(this.dataset.idx);
                var r = allPlaces[idx];
                showPlaceDetail(r, idx);
            });
            el.addEventListener('mouseenter', function() {
                var idx = parseInt(this.dataset.idx);
                startMarkerBounce(idx);
            });
            el.addEventListener('mouseleave', function() {
                var idx = parseInt(this.dataset.idx);
                stopMarkerBounce(idx);
            });
        });
    }

    // ── UNIFIED FILTER + SORT PIPELINE ──
    function applyFilters() {
        var q = (document.getElementById('search-input').value || '').trim().toLowerCase();
        
        // Show/hide clear search button
        var clearBtn = document.getElementById('clear-search');
        if (q.length > 0) {
            clearBtn.style.display = 'block';
        } else {
            clearBtn.style.display = 'none';
        }

        // 1. Filter: category + text + price
        var filtered = allPlaces.filter(function(r, i) {
            var catOk = (activeCategoryFilter === 'all') || 
                        (activeCategoryFilter === 'cafe' && r.itemType === 'restaurant' && r.isCafe) ||
                        (activeCategoryFilter === 'restaurant' && r.itemType === 'restaurant' && !r.isCafe) ||
                        (activeCategoryFilter === 'hotel' && r.itemType === 'hotel');
            
            var textOk = !q ||
                (r.name        && r.name.toLowerCase().includes(q)) ||
                (r.address     && r.address.toLowerCase().includes(q)) ||
                (r.description && r.description.toLowerCase().includes(q));
                
            var priceOk = matchPrice(r, activePriceFilter);
            
            var pass = catOk && textOk && priceOk;
            if (markers[i]) { 
                if (pass) markers[i].addTo(map); 
                else map.removeLayer(markers[i]); 
            }
            return pass;
        });

        // 2. Auto-sort nearest first when location is known
        if (userLatLng) {
            filtered = filtered.slice().sort(function(a, b) {
                var da = (a.latitude && a.longitude)
                    ? calcDistance(userLatLng.lat, userLatLng.lng, a.latitude, a.longitude) : 9999;
                var db = (b.latitude && b.longitude)
                    ? calcDistance(userLatLng.lat, userLatLng.lng, b.latitude, b.longitude) : 9999;
                return da - db;
            });
        }

        render(filtered);
    }

    // ── Build map markers ──
    allPlaces.forEach(function(r, i) {
        if (!r.latitude || !r.longitude) return;
        var m = L.marker([r.latitude, r.longitude], {icon: makeIcon(r, false)})
            .addTo(map)
            .bindPopup(buildPopup(r), {maxWidth: 240});
            
        m.on('click', function() { 
            showPlaceDetail(r, i);
        });
        
        m.on('popupclose', function() { 
            var detailView = document.getElementById('sidebar-detail-view');
            if (detailView.style.display === 'none' && activeIdx === i) {
                setActive(-1); 
            }
        });
        markers[i] = m;
    });

    applyFilters();

    // ── Search input ──
    document.getElementById('search-input').addEventListener('input', applyFilters);
    
    // Clear search event
    document.getElementById('clear-search').addEventListener('click', function() {
        document.getElementById('search-input').value = '';
        applyFilters();
        document.getElementById('search-input').focus();
    });

