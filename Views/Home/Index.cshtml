@model DACS.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Bản đồ ẩm thực & khách sạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Leaflet CSS *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="map-layout">
    @* ── Sidebar ── *@
    <aside class="map-sidebar">
        @* Nút thu nhỏ/mở rộng sidebar trên mobile *@
        <button type="button" class="btn-toggle-sidebar" id="toggle-sidebar-btn" aria-label="Thu nhỏ/Mở rộng">
            <span class="toggle-icon">▼</span>
        </button>

        @* ── View 1: List and Search View ── *@
        <div class="sidebar-view active" id="sidebar-list-view">
            <div class="map-sidebar-header">
                <div class="map-sidebar-title">
                    🗺️ <span>Tìm kiếm địa điểm</span>
                    <span class="badge-count" id="count-badge">0</span>
                </div>

                @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
                {
                    <div class="d-flex gap-2 mb-3">
                        <a asp-controller="Restaurant" asp-action="Create" class="btn-primary-custom w-50 justify-content-center text-center" style="font-size: .8rem; padding: .5rem; border-radius: 50px;">
                            🍴 Thêm nhà hàng
                        </a>
                        <a asp-controller="Hotel" asp-action="Create" class="btn-primary-custom w-50 justify-content-center text-center" style="font-size: .8rem; padding: .5rem; border-radius: 50px; background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); border: none;">
                            🏨 Thêm khách sạn
                        </a>
                    </div>
                }

                <div class="map-search-wrapper">
                    <div class="map-search">
                        <span class="map-search-icon">🔍</span>
                        <input id="search-input" type="text"
                               placeholder="Tìm kiếm nhà hàng, khách sạn..."
                               autocomplete="off" />
                        <button id="clear-search" class="clear-search-btn" style="display:none;" title="Xóa tìm kiếm">✕</button>
                    </div>
                </div>

                @* Phân loại địa điểm chips *@
                <div class="price-chips-container" style="margin-bottom: 0.4rem;">
                    <div class="price-chips" id="category-chips">
                        <button class="price-chip active" data-category="all">🗺️ Tất cả</button>
                        <button class="price-chip" data-category="restaurant">🍴 Nhà hàng</button>
                        <button class="price-chip" data-category="cafe">☕ Quán Cafe</button>
                        <button class="price-chip" data-category="hotel">🏨 Khách sạn</button>
                    </div>
                </div>

                @* Tầm giá quick chips *@
                <div class="price-chips-container">
                    <div class="price-chips" id="price-chips">
                        <button class="price-chip active" data-price="all">💰 Tất cả giá</button>
                        <button class="price-chip" data-price="cheap">💸 Giá rẻ</button>
                        <button class="price-chip" data-price="medium">💸 Vừa phải</button>
                        <button class="price-chip" data-price="premium">💎 Cao cấp</button>
                    </div>
                </div>

                @* Vị trí *@
                <div class="map-toolbar mt-2">
                    <button id="btn-my-location" class="btn-location" title="Vị trí hiện tại của tôi">
                        <span class="location-icon">🎯</span>
                        <span id="btn-location-text">Vị trí của tôi</span>
                    </button>
                    <span id="nearby-badge" class="nearby-badge" style="display:none;">🧭 Ưu tiên gần nhất</span>
                </div>
            </div>

            <div class="restaurant-list" id="restaurant-list">
                @* filled by JS *@
            </div>

            <div class="map-count-bar">
                <span>📍</span>
                <span id="count-text">Đang tải...</span>
                <span id="user-location-bar" class="user-location-bar" style="display:none;">
                    &nbsp;·&nbsp;📡 <span id="user-location-coords"></span>
                </span>
            </div>
        </div>

        @* ── View 2: Restaurant Detail View ── *@
        <div class="sidebar-view" id="sidebar-detail-view" style="display: none;">
            <div class="sidebar-detail-header">
                <button id="btn-back-to-list" class="btn-back-list">
                    <span>←</span> Quay lại kết quả
                </button>
            </div>
            
            <div class="sidebar-detail-body">
                <div class="detail-image-container" id="detail-image-container">
                    <img id="detail-img" src="" alt="Place Image" />
                    <div class="detail-gradient-overlay"></div>
                </div>
                
                <div class="detail-content-wrap">
                    <h2 class="detail-name" id="detail-name">Tên địa điểm</h2>
                    
                    <div class="detail-quick-meta">
                        <span class="detail-price-badge" id="detail-price">💰 50k - 100k</span>
                        <span class="detail-distance-badge" id="detail-distance" style="display:none;">🚶 0.0 km</span>
                    </div>

                    @* Hotel specific meta *@
                    <div class="detail-hotel-meta" id="detail-hotel-meta" style="display:none; margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.35rem;">
                        <span class="detail-star-badge" id="detail-stars" style="color: #eab308; font-weight: bold; font-size: 0.9rem;">⭐⭐⭐⭐⭐</span>
                        <div class="detail-amenities" id="detail-amenities" style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 0.15rem;">
                            <!-- filled by JS -->
                        </div>
                    </div>

                    <div class="detail-action-buttons">
                        <button id="btn-directions" class="btn-action-primary">
                            <span>🧭</span> Chỉ đường
                        </button>
                        <a id="btn-call" href="tel:" class="btn-action-outline">
                            <span>📞</span> Gọi điện
                        </a>
                        <a id="btn-full-details" href="" class="btn-action-outline">
                            <span>📝</span> Chi tiết & Bình luận
                        </a>
                    </div>

                    <hr class="detail-divider" />

                    <div class="detail-info-list">
                        <div class="detail-info-item">
                            <span class="info-icon">📍</span>
                            <div class="info-text">
                                <span class="info-val" id="detail-address">Địa chỉ</span>
                                <button class="btn-copy-address" id="btn-copy-address" title="Sao chép địa chỉ">📋 Sao chép</button>
                            </div>
                        </div>
                        
                        <div class="detail-info-item" id="detail-phone-item">
                            <span class="info-icon">📞</span>
                            <div class="info-text">
                                <span class="info-val" id="detail-phone">Số điện thoại</span>
                            </div>
                        </div>

                        <div class="detail-info-item">
                            <span class="info-icon">ℹ️</span>
                            <div class="info-text">
                                <span class="info-label" id="detail-desc-label">Mô tả</span>
                                <span class="info-val desc" id="detail-desc">Mô tả</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    @* ── Map ── *@
    <div class="map-container">
        <div id="map"></div>
        <div class="map-tip">💡 Click vào marker để xem thông tin quán</div>
        
        @* Custom Google Maps Style Theme Switcher *@
        <div class="map-style-selector" id="map-style-selector">
            <button class="style-btn active" data-style="voyager" title="Bản đồ sáng phong cách Google Maps">🗺️ Sáng</button>
            <button class="style-btn" data-style="dark" title="Bản đồ tối phong cách Dark Mode">🕶️ Tối</button>
        </div>

        @* Floating location button on map *@
        <button id="btn-locate-map" class="btn-locate-map" title="Vị trí hiện tại của tôi">
            <span>🎯</span>
        </button>

        @* Deals Carousel Floating Widget (Rendered by JS) *@
        <div id="dynamic-carousel-container" style="pointer-events:none;"></div>
    </div>
</div>

@* ── Gợi ý cho bạn Section ── *@
<section class="deals-section" id="deals-section" style="display:none;">
    <div class="deals-section-header">
        <div class="deals-section-title">
            ✨ Gợi ý dành cho bạn
            <span class="deals-nearby-hint" id="deals-nearby-hint" style="display:none;">📍 Ưu tiên gần bạn</span>
        </div>
        <span class="deals-count-label" id="deals-count-label"></span>
    </div>
    <div class="deals-scroll-track" id="deals-scroll-track">
        @* Filled by JS *@
    </div>
</section>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
    // ── Combined Data ──
    var restaurants = @Html.Raw(Json.Serialize(Model.Restaurants)) || [];
    restaurants.forEach(function(x) { 
        x.itemType = 'restaurant'; 
        x.isCafe = !!x.isCafe; 
    });

    var hotels = @Html.Raw(Json.Serialize(Model.Hotels)) || [];
    hotels.forEach(function(x) { x.itemType = 'hotel'; });

    var allPlaces = restaurants.concat(hotels);

    // ── Map init ──
    var map = L.map('map', { zoomControl: false }).setView([10.852, 106.761], 13);
    
    // Zoom control in bottom right
    L.control.zoom({ position: 'bottomright' }).addTo(map);

    // ── Map Tile Layers ──
    var voyagerTiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors © <a href="https://carto.com/attributions">CARTO</a>',
        maxZoom: 20
    }).addTo(map);

    var darkTiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors © <a href="https://carto.com/attributions">CARTO</a>',
        maxZoom: 20
    });

    // ── Synchronized Map Theme Selector Event ──
    function setMapStyle(style, dispatchEvent) {
        var layout = document.querySelector('.map-layout');
        map.removeLayer(voyagerTiles);
        map.removeLayer(darkTiles);
        
        var btn = document.querySelector('.style-btn[data-style="' + style + '"]');
        if (btn) {
            document.querySelectorAll('.style-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
        
        if (style === 'voyager') {
            voyagerTiles.addTo(map);
            if (layout) layout.classList.remove('dark-theme');
            document.body.classList.remove('dark-theme');
            if (dispatchEvent) {
                window.dispatchEvent(new CustomEvent('map-theme-changed', { detail: { theme: 'light' } }));
            }
        } else if (style === 'dark') {
            darkTiles.addTo(map);
            if (layout) layout.classList.add('dark-theme');
            document.body.classList.add('dark-theme');
            if (dispatchEvent) {
                window.dispatchEvent(new CustomEvent('map-theme-changed', { detail: { theme: 'dark' } }));
            }
        }
    }

    document.getElementById('map-style-selector').addEventListener('click', function(e) {
        var btn = e.target.closest('.style-btn');
        if (!btn) return;
        setMapStyle(btn.dataset.style, true);
    });

    // Listen to unified theme change event from Navbar
    window.addEventListener('theme-changed', function (e) {
        setMapStyle(e.detail.theme === 'dark' ? 'dark' : 'voyager', false);
    });

    // Sync initial theme
    var initialTheme = document.documentElement.classList.contains('dark-theme') ? 'dark' : 'voyager';
    if (initialTheme === 'dark') {
        setTimeout(function() {
            setMapStyle('dark', false);
        }, 150);
    }

    // ── Leaflet custom markers ──
    function makeIcon(r, active) {
        var isHotel = (r.itemType === 'hotel');
        var isCafe = (r.itemType === 'restaurant' && r.isCafe);
        var color;
        var emoji;
        if (isHotel) {
            color = active ? '#eab308' : '#2563eb'; // Gold active, Blue standard for Hotel
            emoji = '🏨';
        } else if (isCafe) {
            color = active ? '#eab308' : '#854d0e'; // Gold active, Coffee Brown standard for Cafe
            emoji = '☕';
        } else {
            color = active ? '#eab308' : '#ef4444'; // Gold active, Red standard for Restaurant
            emoji = '🍴';
        }
        
        var htmlStr = '<div class="g-marker-container' + (active ? ' g-active' : '') + '">' +
            '<svg class="g-marker-svg" viewBox="0 0 32 42" xmlns="http://www.w3.org/2000/svg">' +
                '<path fill="' + color + '" stroke="#fff" stroke-width="1.5" d="M16 2C8.8 2 3 7.8 3 15c0 9.7 12 24.3 12.5 24.9.3.4.7.6 1 .6.4 0 .7-.2 1-.6C18 39.3 30 24.7 30 15c0-7.2-5.8-13-13-13z"/>' +
                '<circle fill="#fff" cx="16" cy="15" r="7.5"/>' +
            '</svg>' +
            '<span class="g-marker-emoji">' + emoji + '</span>' +
            '</div>';
            
        return L.divIcon({
            className: '',
            html: htmlStr,
            iconSize: [34, 44], iconAnchor: [17, 44], popupAnchor: [0, -40]
        });
    }

    // ── State ──
    var markers         = [];
    var activeIdx       = -1;
    var userLatLng      = null;
    var userMarker      = null;
    var userAccuracyCircle = null;
    var activeCategoryFilter = 'all'; // 'all' | 'restaurant' | 'hotel'
    var activePriceFilter = 'all';   // 'all' | 'cheap' | 'medium' | 'premium'
    var currentRouteLine = null;
    var currentRouteAnimMarker = null;

    // ── Haversine distance (km) ──
    function calcDistance(lat1, lon1, lat2, lon2) {
        var R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLon = (lon2-lon1)*Math.PI/180;
        var a = Math.sin(dLat/2)*Math.sin(dLat/2) +
                Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*
                Math.sin(dLon/2)*Math.sin(dLon/2);
        return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
    }
    function formatDistance(km) {
        return km < 1 ? Math.round(km*1000)+' m' : km.toFixed(1)+' km';
    }

    // ── Price filter logic ──
    function extractPriceNums(str) {
        if (!str) return null;
        // Clean thousand separators (dots) first
        var cleanStr = str.replace(/\./g, '');
        var nums = cleanStr.match(/\d+/g);
        if (!nums || nums.length === 0) return null;
        var arr = nums.map(function(numStr) {
            var val = Number(numStr);
            // Support "k" format (e.g. 50k -> 50000)
            if (str.toLowerCase().includes('k') && val < 1000) {
                val = val * 1000;
            }
            // Support "triệu" / "tr" format (e.g. 1.5tr -> 1500000)
            if ((str.toLowerCase().includes('triệu') || str.toLowerCase().includes('tr')) && val < 1000) {
                val = val * 1000000;
            }
            return val;
        });
        return { min: Math.min.apply(null, arr), max: Math.max.apply(null, arr) };
    }
    function matchPrice(r, filter) {
        if (filter === 'all') return true;
        var raw = (r.priceRange || '').toLowerCase();
        var p   = extractPriceNums(r.priceRange);

        // ── KHÁCH SẠN ──
        // Giá rẻ:   min <= 500.000đ/đêm
        // Vừa phải: min <= 1.200.000đ/đêm
        // Cao cấp:  max >= 1.000.000đ/đêm
        if (r.itemType === 'hotel') {
            if (p === null) return filter === 'all';
            if (filter === 'cheap')   return p.min <= 500000;
            if (filter === 'medium')  return p.min <= 1200000;
            if (filter === 'premium') return p.max >= 1000000;
        }

        // ── QUÁN CAFE / TRÀ SỮA ──
        // Giá rẻ:   max <= 25.000đ (Cafe cóc, cafe bình dân vỉa hè)
        // Vừa phải: max <= 50.000đ (Highlands Coffee, trà sữa trung bình)
        // Cao cấp:  max >= 45.000đ (Katinat, Phúc Long, Starbucks)
        if (r.itemType === 'restaurant' && r.isCafe) {
            if (p === null) return filter === 'all';
            if (filter === 'cheap')   return p.max <= 25000;
            if (filter === 'medium')  return p.max > 25000 && p.max <= 50000;
            if (filter === 'premium') return p.max >= 45000;
        }

        // ── NHÀ HÀNG / QUÁN ĂN ──
        // Giá rẻ:   max <= 45.000đ (Cơm tấm vỉa hè, bánh mì, hủ tiếu bình dân)
        // Vừa phải: max <= 90.000đ (Phở Lệ, quán ăn gia đình)
        // Cao cấp:  max >= 80.000đ (Buffet, nhà hàng nướng/lẩu lớn)
        if (p === null) return filter === 'all';
        if (filter === 'cheap')   return p.max <= 45000;
        if (filter === 'medium')  return p.max > 45000 && p.max <= 90000;
        if (filter === 'premium') return p.max >= 80000;

        return true;
    }

    // ── Build popup HTML ──
    function buildPopup(r) {
        var desc  = r.description ? '<div class="popup-desc">'+r.description+'</div>' : '';
        var price = r.priceRange  ? '<div class="popup-price">💰 '+r.priceRange+'</div>' : '';
        var distHtml = '';
        if (userLatLng && r.latitude && r.longitude) {
            distHtml = '<div class="popup-dist">🚶 '+
                formatDistance(calcDistance(userLatLng.lat,userLatLng.lng,r.latitude,r.longitude))+
                ' từ bạn</div>';
        }
        var typeLabel;
        var typeStyle;
        if (r.itemType === 'hotel') {
            typeLabel = '🏨 Khách sạn';
            typeStyle = 'color:#2563eb';
        } else if (r.isCafe) {
            typeLabel = '☕ Quán Cafe';
            typeStyle = 'color:#854d0e';
        } else {
            typeLabel = '🍴 Nhà hàng';
            typeStyle = 'color:#ef4444';
        }
        
        return '<div class="popup-card">'+
               '<div class="popup-type" style="font-size: 0.7rem; font-weight: 700; ' + typeStyle + '; margin-bottom: 2px;">' + typeLabel + '</div>'+
               '<div class="popup-name">'+r.name+'</div>'+
               '<div class="popup-addr">📍 '+(r.address||'Chưa có địa chỉ')+'</div>'+
               price+distHtml+desc+
               '<button class="btn-popup-more mt-2 w-100" onclick="window.triggerDetailView(' + allPlaces.indexOf(r) + ')">Xem chi tiết ở sidebar</button>'+
               '</div>';
    }

    // ── Build sidebar card HTML ──
    function buildCard(r, i) {
        var priceTag  = r.priceRange ? '<span class="card-price-tag">'+r.priceRange+'</span>' : '';
        var distBadge = '';
        if (userLatLng && r.latitude && r.longitude) {
            distBadge = '<span class="card-dist-badge">🚶 '+
                formatDistance(calcDistance(userLatLng.lat,userLatLng.lng,r.latitude,r.longitude))+
                '</span>';
        }
        
        var tagColor, tagEmoji;
        if (r.itemType === 'hotel') {
            tagColor = 'linear-gradient(135deg, #2563eb, #1d4ed8)';
            tagEmoji = '🏨 Khách sạn';
        } else if (r.isCafe) {
            tagColor = 'linear-gradient(135deg, #854d0e, #a16207)';
            tagEmoji = '☕ Quán Cafe';
        } else {
            tagColor = 'linear-gradient(135deg, #ef4444, #dc2626)';
            tagEmoji = '🍴 Nhà hàng';
        }
        var typeBadge = '<span class="badge" style="background: ' + tagColor + '; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.65rem; font-weight: bold; margin-right: 4px;">' + tagEmoji + '</span>';
        
        var fallbackImg = r.itemType === 'hotel' ? 
            'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=150' : 
            (r.isCafe ? 'https://images.unsplash.com/photo-1507133750040-4a8f57021571?w=150' : 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=150');

        return '<div class="restaurant-item" id="item-'+i+'" data-idx="'+i+'">'+
               '<div class="restaurant-item-img">'+
               '    <img src="'+ (r.imageUrl || fallbackImg) +'" alt="place thumb" />'+
               '</div>'+
               '<div class="restaurant-item-info">'+
               '    <div class="restaurant-item-name">'+r.name+'</div>'+
               '    <div class="restaurant-item-meta">'+
               '        ' + typeBadge + priceTag + distBadge +
               '    </div>'+
               '    <div class="restaurant-item-addr">📍 '+(r.address||'—')+'</div>'+
               '</div></div>';
    }

    // ── Active marker highlight ──
    function setActive(idx) {
        if (activeIdx >= 0 && markers[activeIdx] && allPlaces[activeIdx]) {
            markers[activeIdx].setIcon(makeIcon(allPlaces[activeIdx], false));
            var old = document.getElementById('item-'+activeIdx);
            if (old) old.classList.remove('active');
        }
        activeIdx = idx;
        if (idx < 0) return;
        
        if (markers[idx] && allPlaces[idx]) {
            markers[idx].setIcon(makeIcon(allPlaces[idx], true));
        }
        
        var el = document.getElementById('item-'+idx);
        if (el) { 
            el.classList.add('active'); 
            el.scrollIntoView({behavior:'smooth',block:'nearest'}); 
        }
    }

    // ── Show Place Detail View inside Sidebar ──
    function showPlaceDetail(r, idx) {
        if (!r) return;
        
        // Populate detail panel elements
        document.getElementById('detail-name').textContent = r.name;
        document.getElementById('detail-address').textContent = r.address || 'Chưa có địa chỉ';
        document.getElementById('detail-price').textContent = r.priceRange ? '💰 ' + r.priceRange : '💰 Tầm giá chưa cập nhật';
        
        var descLabel = document.getElementById('detail-desc-label');
        if (descLabel) {
            descLabel.textContent = r.itemType === 'hotel' ? 'Mô tả khách sạn' : (r.isCafe ? 'Mô tả quán cafe' : 'Mô tả quán ăn');
        }
        document.getElementById('detail-desc').textContent = r.description || (r.itemType === 'hotel' ? 'Chưa có mô tả chi tiết cho khách sạn này.' : (r.isCafe ? 'Chưa có mô tả chi tiết cho quán cafe này.' : 'Chưa có mô tả chi tiết cho quán ăn này.'));
        
        var phoneVal = r.phoneNumber || 'Không có';
        document.getElementById('detail-phone').textContent = phoneVal;
        var phoneItem = document.getElementById('detail-phone-item');
        if (r.phoneNumber) {
            phoneItem.style.display = 'flex';
            document.getElementById('btn-call').href = 'tel:' + r.phoneNumber;
            document.getElementById('btn-call').style.display = 'inline-flex';
        } else {
            phoneItem.style.display = 'none';
            document.getElementById('btn-call').style.display = 'none';
        }
        
        // Hotel Specific Meta
        var hotelMeta = document.getElementById('detail-hotel-meta');
        if (r.itemType === 'hotel') {
