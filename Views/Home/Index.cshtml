@model DACS.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Bản đồ ẩm thực & khách sạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Leaflet CSS *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
@* Leaflet.markercluster CSS *@
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />

<style>
    /* ── Desktop Toggle Button Styles ── */
    @@media (min-width: 769px) {
        .btn-toggle-sidebar-mobile { display: none !important; }
        .btn-toggle-sidebar-desktop {
            display: flex !important;
            position: absolute !important;
            left: 388px !important;
            top: 40px !important;
            width: 36px !important;
            height: 36px !important;
            border-radius: 50% !important;
            background: #ffffff !important;
            border: 1px solid rgba(0,0,0,0.1) !important;
            color: #5f6368 !important;
            z-index: 99999 !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.12) !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }
        .btn-toggle-sidebar-desktop:hover {
            background: #f8f9fa !important;
            color: #ea580c !important;
            transform: scale(1.08) !important;
        }
        .map-layout.sidebar-collapsed .btn-toggle-sidebar-desktop {
            left: 6px !important;
            border-radius: 0 50% 50% 0 !important;
        }
        .dark-theme .btn-toggle-sidebar-desktop {
            background: #162032 !important;
            border-color: rgba(255,255,255,0.1) !important;
            color: #ffffff !important;
        }
        .dark-theme .btn-toggle-sidebar-desktop:hover {
            background: #1e293b !important;
            color: #ea580c !important;
        }
    }

    /* ── Mobile Floating Toggle Button (outside sidebar, always visible) ── */
    @@media (max-width: 768px) {
        .btn-toggle-sidebar-desktop { display: none !important; }

        /* Floating pill button that lives OUTSIDE the sidebar */
        .btn-mobile-sheet-toggle {
            display: flex !important;
            position: fixed !important;
            bottom: 68px !important;  /* sits just above collapsed sheet (62px) + margin */
            left: 50% !important;
            transform: translateX(-50%) !important;
            z-index: 1200 !important;
            background: #ffffff !important;
            border: 1px solid rgba(0,0,0,0.12) !important;
            box-shadow: 0 4px 16px rgba(0,0,0,0.18) !important;
            border-radius: 24px !important;
            padding: 8px 18px !important;
            gap: 6px !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            font-size: 0.8rem !important;
            font-weight: 600 !important;
            color: #202124 !important;
            letter-spacing: 0.1px !important;
            transition: opacity 0.25s ease, transform 0.25s ease, bottom 0.3s cubic-bezier(0.4,0,0.2,1) !important;
            pointer-events: auto !important;
            white-space: nowrap !important;
        }

        /* When sidebar is expanded, move button above the expanded sheet */
        .map-layout:not(.sidebar-collapsed) .btn-mobile-sheet-toggle {
            bottom: 408px !important;
        }

        .btn-mobile-sheet-toggle .toggle-arrow {
            font-size: 0.7rem !important;
            transition: transform 0.3s ease !important;
            display: inline-block !important;
        }

        /* When collapsed, arrow points up */
        .map-layout.sidebar-collapsed .btn-mobile-sheet-toggle .toggle-arrow {
            transform: rotate(0deg) !important;
        }
        /* When expanded, arrow points down */
        .map-layout:not(.sidebar-collapsed) .btn-mobile-sheet-toggle .toggle-arrow {
            transform: rotate(180deg) !important;
        }

        .dark-theme .btn-mobile-sheet-toggle {
            background: rgba(15,23,42,0.92) !important;
            border-color: rgba(255,255,255,0.1) !important;
            color: #e2e8f0 !important;
            box-shadow: 0 4px 16px rgba(0,0,0,0.45) !important;
        }

        /* Redesigned bottom sheet collapsed state */
        .map-sidebar.collapsed .map-sidebar-header {
            display: flex !important;
        }
    }

    /* ── Price Range Input ── */
    .price-input-container {
        padding: 7px 10px 10px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin: 4px 0 8px;
    }
    .dark-theme .price-input-container {
        background: rgba(255,255,255,0.06);
        border-color: rgba(255,255,255,0.1);
    }
    .price-input-label {
        font-size: 0.75rem; color: #64748b; font-weight: 600;
        margin-bottom: 6px; display: block;
    }
    .dark-theme .price-input-label { color: #94a3b8; }
    .price-input-row {
        display: flex; align-items: center; gap: 6px;
    }
    .price-input-field {
        flex: 1; min-width: 0;
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        color: #111827;
        font-weight: 600;
        font-size: 0.82rem; padding: 5px 8px;
        outline: none; transition: border-color .15s;
        -moz-appearance: textfield;
    }
    .price-input-field::-webkit-outer-spin-button,
    .price-input-field::-webkit-inner-spin-button { -webkit-appearance: none; }
    .price-input-field:focus { border-color: var(--primary, #f97316); }
    .price-input-field::placeholder { color: #9ca3af; font-size: 0.75rem; font-weight: 400; }
    .dark-theme .price-input-field {
        background: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.2);
        color: #f1f5f9;
    }
    .dark-theme .price-input-field::placeholder { color: #64748b; }
    .price-input-sep { color: var(--text-muted, #64748b); font-size: 0.8rem; flex-shrink: 0; }
    .price-input-reset {
        background: none; border: none; cursor: pointer; padding: 4px 5px;
        color: var(--text-muted, #94a3b8); font-size: 0.72rem; border-radius: 6px;
        flex-shrink: 0; line-height: 1; display: none;
    }
    .price-input-reset:hover { color: var(--primary, #f97316); }
    .restaurant-item-meta { flex-wrap: wrap; gap: 3px; }

    /* ── Description search bar ── */
    .desc-search-bar {
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        padding: 10px 20px 8px;
    }
    .dark-theme .desc-search-bar {
        background: #1e293b;
        border-bottom-color: rgba(255,255,255,0.08);
    }
    .desc-search-inner {
        display: flex; align-items: center; gap: 10px;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 8px 14px;
        transition: border-color .2s;
    }
    .dark-theme .desc-search-inner {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.12);
    }
    .desc-search-inner:focus-within {
        border-color: var(--primary, #f97316);
        box-shadow: 0 0 0 3px rgba(249,115,22,0.12);
    }
    .desc-search-icon { font-size: 1rem; flex-shrink: 0; }
    .desc-search-input {
        flex: 1; border: none; background: transparent; outline: none;
        font-size: 0.88rem; color: #1e293b;
    }
    .dark-theme .desc-search-input { color: #f1f5f9; }
    .desc-search-input::placeholder { color: #94a3b8; }
    .desc-search-clear {
        background: none; border: none; cursor: pointer;
        color: #94a3b8; font-size: 0.8rem; padding: 2px 4px;
        flex-shrink: 0; border-radius: 4px;
    }
    .desc-search-clear:hover { color: var(--primary, #f97316); }
    .desc-search-hint {
        font-size: 0.75rem; color: #64748b; margin-top: 5px; padding-left: 2px;
    }
    .dark-theme .desc-search-hint { color: #94a3b8; }
    .desc-search-hint b { color: var(--primary, #f97316); }
</style>

<div class="desc-search-bar" id="desc-search-bar">
    <div class="desc-search-inner">
        <span class="desc-search-icon">✨</span>
        <input id="desc-search-input" type="text" class="desc-search-input"
               placeholder="Mô tả nơi bạn muốn tìm... vd: &quot;quán yên tĩnh trên Nguyễn Huệ có view đẹp&quot;" />
        <button id="desc-search-clear" class="desc-search-clear" style="display:none;" title="Xóa">✕</button>
    </div>
    <div id="desc-search-hint" class="desc-search-hint" style="display:none;"></div>
</div>

<div class="map-layout">
    @* ── Sidebar ── *@
    <aside class="map-sidebar">

        @* ── View 1: List and Search View ── *@
        <div class="sidebar-view active" id="sidebar-list-view">
            <div class="map-sidebar-header">
                <div class="map-sidebar-title">
                    🗺️ <span>Tìm kiếm địa điểm</span>
                    <span class="badge-count" id="count-badge">0</span>
                </div>

                @if (User.IsInRole("Owner") || User.IsInRole("Admin"))
                {
                    <div class="d-flex gap-2 mb-3">
                        <a asp-controller="Place" asp-action="Create" class="btn-primary-custom w-100 justify-content-center text-center" style="font-size: .8rem; padding: .5rem; border-radius: 50px;">
                            ➕ Thêm địa điểm
                        </a>
                    </div>
                }

                <div class="map-search-wrapper">
                    <div class="map-search">
                        <span class="map-search-icon">🔍</span>
                        <input id="search-input" type="text"
                               placeholder="Tìm kiếm nhà hàng, khách sạn..."
                               autocomplete="off" />
                        <button id="clear-search" class="clear-search-btn" style="display:none;" title="Xóa tìm kiếm">✕</button>
                    </div>
                </div>

                @* Phân loại địa điểm chips *@
                <div class="price-chips-container" style="margin-bottom: 0.4rem;">
                    <div class="price-chips" id="category-chips">
                        <button class="price-chip active" data-category="all">🗺️ Tất cả</button>
                        <button class="price-chip" data-category="restaurant">🍴 Nhà hàng</button>
                        <button class="price-chip" data-category="cafe">☕ Quán Cafe</button>
                        <button class="price-chip" data-category="hotel">🏨 Khách sạn</button>
                    </div>
                </div>

                @* Tầm giá inputs *@
                <div class="price-input-container">
                    <span class="price-input-label">💰 Tầm giá (nghìn đồng)</span>
                    <div class="price-input-row">
                        <input id="price-min-input" type="number" class="price-input-field" placeholder="Từ" min="0" step="10" />
                        <span class="price-input-sep">—</span>
                        <input id="price-max-input" type="number" class="price-input-field" placeholder="Đến" min="0" step="10" />
                        <button id="price-input-reset" class="price-input-reset" title="Xóa bộ lọc giá">✕</button>
                    </div>
                </div>

                @* Vị trí *@
                <div class="map-toolbar mt-2">
                    <button id="btn-my-location" class="btn-location" title="Vị trí hiện tại của tôi">
                        <span class="location-icon">🎯</span>
                        <span id="btn-location-text">Vị trí của tôi</span>
                    </button>
                    <span id="nearby-badge" class="nearby-badge" style="display:none;">🧭 Ưu tiên gần nhất</span>
                </div>
            </div>

            <div class="restaurant-list" id="restaurant-list">
                @* filled by JS *@
            </div>

            <div class="map-count-bar">
                <span>📍</span>
                <span id="count-text">Đang tải...</span>
                <span id="user-location-bar" class="user-location-bar" style="display:none;">
                    &nbsp;·&nbsp;📡 <span id="user-location-coords"></span>
                </span>
            </div>
        </div>

        @* ── View 2: Restaurant Detail View ── *@
        <div class="sidebar-view" id="sidebar-detail-view" style="display: none;">
            <div class="sidebar-detail-header">
                <button id="btn-back-to-list" class="btn-back-list">
                    <span>←</span> Quay lại kết quả
                </button>
            </div>
            
            <div class="sidebar-detail-body">
                <div class="detail-image-container" id="detail-image-container">
                    <img id="detail-img" src="" alt="Place Image" />
                    <div class="detail-gradient-overlay"></div>
                </div>
                
                <div class="detail-content-wrap">
                    <h2 class="detail-name" id="detail-name">Tên địa điểm</h2>
                    
                    <div class="detail-quick-meta">
                        <span class="detail-price-badge" id="detail-price">💰 50k - 100k</span>
                        <span class="detail-distance-badge" id="detail-distance" style="display:none;">🚶 0.0 km</span>
                    </div>

                    @* Hotel specific meta *@
                    <div class="detail-hotel-meta" id="detail-hotel-meta" style="display:none; margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.35rem;">
                        <span class="detail-star-badge" id="detail-stars" style="color: #eab308; font-weight: bold; font-size: 0.9rem;">⭐⭐⭐⭐⭐</span>
                        <div class="detail-amenities" id="detail-amenities" style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 0.15rem;">
                            <!-- filled by JS -->
                        </div>
                    </div>

                    <div class="detail-action-buttons">
                        <button id="btn-directions" class="btn-action-primary">
                            <span>🧭</span> Chỉ đường
                        </button>
                        <a id="btn-call" href="tel:" class="btn-action-outline">
                            <span>📞</span> Gọi điện
                        </a>
                        <a id="btn-full-details" href="" class="btn-action-outline">
                            <span>📝</span> Chi tiết & Bình luận
                        </a>
                    </div>

                    <hr class="detail-divider" />

                    <div class="detail-info-list">
                        <div class="detail-info-item">
                            <span class="info-icon">📍</span>
                            <div class="info-text">
                                <span class="info-val" id="detail-address">Địa chỉ</span>
                                <button class="btn-copy-address" id="btn-copy-address" title="Sao chép địa chỉ">📋 Sao chép</button>
                            </div>
                        </div>
                        
                        <div class="detail-info-item" id="detail-phone-item">
                            <span class="info-icon">📞</span>
                            <div class="info-text">
                                <span class="info-val" id="detail-phone">Số điện thoại</span>
                            </div>
                        </div>

                        <div class="detail-info-item">
                            <span class="info-icon">ℹ️</span>
                            <div class="info-text">
                                <span class="info-label" id="detail-desc-label">Mô tả</span>
                                <span class="info-val desc" id="detail-desc">Mô tả</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
    </aside>

    @* ── Map ── *@
    <div class="map-container">
        <div id="map"></div>
        <div class="map-tip">💡 Click vào marker để xem thông tin quán</div>
        
        @* Custom Google Maps Style Theme Switcher *@
        <div class="map-style-selector" id="map-style-selector">
            <button class="style-btn active" data-style="voyager" title="Bản đồ sáng phong cách Google Maps">🗺️ Sáng</button>
            <button class="style-btn" data-style="dark" title="Bản đồ tối phong cách Dark Mode">🕶️ Tối</button>
        </div>

        @* Floating location button on map *@
        <button id="btn-locate-map" class="btn-locate-map" title="Vị trí hiện tại của tôi">
            <span>🎯</span>
        </button>

        @* Deals Carousel Floating Widget (Rendered by JS) *@
        <div id="dynamic-carousel-container" style="pointer-events:none;"></div>
    </div>

    @* Desktop Toggle Button (outside sidebar, sibling of map-container) *@
    <button type="button" class="btn-toggle-sidebar btn-toggle-sidebar-desktop" id="toggle-sidebar-btn-desktop" aria-label="Thu nhỏ/Mở rộng">
        <span class="toggle-icon">◀</span>
    </button>

    @* Mobile Floating Sheet Toggle (outside sidebar, always visible, position fixed) *@
    <button type="button" class="btn-mobile-sheet-toggle" id="toggle-sidebar-btn-mobile" aria-label="Thu nhỏ/Mở rộng danh sách">
        <span class="toggle-arrow">▲</span>
        <span class="toggle-label">Danh sách</span>
    </button>
</div>

@* ── Gợi ý cho bạn Section ── *@
<section class="deals-section" id="deals-section" style="display:none;">
    <div class="deals-section-header">
        <div class="deals-section-title">
            ✨ Gợi ý dành cho bạn
            <span class="deals-nearby-hint" id="deals-nearby-hint" style="display:none;">📍 Ưu tiên gần bạn</span>
        </div>
        <span class="deals-count-label" id="deals-count-label"></span>
    </div>
    <div class="deals-scroll-track" id="deals-scroll-track">
        @* Filled by JS *@
    </div>
</section>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
<script>
(function () {
    // ── Combined Data ──
    var allPlaces = @Html.Raw(Json.Serialize(Model.Places)) || [];
    allPlaces.forEach(function(x, i) {
        x._idx = i;
        var slugs = x.categorySlugs || [];
        x.isHotel      = slugs.includes('hotel');
        x.isRestaurant = slugs.includes('restaurant');
        x.isCafe       = slugs.includes('cafe');
    });

    // ── Map init ──
    var map = L.map('map', { zoomControl: false, tap: false }).setView([10.852, 106.761], 13);
    
    // Zoom control in bottom right
    L.control.zoom({ position: 'bottomright' }).addTo(map);

    // ── Map Tile Layers ──
    var voyagerTiles = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri',
        maxNativeZoom: 19,
        maxZoom: 20
    }).addTo(map);

    var darkTiles = L.layerGroup([
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', { attribution: 'Tiles &copy; Esri', maxNativeZoom: 16, maxZoom: 20 }),
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', { maxNativeZoom: 16, maxZoom: 20 })
    ]);

    // ── Synchronized Map Theme Selector Event ──
    function setMapStyle(style, dispatchEvent) {
        var layout = document.querySelector('.map-layout');
        map.removeLayer(voyagerTiles);
        map.removeLayer(darkTiles);
        
        var btn = document.querySelector('.style-btn[data-style="' + style + '"]');
        if (btn) {
            document.querySelectorAll('.style-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
        
        if (style === 'voyager') {
            voyagerTiles.addTo(map);
            if (layout) layout.classList.remove('dark-theme');
            document.body.classList.remove('dark-theme');
            if (dispatchEvent) {
                window.dispatchEvent(new CustomEvent('map-theme-changed', { detail: { theme: 'light' } }));
            }
        } else if (style === 'dark') {
            darkTiles.addTo(map);
            if (layout) layout.classList.add('dark-theme');
            document.body.classList.add('dark-theme');
            if (dispatchEvent) {
                window.dispatchEvent(new CustomEvent('map-theme-changed', { detail: { theme: 'dark' } }));
            }
        }
    }

    document.getElementById('map-style-selector').addEventListener('click', function(e) {
        var btn = e.target.closest('.style-btn');
        if (!btn) return;
        setMapStyle(btn.dataset.style, true);
    });

    // Listen to unified theme change event from Navbar
    window.addEventListener('theme-changed', function (e) {
        setMapStyle(e.detail.theme === 'dark' ? 'dark' : 'voyager', false);
    });

    // Sync initial theme
    var initialTheme = document.documentElement.classList.contains('dark-theme') ? 'dark' : 'voyager';
    if (initialTheme === 'dark') {
        setTimeout(function() {
            setMapStyle('dark', false);
        }, 150);
    }

    // ── Leaflet custom markers ──
    function makeIcon(r, active) {
        var isHotel = r.isHotel;
        var isCafe = r.isCafe && !r.isRestaurant;
        var color;
        var emoji;
        if (isHotel) {
            color = active ? '#eab308' : '#2563eb'; // Gold active, Blue standard for Hotel
            emoji = '🏨';
        } else if (isCafe) {
            color = active ? '#eab308' : '#854d0e'; // Gold active, Coffee Brown standard for Cafe
            emoji = '☕';
        } else {
            color = active ? '#eab308' : '#ef4444'; // Gold active, Red standard for Restaurant
            emoji = '🍴';
        }
        
        var htmlStr = '<div class="g-marker-container' + (active ? ' g-active' : '') + '">' +
            '<svg class="g-marker-svg" viewBox="0 0 32 42" xmlns="http://www.w3.org/2000/svg">' +
                '<path fill="' + color + '" stroke="#fff" stroke-width="1.5" d="M16 2C8.8 2 3 7.8 3 15c0 9.7 12 24.3 12.5 24.9.3.4.7.6 1 .6.4 0 .7-.2 1-.6C18 39.3 30 24.7 30 15c0-7.2-5.8-13-13-13z"/>' +
                '<circle fill="#fff" cx="16" cy="15" r="7.5"/>' +
            '</svg>' +
            '<span class="g-marker-emoji">' + emoji + '</span>' +
            '</div>';
            
        return L.divIcon({
            className: '',
            html: htmlStr,
            iconSize: [34, 44], iconAnchor: [17, 44], popupAnchor: [0, -40]
        });
    }

    // ── State ──
    var markers         = [];
    var activeIdx       = -1;
    var userLatLng      = null;
    var userMarker      = null;
    var userAccuracyCircle = null;
    var activeCategoryFilters = new Set(); // empty = all
    var priceSliderMin = 0; // 0 = no lower bound
    var priceSliderMax = 0; // 0 = no upper bound
    var descTerms = []; // tokenized description search

    var STOP_WORDS = new Set([
        'tôi','tui','bạn','mình','họ','chúng','ta','các','những','một','hai','ba','và','hay','hoặc',
        'là','có','không','được','cho','với','trong','ngoài','trên','dưới','tại','ở','về','từ',
        'của','này','đó','kia','đây','thì','mà','để','vì','nên','nhưng','tuy','dù','vậy',
        'muốn','tìm','cần','xem','hỏi','biết','thấy','đang','đã','sẽ','rất','quá',
        'cũng','nữa','thôi','nhé','ạ','ơi','nhỉ','vẫn','còn','đều','chỉ','mới','lại',
        'nơi','chỗ','nào','gì','sao','như','hơn','nhất','bị','theo','qua','lên','xuống',
        'me','my','i','a','an','the','is','are','was','were','be','been','have','has','had',
        'do','does','did','will','would','could','should','may','might','shall','can',
    ]);
    var currentRouteLine = null;
    var currentRouteAnimMarker = null;

    // ── Marker Cluster Group ──
    var markerClusterGroup = L.markerClusterGroup({
        showCoverageOnHover: false,
        zoomToBoundsOnClick: true,
        maxClusterRadius: 50,
        spiderfyOnMaxZoom: true,
        chunkedLoading: true
    });
    map.addLayer(markerClusterGroup);

    // ── Haversine distance (km) ──
    function calcDistance(lat1, lon1, lat2, lon2) {
        var R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLon = (lon2-lon1)*Math.PI/180;
        var a = Math.sin(dLat/2)*Math.sin(dLat/2) +
                Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*
                Math.sin(dLon/2)*Math.sin(dLon/2);
        return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
    }
    function formatDistance(km) {
        return km < 1 ? Math.round(km*1000)+' m' : km.toFixed(1)+' km';
    }

    // ── Price filter logic ──
    function extractPriceNums(str) {
        if (!str) return null;
        var cleanStr = str.replace(/\./g, '');
        var nums = cleanStr.match(/\d+/g);
        if (!nums || nums.length === 0) return null;
        var arr = nums.map(function(numStr) {
            var val = Number(numStr);
            if (str.toLowerCase().includes('k') && val < 1000) val = val * 1000;
            if ((str.toLowerCase().includes('triệu') || str.toLowerCase().includes('tr')) && val < 1000) val = val * 1000000;
            return val;
        });
        return { min: Math.min.apply(null, arr), max: Math.max.apply(null, arr) };
    }
    function matchPrice(r) {
        if (priceSliderMin <= 0 && priceSliderMax <= 0) return true;
        var p = extractPriceNums(r.priceRange);
        if (!p) return true;
        var hi = priceSliderMax > 0 ? priceSliderMax : Infinity;
        return p.min <= hi && p.max >= priceSliderMin;
    }

    // ── Ảnh minh hoạ theo loại địa điểm (cùng quy tắc với PlaceFallbackImage.cs) ──
    function placeFallback(r) {
        var type = r.isHotel ? 'hotel' : (r.isCafe ? 'cafe' : 'restaurant');
        return '/images/fallback/' + type + '-' + (r.id % 4 + 1) + '.jpg';
    }

    // ── Escape dữ liệu do người dùng nhập trước khi ghép vào HTML ──
    function escapeHtml(value) {
        if (value === null || value === undefined) return '';
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // ── Build popup HTML ──
    function buildPopup(r) {
        var desc  = r.description ? '<div class="popup-desc">'+escapeHtml(r.description)+'</div>' : '';
        var price = r.priceRange  ? '<div class="popup-price">💰 '+escapeHtml(r.priceRange)+'</div>' : '';
        var distHtml = '';
        if (userLatLng && r.latitude && r.longitude) {
            distHtml = '<div class="popup-dist">🚶 '+
                formatDistance(calcDistance(userLatLng.lat,userLatLng.lng,r.latitude,r.longitude))+
                ' từ bạn</div>';
        }
        var typeLabel;
        var typeStyle;
        if (r.isHotel) {
            typeLabel = '🏨 Khách sạn';
            typeStyle = 'color:#2563eb';
        } else if (r.isRestaurant) {
            typeLabel = '🍴 Nhà hàng';
            typeStyle = 'color:#ef4444';
        } else {
            typeLabel = '☕ Quán Cafe';
            typeStyle = 'color:#854d0e';
        }
        
        return '<div class="popup-card">'+
               '<div class="popup-type" style="font-size: 0.7rem; font-weight: 700; ' + typeStyle + '; margin-bottom: 2px;">' + typeLabel + '</div>'+
               '<div class="popup-name">'+escapeHtml(r.name)+'</div>'+
               '<div class="popup-addr">📍 '+(escapeHtml(r.address)||'Chưa có địa chỉ')+'</div>'+
               price+distHtml+desc+
               '<button class="btn-popup-more mt-2 w-100" onclick="window.triggerDetailView(' + allPlaces.indexOf(r) + ')">Xem chi tiết ở sidebar</button>'+
               '</div>';
    }

    // ── Build sidebar card HTML ──
    function buildCard(r, i) {
        var priceTag  = r.priceRange ? '<span class="card-price-tag">'+escapeHtml(r.priceRange)+'</span>' : '';
        var distBadge = '';
        if (userLatLng && r.latitude && r.longitude) {
            distBadge = '<span class="card-dist-badge">🚶 '+
                formatDistance(calcDistance(userLatLng.lat,userLatLng.lng,r.latitude,r.longitude))+
                '</span>';
        }
        
        var typeBadge = '';
        var badgeStyle = 'color:white;padding:3px 8px;border-radius:4px;font-size:0.65rem;font-weight:bold;margin-right:4px;white-space:nowrap;';
        if (r.isHotel)      typeBadge += '<span class="badge" style="background:linear-gradient(135deg,#2563eb,#1d4ed8);' + badgeStyle + '">🏨 Khách sạn</span>';
        if (r.isRestaurant) typeBadge += '<span class="badge" style="background:linear-gradient(135deg,#ef4444,#dc2626);' + badgeStyle + '">🍴 Nhà hàng</span>';
        if (r.isCafe)       typeBadge += '<span class="badge" style="background:linear-gradient(135deg,#854d0e,#a16207);' + badgeStyle + '">☕ Quán Cafe</span>';
        
        var fallbackImg = placeFallback(r);

        return '<div class="restaurant-item" id="item-'+i+'" data-idx="'+i+'">'+
               '<div class="restaurant-item-img">'+
               '    <img src="'+ escapeHtml(r.imageUrl || fallbackImg) +'" data-fallback="'+ fallbackImg +'" alt="place thumb" />'+
               '</div>'+
               '<div class="restaurant-item-info">'+
               '    <div class="restaurant-item-name">'+escapeHtml(r.name)+'</div>'+
               '    <div class="restaurant-item-meta">'+
               '        ' + typeBadge + priceTag + distBadge +
               '    </div>'+
               '    <div class="restaurant-item-addr">📍 '+(escapeHtml(r.address)||'—')+'</div>'+
               '</div></div>';
    }

    // ── Active marker highlight ──
    function setActive(idx) {
        if (activeIdx >= 0 && markers[activeIdx] && allPlaces[activeIdx]) {
            markers[activeIdx].setIcon(makeIcon(allPlaces[activeIdx], false));
            var old = document.getElementById('item-'+activeIdx);
            if (old) old.classList.remove('active');
        }
        activeIdx = idx;
        if (idx < 0) return;
        
        if (markers[idx] && allPlaces[idx]) {
            markers[idx].setIcon(makeIcon(allPlaces[idx], true));
        }
        
        var el = document.getElementById('item-'+idx);
        if (el) { 
            el.classList.add('active'); 
            el.scrollIntoView({behavior:'smooth',block:'nearest'}); 
        }
    }

    // ── Show Place Detail View inside Sidebar ──
    function showPlaceDetail(r, idx) {
        if (!r) return;
        
        // Tự động mở rộng (expand) sidebar nếu đang thu gọn (toggle off)
        var sidebar = document.querySelector('.map-sidebar');
        var mapLayout = document.querySelector('.map-layout');
        if (sidebar && sidebar.classList.contains('collapsed')) {
            sidebar.classList.remove('collapsed');
            if (mapLayout) {
                mapLayout.classList.remove('sidebar-collapsed');
            }
            
            // Cập nhật lại icon cho các nút toggle
            var btnMobile = document.getElementById('toggle-sidebar-btn-mobile');
            var btnDesktop = document.getElementById('toggle-sidebar-btn-desktop');
            // Mobile pill button uses CSS class-based arrow (no JS textContent needed)
            var labelMobile = btnMobile ? btnMobile.querySelector('.toggle-label') : null;
            if (labelMobile) labelMobile.textContent = 'Thu lại';
            var iconDesktop = btnDesktop ? btnDesktop.querySelector('.toggle-icon') : null;
            if (iconDesktop) iconDesktop.textContent = '◀';
            
            // Cập nhật kích thước bản đồ Leaflet sau khi giãn sidebar ra
            setTimeout(function() {
                if (typeof map !== 'undefined' && map) {
                    map.invalidateSize({ animate: true });
                }
            }, 300);
        }
        
        // Populate detail panel elements
        document.getElementById('detail-name').textContent = r.name;
        document.getElementById('detail-address').textContent = r.address || 'Chưa có địa chỉ';
        document.getElementById('detail-price').textContent = r.priceRange ? '💰 ' + r.priceRange : '💰 Tầm giá chưa cập nhật';
        
        var descLabel = document.getElementById('detail-desc-label');
        if (descLabel) {
            descLabel.textContent = r.isHotel ? 'Mô tả khách sạn' : (r.isRestaurant ? 'Mô tả quán ăn' : 'Mô tả quán cafe');
        }
        document.getElementById('detail-desc').textContent = r.description || (r.isHotel ? 'Chưa có mô tả chi tiết cho khách sạn này.' : (r.isRestaurant ? 'Chưa có mô tả chi tiết cho quán ăn này.' : 'Chưa có mô tả chi tiết cho quán cafe này.'));
        
        var phoneVal = r.phoneNumber || 'Không có';
        document.getElementById('detail-phone').textContent = phoneVal;
        var phoneItem = document.getElementById('detail-phone-item');
        if (r.phoneNumber) {
            phoneItem.style.display = 'flex';
            document.getElementById('btn-call').href = 'tel:' + r.phoneNumber;
            document.getElementById('btn-call').style.display = 'inline-flex';
        } else {
            phoneItem.style.display = 'none';
            document.getElementById('btn-call').style.display = 'none';
        }
        
        // Hotel Specific Meta
        var hotelMeta = document.getElementById('detail-hotel-meta');
        if (r.isHotel) {
            hotelMeta.style.display = 'flex';
            
            // Star rating
            var starsEl = document.getElementById('detail-stars');
            var starsStr = '';
            for (var s = 0; s < (r.starRating || 5); s++) {
                starsStr += '⭐';
            }
            starsEl.textContent = starsStr + ' (' + (r.starRating || 5) + ' sao)';
            
            // Amenities
            var amenitiesEl = document.getElementById('detail-amenities');
            amenitiesEl.innerHTML = '';
            if (r.amenities) {
                var list = r.amenities.split(',').map(function(s) { return s.trim(); });
                list.forEach(function(amen) {
                    if (!amen) return;
                    var icon = '✨';
                    var lower = amen.toLowerCase();
                    if (lower.includes('wifi')) icon = '📶';
                    else if (lower.includes('hồ bơi') || lower.includes('bể bơi')) icon = '🏊';
                    else if (lower.includes('bar') || lower.includes('quầy')) icon = '🍸';
                    else if (lower.includes('spa') || lower.includes('massage')) icon = '🧖';
                    else if (lower.includes('gym') || lower.includes('phòng tập')) icon = '🏋️';
                    else if (lower.includes('sáng') || lower.includes('buffet')) icon = '🍳';
                    else if (lower.includes('sông') || lower.includes('cận')) icon = '🌊';
                    
                    amenitiesEl.innerHTML += '<span class="amenity-tag" style="background: rgba(37, 99, 235, 0.08); color: #2563eb; border: 1px solid rgba(37, 99, 235, 0.15); border-radius: 4px; padding: 2px 8px; font-size: 0.72rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">' + icon + ' ' + escapeHtml(amen) + '</span>';
                });
            }
        } else {
            hotelMeta.style.display = 'none';
        }
        
        // Image
        var detailImg = document.getElementById('detail-img');
        var fallbackImg = placeFallback(r);
        delete detailImg.dataset.fallbackDone;
        detailImg.dataset.fallback = fallbackImg;
        detailImg.src = r.imageUrl || fallbackImg;

        // Distance badge
        var distBadge = document.getElementById('detail-distance');
        if (userLatLng && r.latitude && r.longitude) {
            var d = calcDistance(userLatLng.lat, userLatLng.lng, r.latitude, r.longitude);
            distBadge.textContent = '🚶 ' + formatDistance(d) + ' từ vị trí của bạn';
            distBadge.style.display = 'inline-block';
        } else {
            distBadge.style.display = 'none';
        }
        
        // Full details page button
        document.getElementById('btn-full-details').href = '/Place/Details/' + r.id;
        
        // Copy address button
        var copyBtn = document.getElementById('btn-copy-address');
        copyBtn.onclick = function(e) {
            e.stopPropagation();
            navigator.clipboard.writeText(r.address || '').then(function() {
                showToast('📋 Đã sao chép địa chỉ địa điểm!', 'success');
            }).catch(function() {
                showToast('Không thể sao chép địa chỉ.', 'error');
            });
        };
        
        // Directions Button Click Handler
        var directionsBtn = document.getElementById('btn-directions');
        directionsBtn.onclick = function() {
            if (!userLatLng) {
                showToast('📍 Vui lòng bật định vị vị trí hiện tại để vẽ đường!', 'warning');
                locateUser();
                return;
            }
            drawRouteTo(r);
        };
        
        // Transition views
        document.getElementById('sidebar-list-view').classList.remove('active');
        setTimeout(function() {
            document.getElementById('sidebar-list-view').style.display = 'none';
            
            var detailView = document.getElementById('sidebar-detail-view');
            detailView.style.display = 'flex';
            setTimeout(function() {
                detailView.classList.add('active');
            }, 50);
        }, 150);
        
        // Highlight marker
        setActive(idx);
        var m = markers[idx];
        if (m) {
            map.flyTo(m.getLatLng(), 16, {
                animate: true,
                duration: 1.2,
                easeLinearity: 0.25
            });
            setTimeout(function() {
                m.openPopup();
            }, 600);
        }
    }
    
    // Global bridge for popups to trigger detail view
    window.triggerDetailView = function(idx) {
        var r = allPlaces[idx];
        showPlaceDetail(r, idx);
    };

    // ── Back to list handler ──
    document.getElementById('btn-back-to-list').addEventListener('click', function() {
        if (currentRouteLine) {
            map.removeLayer(currentRouteLine);
            currentRouteLine = null;
        }
        if (currentRouteAnimMarker) {
            map.removeLayer(currentRouteAnimMarker);
            currentRouteAnimMarker = null;
        }
        
        var detailView = document.getElementById('sidebar-detail-view');
        detailView.classList.remove('active');
        
        setTimeout(function() {
            detailView.style.display = 'none';
            
            var listView = document.getElementById('sidebar-list-view');
            listView.style.display = 'flex';
            setTimeout(function() {
                listView.classList.add('active');
            }, 50);
        }, 150);
        
        setActive(-1);
    });

    // ── Helper to start/stop Leaflet marker bounce animation ──
    function startMarkerBounce(idx) {
        if (markers[idx]) {
            var el = markers[idx].getElement();
            if (el) {
                var container = el.querySelector('.g-marker-container');
                if (container) container.classList.add('marker-bounce-active');
            }
        }
    }
    function stopMarkerBounce(idx) {
        if (markers[idx]) {
            var el = markers[idx].getElement();
            if (el) {
                var container = el.querySelector('.g-marker-container');
                if (container) container.classList.remove('marker-bounce-active');
            }
        }
    }

    // ── Render sidebar list ──
    function render(list) {
        var listEl = document.getElementById('restaurant-list');
        listEl.innerHTML = '';
        if (list.length === 0) {
            listEl.innerHTML = '<div class="empty-state"><div class="empty-state-icon">🔍</div>'+
                '<div class="empty-state-title">Không tìm thấy địa điểm nào</div>'+
                '<div class="empty-state-desc">Thử thay đổi bộ lọc hoặc từ khoá khác</div></div>';
            document.getElementById('count-text').textContent = '0 địa điểm';
            document.getElementById('count-badge').textContent = '0';
            return;
        }

        var RENDER_CAP = 80;
        var toRender = list.length > RENDER_CAP ? list.slice(0, RENDER_CAP) : list;
        var html = '';
        toRender.forEach(function(r) { html += buildCard(r, r._idx); });
        if (list.length > RENDER_CAP) {
            html += '<div style="text-align:center;color:#64748b;font-size:0.78rem;padding:10px 8px;">Hiển thị '+RENDER_CAP+' / '+list.length+' kết quả — dùng bộ lọc để thu hẹp</div>';
        }
        listEl.innerHTML = html;

        document.getElementById('count-text').textContent = list.length + ' địa điểm';
        document.getElementById('count-badge').textContent = list.length;
        
        listEl.querySelectorAll('.restaurant-item').forEach(function(el) {
            el.addEventListener('click', function() {
                var idx = parseInt(this.dataset.idx);
                var r = allPlaces[idx];
                showPlaceDetail(r, idx);
            });
            el.addEventListener('mouseenter', function() {
                var idx = parseInt(this.dataset.idx);
                startMarkerBounce(idx);
            });
            el.addEventListener('mouseleave', function() {
                var idx = parseInt(this.dataset.idx);
                stopMarkerBounce(idx);
            });
        });
    }

    // ── UNIFIED FILTER + SORT PIPELINE ──
    // ── Description search scoring ──
    function scorePlace(r, terms) {
        if (!terms || terms.length === 0) return 1;
        var corpus = [
            r.name        || '',
            r.address     || '',
            r.description || ''
        ].join(' ').toLowerCase();
        var score = 0;
        for (var i = 0; i < terms.length; i++) {
            if (corpus.includes(terms[i])) score++;
        }
        return score;
    }

    function applyFilters() {
        var q = (document.getElementById('search-input').value || '').trim().toLowerCase();
        
        // Show/hide clear search button
        var clearBtn = document.getElementById('clear-search');
        if (q.length > 0) {
            clearBtn.style.display = 'block';
        } else {
            clearBtn.style.display = 'none';
        }

        // 1. Filter: category + text + price + description score
        var scored = [];
        allPlaces.forEach(function(r, i) {
            var catOk = activeCategoryFilters.size === 0 ||
                        (activeCategoryFilters.has('restaurant') ? r.isRestaurant : true) &&
                        (activeCategoryFilters.has('cafe')       ? r.isCafe       : true) &&
                        (activeCategoryFilters.has('hotel')      ? r.isHotel      : true);

            var textOk = !q ||
                (r.name    && r.name.toLowerCase().includes(q)) ||
                (r.address && r.address.toLowerCase().includes(q));

            var priceOk = matchPrice(r);

            var descScore = descTerms.length > 0 ? scorePlace(r, descTerms) : 1;
            var descOk = descTerms.length === 0 || descScore > 0;

            var pass = catOk && textOk && priceOk && descOk;
            if (markers[i]) {
                if (pass) {
                    if (!markerClusterGroup.hasLayer(markers[i])) markerClusterGroup.addLayer(markers[i]);
                } else {
                    if (markerClusterGroup.hasLayer(markers[i])) markerClusterGroup.removeLayer(markers[i]);
                }
            }
            if (pass) scored.push({ r: r, score: descScore });
        });

        // 2. Sort: desc search → by relevance score; location known → by distance; else default
        var filtered;
        if (descTerms.length > 0) {
            scored.sort(function(a, b) { return b.score - a.score; });
            filtered = scored.map(function(x) { return x.r; });
        } else if (userLatLng) {
            filtered = scored.map(function(x) { return x.r; }).sort(function(a, b) {
                var da = (a.latitude && a.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, a.latitude, a.longitude) : 9999;
                var db = (b.latitude && b.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, b.latitude, b.longitude) : 9999;
                return da - db;
            });
        } else {
            filtered = scored.map(function(x) { return x.r; });
        }

        // 3. Update hint
        var hint = document.getElementById('desc-search-hint');
        if (descTerms.length > 0) {
            hint.style.display = '';
            hint.innerHTML = 'Tìm thấy <b>' + filtered.length + '</b> địa điểm khớp — sắp xếp theo độ phù hợp';
        } else {
            hint.style.display = 'none';
        }

        render(filtered);
    }

    // ── Build map markers (bulk add to cluster group) ──
    var markersToAdd = [];
    allPlaces.forEach(function(r, i) {
        if (!r.latitude || !r.longitude) return;
        var m = L.marker([r.latitude, r.longitude], {icon: makeIcon(r, false)});

        m.on('click', function() {
            if (!m.getPopup()) m.bindPopup(buildPopup(r), {maxWidth: 240});
            showPlaceDetail(r, i);
        });

        m.on('popupclose', function() {
            var detailView = document.getElementById('sidebar-detail-view');
            if (detailView.style.display === 'none' && activeIdx === i) setActive(-1);
        });
        markers[i] = m;
        markersToAdd.push(m);
    });
    markerClusterGroup.addLayers(markersToAdd);

    applyFilters();

    // ── Search input ──
    document.getElementById('search-input').addEventListener('input', applyFilters);
    
    // Clear search event
    document.getElementById('clear-search').addEventListener('click', function() {
        document.getElementById('search-input').value = '';
        applyFilters();
        document.getElementById('search-input').focus();
    });

    // ── Category chip buttons (multi-select) ──
    document.getElementById('category-chips').addEventListener('click', function(e) {
        var chip = e.target.closest('.price-chip');
        if (!chip) return;
        var cat = chip.dataset.category;
        if (cat === 'all') {
            activeCategoryFilters.clear();
        } else {
            if (activeCategoryFilters.has(cat)) {
                activeCategoryFilters.delete(cat);
            } else {
                activeCategoryFilters.add(cat);
            }
        }
        // sync active class
        document.querySelectorAll('#category-chips .price-chip').forEach(function(c) {
            var k = c.dataset.category;
            if (k === 'all') {
                c.classList.toggle('active', activeCategoryFilters.size === 0);
            } else {
                c.classList.toggle('active', activeCategoryFilters.has(k));
            }
        });
        applyFilters();
    });

    // ── Price input handlers ──
    var priceMinEl  = document.getElementById('price-min-input');
    var priceMaxEl  = document.getElementById('price-max-input');
    var priceResetEl = document.getElementById('price-input-reset');
    var priceDebounce = null;
    function onPriceInput() {
        clearTimeout(priceDebounce);
        priceDebounce = setTimeout(function() {
            priceSliderMin = (parseInt(priceMinEl.value, 10) || 0) * 1000;
            priceSliderMax = (parseInt(priceMaxEl.value, 10) || 0) * 1000;
            priceResetEl.style.display = (priceSliderMin > 0 || priceSliderMax > 0) ? '' : 'none';
            applyFilters();
        }, 350);
    }
    priceMinEl.addEventListener('input', onPriceInput);
    priceMaxEl.addEventListener('input', onPriceInput);
    priceResetEl.addEventListener('click', function() {
        priceMinEl.value = '';
        priceMaxEl.value = '';
        priceSliderMin = 0;
        priceSliderMax = 0;
        priceResetEl.style.display = 'none';
        applyFilters();
    });

    // ── Description search input ──
    var descInput = document.getElementById('desc-search-input');
    var descClear = document.getElementById('desc-search-clear');
    var descDebounce = null;
    descInput.addEventListener('input', function() {
        clearTimeout(descDebounce);
        descDebounce = setTimeout(function() {
            var raw = descInput.value.trim().toLowerCase();
            descTerms = raw ? raw.split(/\s+/).filter(function(t) {
                return t.length >= 2 && !STOP_WORDS.has(t);
            }) : [];
            descClear.style.display = descTerms.length > 0 ? '' : 'none';
            applyFilters();
        }, 300);
    });
    descClear.addEventListener('click', function() {
        descInput.value = '';
        descTerms = [];
        descClear.style.display = 'none';
        document.getElementById('desc-search-hint').style.display = 'none';
        applyFilters();
    });

    // ── User location marker icon ──
    var userLocationIcon = L.divIcon({
        className: '',
        html: '<div class="user-location-marker"><div class="user-location-pulse"></div><div class="user-location-dot"></div></div>',
        iconSize: [24,24], iconAnchor: [12,12], popupAnchor: [0,-16]
    });

    function locateUser() {
        if (!navigator.geolocation) { showToast('Trình duyệt không hỗ trợ định vị GPS.','error'); return; }
        var btnSidebar = document.getElementById('btn-my-location');
        var btnMap     = document.getElementById('btn-locate-map');
        var txtEl      = document.getElementById('btn-location-text');
        
        txtEl.textContent = 'Định vị...';
        btnSidebar.classList.add('loading');
        btnMap.classList.add('loading');

        navigator.geolocation.getCurrentPosition(
            function(pos) {
                var lat = pos.coords.latitude, lng = pos.coords.longitude, acc = pos.coords.accuracy;
                userLatLng = {lat: lat, lng: lng};

                if (userMarker)         map.removeLayer(userMarker);
                if (userAccuracyCircle) map.removeLayer(userAccuracyCircle);

                userAccuracyCircle = L.circle([lat, lng], {
                    radius: acc, color:'#3b82f6', fillColor:'#3b82f6',
                    fillOpacity:.1, weight:1.5, dashArray:'4 4'
                }).addTo(map);

                userMarker = L.marker([lat, lng], {icon: userLocationIcon, zIndexOffset: 1000})
                    .addTo(map)
                    .bindPopup('<div class="popup-card">'+
                        '<div class="popup-name" style="color:#3b82f6">📡 Vị trí của bạn</div>'+
                        '<div class="popup-addr">Độ chính xác: ~'+Math.round(acc)+' m</div>'+
                        '</div>');

                map.setView([lat, lng], 15, {animate: true});

                txtEl.textContent = 'Vị trí của tôi ✓';
                btnSidebar.classList.remove('loading'); btnSidebar.classList.add('located');
                btnMap.classList.remove('loading');     btnMap.classList.add('located');

                document.getElementById('user-location-bar').style.display = 'inline';
                document.getElementById('user-location-coords').textContent =
                    lat.toFixed(5)+', '+lng.toFixed(5);

                document.getElementById('nearby-badge').style.display = 'inline-flex';

                applyFilters();
                renderDealsCarousel();         // Re-render floating carousel
                renderDealsBannerSection();     // Re-render section bên dưới với sort theo khoảng cách
                
                allPlaces.forEach(function(r, i) {
                    if (markers[i] && markers[i].getPopup()) markers[i].setPopupContent(buildPopup(r));
                });

                showToast('🎯 Đã định vị thành công! Đang ưu tiên địa điểm gần bạn.', 'success');
            },
            function(err) {
                txtEl.textContent = 'Vị trí của tôi';
                btnSidebar.classList.remove('loading'); btnMap.classList.remove('loading');
                var msg = 'Không thể lấy vị trí.';
                if (err.code === 1) msg = 'Bạn đã từ chối quyền truy cập vị trí.';
                else if (err.code === 2) msg = 'Không xác định được vị trí. Kiểm tra GPS.';
                else if (err.code === 3) msg = 'Hết thời gian lấy vị trí. Thử lại nhé.';
                showToast(msg, 'error');
            },
            {enableHighAccuracy: true, timeout: 10000, maximumAge: 60000}
        );
    }

    // ── Button listeners ──
    document.getElementById('btn-my-location').addEventListener('click', locateUser);
    document.getElementById('btn-locate-map').addEventListener('click', locateUser);

    // ── Real Routing using Free Open Source Routing Machine (OSRM) ──
    function drawRouteTo(place) {
        if (!userLatLng) return;
        
        if (currentRouteLine) {
            map.removeLayer(currentRouteLine);
            currentRouteLine = null;
        }
        if (currentRouteAnimMarker) {
            map.removeLayer(currentRouteAnimMarker);
            currentRouteAnimMarker = null;
        }
        
        var startLat = userLatLng.lat;
        var startLng = userLatLng.lng;
        var endLat = place.latitude;
        var endLng = place.longitude;
        
        showToast('🧭 Đang tính toán tuyến đường đi bộ tốt nhất...', 'info');
        
        var url = 'https://router.project-osrm.org/route/v1/foot/' + startLng + ',' + startLat + ';' + endLng + ',' + endLat + '?overview=full&geometries=geojson';
        
        fetch(url)
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.code === 'Ok' && data.routes && data.routes.length > 0) {
                    var route = data.routes[0];
                    var geojson = route.geometry;
                    
                    var shadowLine = L.geoJSON(geojson, {
                        style: {
                            color: '#1d4ed8',
                            weight: 9,
                            opacity: 0.4,
                            lineCap: 'round',
                            lineJoin: 'round'
                        }
                    });
                    
                    var pathLine = L.geoJSON(geojson, {
                        style: {
                            color: '#3b82f6',
                            weight: 6,
                            opacity: 0.95,
                            lineCap: 'round',
                            lineJoin: 'round',
                            className: 'route-animated'
                        }
                    });
                    
                    currentRouteLine = L.featureGroup([shadowLine, pathLine]).addTo(map);
                    map.fitBounds(currentRouteLine.getBounds(), { padding: [50, 50], animate: true });
                    
                    var dist = route.distance / 1000;
                    var time = route.duration / 60;
                    
                    showToast('🚶 Đường đi bộ: ' + dist.toFixed(2) + ' km (Khoảng ' + Math.round(time) + ' phút)', 'success');
                    animateRouteMarker(geojson.coordinates);
                } else {
                    drawDirectLineFallback(startLat, startLng, endLat, endLng);
                }
            })
            .catch(function(err) {
                console.warn("OSRM error, falling back to direct line:", err);
                drawDirectLineFallback(startLat, startLng, endLat, endLng);
            });
    }
    
    function animateRouteMarker(coordinates) {
        if (!coordinates || coordinates.length === 0) return;
        var latlngs = coordinates.map(function(c) { return L.latLng(c[1], c[0]); });
        
        var animDotIcon = L.divIcon({
            className: '',
            html: '<div class="route-anim-dot"></div>',
            iconSize: [12, 12], iconAnchor: [6, 6]
        });
        
        currentRouteAnimMarker = L.marker(latlngs[0], {icon: animDotIcon}).addTo(map);
        
        var step = 0;
        var totalSteps = latlngs.length;
        
        function moveDot() {
            if (!currentRouteAnimMarker || !map.hasLayer(currentRouteAnimMarker)) return;
            currentRouteAnimMarker.setLatLng(latlngs[step]);
            step = (step + 1) % totalSteps;
            setTimeout(moveDot, 350);
        }
        
        moveDot();
    }
    
    function drawDirectLineFallback(startLat, startLng, endLat, endLng) {
        currentRouteLine = L.polyline([[startLat, startLng], [endLat, endLng]], {
            color: '#3b82f6',
            weight: 5,
            opacity: 0.9,
            className: 'route-animated'
        }).addTo(map);
        
        map.fitBounds(currentRouteLine.getBounds(), { padding: [50, 50] });
        var d = calcDistance(startLat, startLng, endLat, endLng);
        showToast('📍 Đã nối đường thẳng chim bay: ' + formatDistance(d), 'success');
    }

    // ── Dynamic Floating Carousel (trên bản đồ) ──
    function renderDealsCarousel() {
        var container = document.getElementById('dynamic-carousel-container');
        if (!container) return;

        var bannerPlaces = allPlaces.filter(function(r) { return r.bannerUrl && r.bannerStatus === 2; });
        if (bannerPlaces.length === 0) {
            container.innerHTML = '';
            return;
        }

        if (userLatLng) {
            bannerPlaces = bannerPlaces.slice().sort(function(a, b) {
                var da = (a.latitude && a.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, a.latitude, a.longitude) : 9999;
                var db = (b.latitude && b.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, b.latitude, b.longitude) : 9999;
                return da - db;
            });
        } else {
            bannerPlaces = bannerPlaces.slice().sort(function(a, b) { return b.id - a.id; });
        }
        bannerPlaces = bannerPlaces.slice(0, 5);

        var slideCount = bannerPlaces.length;
        var currentSlide = 0;
        var autoplayTimer = null;

        function buildSlides(activeIdx) {
            return bannerPlaces.map(function(r, i) {
                var distBadge = '';
                if (userLatLng && r.latitude && r.longitude) {
                    var d = calcDistance(userLatLng.lat, userLatLng.lng, r.latitude, r.longitude);
                    distBadge = '<span class="fc-dist-badge">📍 '+formatDistance(d)+'</span>';
                }
                var label = r.isHotel ? '🏨 Khách sạn' : (r.isRestaurant ? '🍴 Nhà hàng' : '☕ Quán Cafe');
                return '<div class="fc-slide'+(i === activeIdx ? ' active' : '')+'" data-index="'+i+'" onclick="window.triggerDetailView('+allPlaces.indexOf(r)+')">'+
                    '<img src="'+escapeHtml(r.bannerUrl)+'" alt="'+escapeHtml(r.name)+'" class="fc-img" />'+
                    '<div class="fc-caption">'+
                        '<div class="fc-caption-name">'+escapeHtml(r.name)+' ('+label+')'+distBadge+'</div>'+
                    '</div>'+
                '</div>';
            }).join('');
        }

        function buildDots(activeIdx) {
            if (slideCount <= 1) return '';
            var d = '';
            for (var i = 0; i < slideCount; i++) {
                d += '<button class="fc-dot'+(i === activeIdx ? ' active' : '')+'" data-dot="'+i+'"></button>';
            }
            return '<div class="fc-dots">'+d+'</div>';
        }

        function goTo(idx) {
            currentSlide = (idx + slideCount) % slideCount;
            document.getElementById('fc-slides-wrap').innerHTML = buildSlides(currentSlide);
            var dotsWrap = document.getElementById('fc-dots-wrap');
            if (dotsWrap) dotsWrap.innerHTML = buildDots(currentSlide);
            bindDots();
        }

        function bindDots() {
            var dotsWrap = document.getElementById('fc-dots-wrap');
            if (!dotsWrap) return;
            dotsWrap.querySelectorAll('.fc-dot').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    clearInterval(autoplayTimer);
                    goTo(parseInt(this.dataset.dot));
                    startAutoplay();
                });
            });
        }

        function startAutoplay() {
            clearInterval(autoplayTimer);
            autoplayTimer = setInterval(function() { goTo(currentSlide + 1); }, 4500);
        }

        var nearbyLabel = userLatLng ? '<span class="fc-nearby-label">📍 Gần bạn</span>' : '';

        var html = '<div class="fc-wrapper" id="fc-wrapper" style="pointer-events:all;">'+
            '<div class="fc-header">'+
                '<span class="fc-title">✨ Địa điểm gợi ý cho bạn</span>'+
                nearbyLabel+
                '<button class="fc-close" id="fc-close" title="Đóng">✕</button>'+
            '</div>'+
            '<div class="fc-body">'+
                '<div class="fc-slides" id="fc-slides-wrap">'+buildSlides(0)+'</div>'+
                (slideCount > 1 ?
                    '<button class="fc-nav fc-prev" id="fc-prev">&#8249;</button>'+
                    '<button class="fc-nav fc-next" id="fc-next">&#8250;</button>' : '')+
            '</div>'+
            '<div id="fc-dots-wrap">'+buildDots(0)+'</div>'+
        '</div>';

        container.innerHTML = html;

        var closeBtn = document.getElementById('fc-close');
        if (closeBtn) closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            document.getElementById('fc-wrapper').style.display = 'none';
            clearInterval(autoplayTimer);
        });

        var prevBtn = document.getElementById('fc-prev');
        var nextBtn = document.getElementById('fc-next');
        if (prevBtn) prevBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            clearInterval(autoplayTimer);
            goTo(currentSlide - 1);
            startAutoplay();
        });
        if (nextBtn) nextBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            clearInterval(autoplayTimer);
            goTo(currentSlide + 1);
            startAutoplay();
        });

        bindDots();
        if (slideCount > 1) startAutoplay();
    }

    // ── "Ưu đãi siêu hời" Section (below map) ──
    function renderDealsBannerSection() {
        var track   = document.getElementById('deals-scroll-track');
        var section = document.getElementById('deals-section');
        var nearbyHint  = document.getElementById('deals-nearby-hint');
        var countLabel  = document.getElementById('deals-count-label');
        if (!track) return;

        var bannerPlaces = allPlaces.filter(function(r) { return r.bannerUrl && r.bannerStatus === 2; });
        if (bannerPlaces.length === 0) {
            if (section) section.style.display = 'none';
            return;
        }

        var hasGps = !!userLatLng;
        if (hasGps) {
            bannerPlaces = bannerPlaces.slice().sort(function(a, b) {
                var da = (a.latitude && a.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, a.latitude, a.longitude) : 9999;
                var db = (b.latitude && b.longitude) ? calcDistance(userLatLng.lat, userLatLng.lng, b.latitude, b.longitude) : 9999;
                return da - db;
            });
        } else {
            bannerPlaces = bannerPlaces.slice().sort(function(a, b) { return b.id - a.id; });
        }
        bannerPlaces = bannerPlaces.slice(0, 8);

        if (section) section.style.display = 'block';
        if (nearbyHint) nearbyHint.style.display = hasGps ? 'inline-flex' : 'none';
        if (countLabel) countLabel.textContent = bannerPlaces.length + ' địa điểm';

        var html = '';
        bannerPlaces.forEach(function(r) {
            var distHtml = '';
            if (hasGps && r.latitude && r.longitude) {
                var d = calcDistance(userLatLng.lat, userLatLng.lng, r.latitude, r.longitude);
                distHtml = '<div class="deal-banner-dist">📍 '+formatDistance(d)+'</div>';
            }
            html += '<a class="deal-banner-card" href="/Place/Details/'+r.id+'">'+
                        '<div class="deal-banner-img-wrap">'+
                            '<img src="'+escapeHtml(r.bannerUrl)+'" alt="'+escapeHtml(r.name)+'" />'+
                            '<div class="deal-banner-overlay"></div>'+
                        '</div>'+
                        '<div class="deal-banner-info">'+
                            '<div class="deal-banner-name">'+escapeHtml(r.name)+'</div>'+
                            distHtml+
                        '</div>'+
                    '</a>';
        });

        track.querySelectorAll('.deal-banner-card').forEach(function(el) { el.remove(); });
        track.insertAdjacentHTML('afterbegin', html);
    }

    // ── Xử lý Thu nhỏ/Mở rộng Sidebar (Ngang trên PC/Dọc trên Mobile) ──
    function initMobileSidebarToggle() {
        var btnMobile = document.getElementById('toggle-sidebar-btn-mobile');
        var btnDesktop = document.getElementById('toggle-sidebar-btn-desktop');
        var sidebar = document.querySelector('.map-sidebar');
        var mapLayout = document.querySelector('.map-layout');
        
        if (sidebar && mapLayout) {
            function handleToggle(e) {
                if (e) e.stopPropagation();
                var isCollapsed = sidebar.classList.toggle('collapsed');
                mapLayout.classList.toggle('sidebar-collapsed', isCollapsed);
                
                var isMobileNow = window.innerWidth <= 768;
                
                // Desktop button uses text arrow icon
                var iconDesktop = btnDesktop ? btnDesktop.querySelector('.toggle-icon') : null;
                // Mobile pill button: update label text; arrow direction is via CSS
                var labelMobile = btnMobile ? btnMobile.querySelector('.toggle-label') : null;
                
                if (isCollapsed) {
                    if (iconDesktop) iconDesktop.textContent = '▶';
                    if (labelMobile) labelMobile.textContent = 'Danh sách';
                    if (typeof showToast === 'function') {
                        showToast(isMobileNow ? 'Đã thu nhỏ. Nhấn nút bên dưới để mở lại!' : 'Đã thu gọn thanh tìm kiếm sang trái!', 'info');
                    }
                } else {
                    if (iconDesktop) iconDesktop.textContent = '◀';
                    if (labelMobile) labelMobile.textContent = 'Thu lại';
                }
                
                // Cập nhật lại kích thước bản đồ Leaflet sau khi co giãn
                setTimeout(function() {
                    if (typeof map !== 'undefined' && map) {
                        map.invalidateSize({ animate: true });
                    }
                }, 300);
            }
            
            if (btnMobile) btnMobile.addEventListener('click', handleToggle);
            if (btnDesktop) btnDesktop.addEventListener('click', handleToggle);
            
            // Đồng bộ hoá icon ban đầu
            var isCollapsedInit = sidebar.classList.contains('collapsed');
            var iconDesktop = btnDesktop ? btnDesktop.querySelector('.toggle-icon') : null;
            var labelMobile = btnMobile ? btnMobile.querySelector('.toggle-label') : null;
            if (isCollapsedInit) {
                if (iconDesktop) iconDesktop.textContent = '▶';
                if (labelMobile) labelMobile.textContent = 'Danh sách';
            } else {
                if (iconDesktop) iconDesktop.textContent = '◀';
                if (labelMobile) labelMobile.textContent = 'Thu lại';
            }
        }
    }

    // Call initially
    initMobileSidebarToggle();
    renderDealsCarousel();
    renderDealsBannerSection();

    setTimeout(function() {
        if (typeof showToast === 'function' && allPlaces.length > 0)
            showToast('Tìm thấy ' + allPlaces.length + ' địa điểm ẩm thực & lưu trú trên bản đồ!', 'success');
    }, 600);

})();
</script>
}