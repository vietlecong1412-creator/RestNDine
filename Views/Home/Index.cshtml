            for (var s = 0; s < (r.starRating || 5); s++) {
                starsStr += '⭐';
            }
            starsEl.textContent = starsStr + ' (' + (r.starRating || 5) + ' sao)';
            
            // Amenities
            var amenitiesEl = document.getElementById('detail-amenities');
            amenitiesEl.innerHTML = '';
            if (r.amenities) {
                var list = r.amenities.split(',').map(function(s) { return s.trim(); });
                list.forEach(function(amen) {
                    if (!amen) return;
