@model IEnumerable<DACS.Models.Place>
@{
    ViewData["Title"] = "Địa điểm của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Bảng cuộn nội tại – thanh trượt ngang luôn hiển thị */
    .table-responsive {
        overflow: auto;
        max-height: calc(100vh - 220px);
        border-radius: 0 0 var(--radius, 12px) var(--radius, 12px);
    }
    .table-responsive thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--surface-light, #1e293b);
        box-shadow: 0 1px 0 rgba(255,255,255,0.08);
    }
</style>

<div class="admin-container animate-in">
    <div class="section-header">
        <h1 class="section-title">
            <span class="icon">📋</span> Địa điểm của tôi
        </h1>
        <a asp-action="Create" asp-controller="Place" class="btn-primary-custom">
            ➕ Thêm địa điểm mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-glass success mb-4">✅ @TempData["Success"]</div>
    }

    <div class="card-glass p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center">
                <div style="font-size:3rem;margin-bottom:1rem;">📍</div>
                <h4 style="color:var(--text-primary)">Bạn chưa đăng ký địa điểm nào</h4>
                <p style="color:var(--text-secondary)">Hãy thêm địa điểm đầu tiên để chia sẻ với cộng đồng.</p>
                <a asp-action="Create" asp-controller="Place" class="btn-primary-custom mt-2">Bắt đầu thêm</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Tên địa điểm</th>
                            <th>Loại</th>
                            <th>Địa chỉ</th>
                            <th>Banner</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold" style="color:var(--text-primary)">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" style="width:40px;height:40px;border-radius:8px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div style="width:40px;height:40px;border-radius:8px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:1.2rem;">@(item.Categories.FirstOrDefault()?.Icon ?? "📍")</div>
                                        }
                                        @item.Name
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="background:rgba(255,255,255,.08);color:var(--text-secondary);border:1px solid var(--border);">
                                        @string.Join(" · ", item.Categories.Select(c => c.Icon + " " + c.Name))
                                    </span>
                                </td>
                                <td><span class="text-truncate d-inline-block" style="max-width:200px;" title="@item.Address">@item.Address</span></td>
                                <td>
                                    @switch (item.BannerStatus)
                                    {
                                        case DACS.Models.BannerStatus.Active:
                                            <span class="badge" style="background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.3);">✅ Đang chạy</span>
                                            break;
                                        case DACS.Models.BannerStatus.PendingPayment:
                                            <span class="badge" style="background:rgba(251,191,36,.15);color:#fbbf24;border:1px solid rgba(251,191,36,.3);">🕒 Chờ duyệt</span>
                                            break;
                                        case DACS.Models.BannerStatus.Rejected:
                                            <span class="badge" style="background:rgba(239,68,68,.15);color:#ef4444;border:1px solid rgba(239,68,68,.3);">❌ Bị từ chối</span>
                                            break;
                                        default:
                                            <span class="badge" style="background:rgba(255,255,255,.05);color:var(--text-muted);border:1px solid var(--border);">Không có</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.IsApproved)
                                    {
                                        <span class="badge" style="background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.3);">Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:rgba(245,158,11,.15);color:#fcd34d;border:1px solid rgba(245,158,11,.3);">Chờ duyệt</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Xem chi tiết">👁️</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon text-primary" title="Sửa">✏️</a>
                                        <button onclick="confirmDeletePlace(@item.Id, '@item.Name.Replace("'", "\\'")' )" class="btn-icon text-danger" title="Xóa" style="border:none;background:none;cursor:pointer;">🗑️</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Modal Xóa địa điểm *@
<div id="deleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <div class="modal-title">⚠️ Xác nhận xóa</div>
        <div class="modal-desc">Bạn có chắc chắn muốn xóa địa điểm "<b id="delPlaceName"></b>" không?<br /><span style="color:#ef4444;font-size:.85rem;">Hành động này không thể hoàn tác và sẽ xóa toàn bộ ảnh, bình luận liên quan.</span></div>
        <div class="modal-actions">
            <button onclick="closeDeletePlace()" class="btn-outline-custom">Hủy</button>
            <form id="delPlaceForm" method="post" asp-action="Delete" asp-controller="Place">
                <input type="hidden" name="id" id="delPlaceId" />
                <button type="submit" class="btn-primary-custom" style="background:#ef4444;">🗑 Xóa địa điểm</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmDeletePlace(id, name) {
    document.getElementById('delPlaceId').value = id;
    document.getElementById('delPlaceName').textContent = name;
    document.getElementById('deleteModal').style.display = 'flex';
}
function closeDeletePlace() {
    document.getElementById('deleteModal').style.display = 'none';
}
</script>
}
