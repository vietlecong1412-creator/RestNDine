@model DACS.Models.Place
@{
    ViewData["Title"] = "Cập nhật địa điểm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isHotel = Model.Category?.Slug == "hotel";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="admin-container animate-in">
    <div class="section-header">
        <h1 class="section-title">
            <span class="icon">✏️</span> Sửa thông tin địa điểm
        </h1>
        <a asp-action="MyPlaces" class="btn-outline-custom">⬅️ Quay lại danh sách</a>
    </div>

    <div class="card-glass p-0">
        <div class="row g-0">
            @* ── Left Form ── *@
            <div class="col-md-6 border-end" style="border-color:var(--border)!important">
                <form asp-action="Edit" enctype="multipart/form-data" class="p-4 p-md-5">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label-custom">Tên địa điểm *</label>
                        <input asp-for="Name" class="form-control-custom" placeholder="Nhập tên địa điểm..." />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label-custom">Loại hình địa điểm *</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control-custom" id="categorySelect">
                            <option value="">-- Chọn loại --</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label-custom">Số điện thoại liên hệ</label>
                        <input asp-for="PhoneNumber" class="form-control-custom" placeholder="VD: 0901234567..." />
                    </div>

                    <div class="mb-4">
                        <label asp-for="PriceRange" class="form-label-custom">Tầm giá</label>
                        <input asp-for="PriceRange" class="form-control-custom" placeholder="VD: 50k - 200k" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label-custom">Địa chỉ chi tiết</label>
                        <input asp-for="Address" class="form-control-custom" placeholder="Ví dụ: 123 Lê Lợi..." />
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <label asp-for="Latitude" class="form-label-custom">Vĩ độ (Lat)</label>
                            <input asp-for="Latitude" id="lat" class="form-control-custom" readonly />
                        </div>
                        <div class="col-6">
                            <label asp-for="Longitude" class="form-label-custom">Kinh độ (Lng)</label>
                            <input asp-for="Longitude" id="lng" class="form-control-custom" readonly />
                        </div>
                    </div>

                    @* Hotel-specific fields *@
                    <div id="hotelFields" style="display:@(isHotel ? "block" : "none");">
                        <div class="mb-4 p-3" style="background:rgba(59,130,246,.05);border:1px dashed rgba(59,130,246,.3);border-radius:12px;">
                            <div class="mb-3">
                                <label asp-for="StarRating" class="form-label-custom">🌟 Số sao khách sạn (1-5)</label>
                                <select asp-for="StarRating" class="form-control-custom">
                                    <option value="">-- Chọn hạng sao --</option>
                                    @for (int i = 1; i <= 5; i++) { <option value="@i">@i ⭐</option> }
                                </select>
                            </div>
                            <div class="mb-0">
                                <label asp-for="Amenities" class="form-label-custom">🏨 Tiện ích</label>
                                <textarea asp-for="Amenities" class="form-control-custom" rows="2"
                                          placeholder="VD: Free Wifi, Hồ bơi, Máy lạnh, Buffet..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label-custom">Mô tả thêm</label>
                        <textarea asp-for="Description" class="form-control-custom" rows="3"
                                  placeholder="Ghi chú về địa điểm này..."></textarea>
                    </div>

                    <div class="mb-4 p-3" style="background:rgba(255,255,255,.02);border:1px dashed var(--border);border-radius:12px;">
                        <label class="form-label-custom">Hình ảnh đại diện</label>
                        <input type="file" name="image" id="imageInput" class="form-control-custom mb-3" accept="image/*" />
                        <div class="text-center" id="imagePreviewContainer"
                             style='@(string.IsNullOrEmpty(Model.ImageUrl) ? "display:none;" : "")'>
                            <span class="text-muted small d-block mb-2">Ảnh đại diện hiện tại:</span>
                            <img id="imagePreview" src="@Model.ImageUrl" alt="Preview"
                                 style="max-width:100%;height:auto;border-radius:10px;max-height:200px;object-fit:cover;border:1px solid var(--border);" />
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-custom w-100 justify-content-center">
                        💾 Lưu thay đổi
                    </button>
                    <div class="text-center mt-3 text-muted small">
                        Click bản đồ bên cạnh để thay đổi vị trí
                    </div>
                </form>
            </div>

            @* ── Right Mini Map ── *@
            <div class="col-md-6 p-4 p-md-5 d-flex flex-column">
                <label class="form-label-custom">Vị trí trên bản đồ</label>
                <div class="mini-map-wrapper flex-grow-1" style="min-height:550px;">
                    <div id="mini-map" style="height:100%;min-height:550px;"></div>
                </div>
                <div class="mini-map-tip mt-3">
                    <span style="font-size:1.2rem">👆</span>
                    <span>Click vào bản đồ để cập nhật vị trí mới!</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    // ── Show/hide hotel fields ──
    var categorySelect = document.getElementById('categorySelect');
    var hotelFields = document.getElementById('hotelFields');
    function updateFields() {
        var selectedText = categorySelect.options[categorySelect.selectedIndex]?.text?.toLowerCase() ?? '';
        hotelFields.style.display = selectedText.includes('khách sạn') || selectedText.includes('hotel') ? 'block' : 'none';
    }
    categorySelect.addEventListener('change', updateFields);

    // ── Map ──
    var latInput=document.getElementById('lat');
    var lngInput=document.getElementById('lng');
    var initialLat=latInput.value?parseFloat(latInput.value):10.8231;
    var initialLng=lngInput.value?parseFloat(lngInput.value):106.6297;
    var map=L.map('mini-map').setView([initialLat,initialLng],latInput.value?16:13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);
    setTimeout(function(){map.invalidateSize();},500);
    new ResizeObserver(function(){map.invalidateSize();}).observe(document.getElementById('mini-map'));
    var marker=null;
    if(latInput.value&&lngInput.value){marker=L.marker([initialLat,initialLng]).addTo(map);}
    map.on('click',function(e){
        latInput.value=e.latlng.lat.toFixed(6);lngInput.value=e.latlng.lng.toFixed(6);
        if(marker){marker.setLatLng(e.latlng);}else{marker=L.marker(e.latlng).addTo(map);}
    });

    // ── Image Preview ──
    document.getElementById('imageInput').addEventListener('change',function(event){
        var container=document.getElementById('imagePreviewContainer');
        var preview=document.getElementById('imagePreview');
        if(event.target.files&&event.target.files[0]){
            var reader=new FileReader();
            reader.onload=function(e){preview.src=e.target.result;container.style.display='block';};
            reader.readAsDataURL(event.target.files[0]);
        }
    });
</script>
}
