}
/* ── Details Toast Notification ── */
.details-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.93);
    border: 1px solid rgba(249, 115, 22, 0.3);
    box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    font-size: 0.85rem;
    font-weight: 600;
    color: #f1f5f9;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    pointer-events: none;
    opacity: 0;
    transform: translateY(16px) scale(0.95);
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    max-width: 320px;
}
.details-toast.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
}
</style>
<div id="details-toast-container"></div>
<script>
(function() {
    // ── Toast helper (local to Details page) ──
    function showDetailsToast(message, emoji) {
        emoji = emoji || '✅';
        var container = document.getElementById('details-toast-container');
        var toast = document.createElement('div');
        toast.className = 'details-toast';
        toast.innerHTML = '<span style="font-size:1.1rem">' + emoji + '</span><span>' + message + '</span>';
        container.appendChild(toast);
        requestAnimationFrame(function() {
            requestAnimationFrame(function() { toast.classList.add('visible'); });
        });
        setTimeout(function() {
            toast.classList.remove('visible');
            setTimeout(function() { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 400);
        }, 3000);
    }

    // ── Helpful vote AJAX ──
    document.querySelectorAll('.btn-helpful').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (btn.classList.contains('voted') || btn.classList.contains('loading')) return;
            var commentId = btn.dataset.commentId;
            var countEl   = document.getElementById('helpful-count-' + commentId);
            var labelEl   = btn.querySelector('.helpful-label');

            btn.classList.add('loading');

            fetch('/Place/VoteCommentHelpful', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: 'commentId=' + encodeURIComponent(commentId)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                btn.classList.remove('loading');
                if (data.success) {
                    // Vote thành công: cập nhật UI và khóa nút
                    if (countEl) countEl.textContent = data.newCount;
                    if (labelEl) labelEl.textContent = 'Đã thấy hữu ích';
                    btn.classList.add('voted', 'bouncing');
                    btn.title = 'Bạn đã bình chọn bình luận này';
                    setTimeout(function() { btn.classList.remove('bouncing'); }, 600);
                    showDetailsToast('Cảm ơn bạn đã đánh dấu bình luận này là hữu ích!', '👍');
                } else if (data.alreadyVoted) {
                    // Server xác nhận đã vote rồi (trường hợp race condition hoặc tab khác)
                    if (labelEl) labelEl.textContent = 'Đã thấy hữu ích';
                    btn.classList.add('voted');
                    btn.title = 'Bạn đã bình chọn bình luận này';
                    showDetailsToast('Bạn đã bình chọn bình luận này rồi!', 'ℹ️');
                } else {
                    showDetailsToast(data.message || 'Có lỗi xảy ra, vui lòng thử lại.', '⚠️');
                }
            })
            .catch(function() {
                btn.classList.remove('loading');
                showDetailsToast('Không thể kết nối đến máy chủ.', '❌');
            });
        });
    });
})();
</script>

<script>
// ── AJAX AI Summary Loader ──
function loadAiSummary(force) {
    var contentEl = document.querySelector('.ai-summary-content');
    if (!contentEl) return;

    // Hiển thị hiệu ứng tải mượt mà
    contentEl.innerHTML = `
        <div class="ai-summary-loading-placeholder text-center py-4 animate-in">
            <div class="spinner-border mb-3" role="status" style="width: 2.5rem; height: 2.5rem; color: #f97316;">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mb-1 fw-semibold text-light">RestNDine AI đang phân tích bình luận...</p>
            <p class="text-muted small px-3">Quá trình này sử dụng mô hình học sâu PhoBERT để trích xuất khía cạnh (ABSA) và cảm xúc đánh giá. Có thể mất khoảng 3-5 giây.</p>
        </div>
    `;

    // Vô hiệu hóa nút Phân tích lại khi đang tải
    var reanalyzeBtn = document.getElementById('btn-reanalyze-ai');
    if (reanalyzeBtn) {
        reanalyzeBtn.disabled = true;
        reanalyzeBtn.innerHTML = '🔄 Đang phân tích...';
        reanalyzeBtn.style.opacity = '0.6';
        reanalyzeBtn.style.pointerEvents = 'none';
    }

    var url = '/Place/GetAiSummary?placeId=@Model.Id' + (force ? '&forceRefresh=true' : '');

    fetch(url, {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            contentEl.innerHTML = data.html;
            if (data.chartData) renderSentimentChart(data.chartData);
        } else {
            contentEl.innerHTML = '<span class="text-danger">⚠️ Lỗi: ' + (data.message || 'Không thể tải báo cáo AI.') + '</span>';
        }
    })
    .catch(function() {
        contentEl.innerHTML = '<span class="text-danger">❌ Lỗi kết nối đến máy chủ khi tải báo cáo AI.</span>';
    })
    .finally(function() {
        if (reanalyzeBtn) {
            reanalyzeBtn.disabled = false;
            reanalyzeBtn.innerHTML = '🔄 Phân tích lại';
            reanalyzeBtn.style.opacity = '1';
            reanalyzeBtn.style.pointerEvents = 'auto';
        }
    });
}

@if (ViewBag.AiSummary == null)
{
