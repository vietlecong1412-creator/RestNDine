}
@if (ViewBag.ChartPositive != null)
{
    <text>
    document.addEventListener('DOMContentLoaded', function() {
        renderSentimentChart({
            positive: @ViewBag.ChartPositive,
            neutral:  @ViewBag.ChartNeutral,
            negative: @ViewBag.ChartNegative
        });
    });
    </text>
}
</script>

<script src="https://www.gstatic.com/charts/loader.js"></script>
<script>
google.charts.load('current', { packages: ['corechart'] });

function renderSentimentChart(chartData) {
    var wrapper = document.getElementById('ai-chart-wrapper');
    if (!wrapper) return;
    var total = (chartData.positive || 0) + (chartData.neutral || 0) + (chartData.negative || 0);
    if (total === 0) { wrapper.style.display = 'none'; return; }
    wrapper.style.display = 'block';

    function drawChart() {
        var data = google.visualization.arrayToDataTable([
            ['Loại', 'Số lượng'],
            ['Tích cực (' + chartData.positive + ')',  chartData.positive  || 0],
            ['Trung lập (' + chartData.neutral  + ')',  chartData.neutral   || 0],
            ['Tiêu cực (' + chartData.negative  + ')',  chartData.negative  || 0]
        ]);
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark'
                  || document.body.classList.contains('dark');
        var legendColor = isDark ? '#e2e8f0' : '#334155';
        var options = {
            is3D: true,
            colors: ['#22c55e', '#eab308', '#ef4444'],
            backgroundColor: 'transparent',
            legend: {
                textStyle: { color: legendColor, fontSize: 12, bold: true },
                position: 'right',
                alignment: 'center'
            },
            pieSliceTextStyle: { color: '#fff', bold: true, fontSize: 11 },
            pieSliceText: 'percentage',
            chartArea: { left: '0%', top: '5%', width: '65%', height: '90%' },
            slices: {
                0: { offset: 0.04 },
                2: { offset: 0.06 }
            }
        };
        var chart = new google.visualization.PieChart(document.getElementById('ai-sentiment-chart'));
        chart.draw(data, options);
    }

    if (window.google && google.visualization) {
        drawChart();
    } else {
        google.charts.setOnLoadCallback(drawChart);
    }
}
</script>

@* ── Thư viện SignalR & Logic Chat thời gian thực ── *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
(function() {
    var isAuthenticated = @(User.Identity!.IsAuthenticated ? "true" : "false");
    var currentUserId = "@currentUser?.Id";
    var placeId = @Model.Id;
    var placeOwnerId = "@Model.OwnerId";
    var isOwner = @(User.Identity!.IsAuthenticated && Model.OwnerId == currentUser?.Id ? "true" : "false");

    var bubble = document.getElementById("chat-bubble");
    var panel = document.getElementById("chat-panel");
    var body = document.getElementById("chat-panel-body");
    var footer = document.getElementById("chat-panel-footer");
    var headerTitle = document.getElementById("chat-header-title");
    var headerSubtitle = document.getElementById("chat-header-subtitle");
    var backBtn = document.getElementById("chat-back-btn");
    var headerAvatar = document.getElementById("chat-header-avatar");
    var unreadBadge = document.getElementById("chat-unread-badge");

    // Chỉ hiển thị bong bóng chat nếu quán có chủ quán và người dùng hiện tại không phải chủ quán tự chat với chính mình
    if (placeOwnerId && placeOwnerId !== "") {
        bubble.style.display = "flex";
    }

    var connection = null;
    var isChatOpen = false;
    var activeChatCustomerId = null; // Chỉ dùng cho chủ quán (owner)

    // Khởi tạo kết nối SignalR nếu đã đăng nhập
    if (isAuthenticated) {
        connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (message) {
            if (message.placeId !== placeId) return; // Không thuộc địa điểm này

            if (isOwner) {
                // Nếu là chủ quán đang mở cuộc trò chuyện với khách hàng gửi tin nhắn
                var targetId = message.senderId === currentUserId ? message.receiverId : message.senderId;
                if (activeChatCustomerId === targetId) {
                    appendMessage(message);
                    scrollToBottom();
                    markAsReadApi(targetId);
                } else {
                    // Update danh sách hội thoại và badge số tin nhắn chưa đọc
                    if (isChatOpen && !activeChatCustomerId) {
                        loadConversations();
                    }
                    updateTotalUnreadBadge();
                }
            } else {
                // Khách hàng nhận tin nhắn
                if (message.senderId === currentUserId || message.receiverId === currentUserId) {
                    if (isChatOpen) {
                        appendMessage(message);
                        scrollToBottom();
                        markAsReadApi(placeOwnerId);
                    } else {
                        updateTotalUnreadBadge();
                    }
                }
            }
        });

        connection.start()
            .then(function() {
                updateTotalUnreadBadge();
            })
            .catch(function(err) {
                console.error("SignalR Connection Error: ", err);
            });
    }

    window.toggleChatPanel = function() {
        if (!isAuthenticated) {
            panel.classList.toggle("d-none");
            isChatOpen = !panel.classList.contains("d-none");
            if (isChatOpen) {
                showUnauthenticatedMessage();
            }
            return;
        }

        panel.classList.toggle("d-none");
        isChatOpen = !panel.classList.contains("d-none");

        if (isChatOpen) {
            if (isOwner) {
                backToConversations();
            } else {
                openCustomerChat();
            }
        }
    };

    window.backToConversations = function() {
        activeChatCustomerId = null;
        headerTitle.textContent = "Hội thoại";
        headerSubtitle.textContent = "Khách hàng của quán";
        headerAvatar.textContent = "💬";
        backBtn.classList.add("d-none");
        footer.classList.add("d-none");

        loadConversations();
    };

    function showUnauthenticatedMessage() {
        backBtn.classList.add("d-none");
        footer.classList.add("d-none");
        headerTitle.textContent = "Trò chuyện";
        headerSubtitle.textContent = "Khách vãng lai";
        headerAvatar.textContent = "💬";

        body.innerHTML = `
            <div class="chat-unauth-container text-center py-5">
                <div class="chat-unauth-icon mb-3" style="font-size: 3rem;">💬</div>
                <h5 class="fw-bold mb-2">Trò chuyện với chủ quán</h5>
                <p class="text-muted small px-4 mb-4">Vui lòng đăng nhập để gửi tin nhắn thắc mắc, đặt bàn hoặc hỏi tiện ích dịch vụ.</p>
                <a href="/Identity/Account/Login?returnUrl=${encodeURIComponent(window.location.pathname)}" class="btn-primary-custom px-4 py-2" style="text-decoration:none; display:inline-block; font-size:0.9rem; border-radius:20px;">Đăng nhập ngay</a>
            </div>
        `;
    }

    function openCustomerChat() {
        activeChatCustomerId = placeOwnerId;
        headerTitle.textContent = "Chủ quán";
        headerSubtitle.textContent = "Hỗ trợ khách hàng";
        headerAvatar.textContent = "👤";
        backBtn.classList.add("d-none");
        footer.classList.remove("d-none");

        loadMessages(placeOwnerId);
        markAsReadApi(placeOwnerId);
    }

    function openOwnerChat(customerId, customerEmail) {
        activeChatCustomerId = customerId;
        headerTitle.textContent = customerEmail.split("@@")[0];
        headerSubtitle.textContent = "Khách hàng";
        headerAvatar.textContent = customerEmail.substring(0, 1).toUpperCase();
        backBtn.classList.remove("d-none");
        footer.classList.remove("d-none");

        loadMessages(customerId);
        markAsReadApi(customerId);
    }

    function loadConversations() {
        body.innerHTML = `
            <div class="d-flex justify-content-center align-items-center h-100">
                <div class="spinner-border text-primary spinner-border-sm" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
            </div>
        `;

        fetch(`/api/chat/conversations?placeId=${placeId}`)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                body.innerHTML = "";
                if (data.conversations.length === 0) {
                    body.innerHTML = `
                        <div class="text-center text-muted py-5 small chat-empty-state">
                            Chưa có cuộc trò chuyện nào từ khách hàng.
                        </div>
                    `;
                } else {
                    data.conversations.forEach(function(conv) {
                        var convDiv = document.createElement("div");
                        convDiv.className = `chat-conversation-item ${conv.unreadCount > 0 ? "unread" : ""}`;
                        convDiv.onclick = function() {
                            openOwnerChat(conv.customerId, conv.customerEmail);
                        };

                        var charAvatar = conv.customerEmail.substring(0, 1).toUpperCase();

                        convDiv.innerHTML = `
                            <div class="chat-conv-avatar">${charAvatar}</div>
                            <div class="chat-conv-info">
                                <div class="chat-conv-header">
                                    <span class="chat-conv-name">${escapeHtml(conv.customerEmail)}</span>
                                    <span class="chat-conv-time">${conv.lastMessageTime}</span>
                                </div>
                                <div class="chat-conv-body">
                                    <span class="chat-conv-last-msg">${escapeHtml(conv.lastMessageContent)}</span>
                                    ${conv.unreadCount > 0 ? `<span class="chat-conv-unread-badge">${conv.unreadCount}</span>` : ""}
                                </div>
                            </div>
                        `;
                        body.appendChild(convDiv);
                    });
                }
            } else {
                body.innerHTML = `<div class="text-danger small p-3">Lỗi: ${data.message || 'Không thể tải hội thoại.'}</div>`;
            }
        })
        .catch(function() {
            body.innerHTML = `<div class="text-danger small p-3">Lỗi kết nối máy chủ.</div>`;
        });
    }

    function loadMessages(customerId) {
        body.innerHTML = `
            <div class="d-flex justify-content-center align-items-center h-100">
                <div class="spinner-border text-primary spinner-border-sm" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
            </div>
        `;

        fetch(`/api/chat/messages?placeId=${placeId}&customerId=${customerId}`)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                body.innerHTML = "";
                if (data.messages.length === 0) {
                    body.innerHTML = `
                        <div class="text-center text-muted py-5 small chat-empty-state">
                            Bắt đầu cuộc trò chuyện bằng cách gửi tin nhắn đầu tiên!
                        </div>
                    `;
                } else {
                    data.messages.forEach(function(msg) {
                        appendMessage(msg);
                    });
                    scrollToBottom();
                }
            } else {
                body.innerHTML = `<div class="text-danger small p-3">Lỗi: ${data.message || 'Không thể tải tin nhắn.'}</div>`;
            }
        })
        .catch(function() {
            body.innerHTML = `<div class="text-danger small p-3">Lỗi kết nối máy chủ.</div>`;
        });
    }

    function appendMessage(msg) {
        var emptyState = body.querySelector(".chat-empty-state");
        if (emptyState) {
            body.innerHTML = "";
        }

        var isMyMsg = msg.senderId === currentUserId;
        var bubbleClass = isMyMsg ? "chat-msg-outgoing" : "chat-msg-incoming";

        var msgDiv = document.createElement("div");
        msgDiv.className = `chat-message-row ${bubbleClass}`;
        msgDiv.innerHTML = `
            <div class="chat-message-bubble" title="${msg.sentAt}">
                <div class="chat-message-content">${escapeHtml(msg.content)}</div>
                <div class="chat-message-time">${msg.sentAt.split(" ")[1]}</div>
            </div>
        `;
        body.appendChild(msgDiv);
    }

    window.handleSendMessage = function(event) {
        event.preventDefault();
        var input = document.getElementById("chat-input-message");
        var content = input.value.trim();
        if (!content) return;

        input.value = "";
        var targetReceiverId = isOwner ? activeChatCustomerId : placeOwnerId;

        var formData = new FormData();
        formData.append("placeId", placeId);
        formData.append("receiverId", targetReceiverId);
        formData.append("content", content);

        var sendBtn = document.getElementById("chat-send-btn");
        sendBtn.disabled = true;

        fetch("/api/chat/send", {
            method: "POST",
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            sendBtn.disabled = false;
            if (!data.success) {
                toastHelper(data.message || "Không thể gửi tin nhắn.", "error");
            }
        })
        .catch(function() {
            sendBtn.disabled = false;
            toastHelper("Không thể kết nối đến máy chủ để gửi tin nhắn.", "error");
        });
    };

    function markAsReadApi(customerId) {
        var formData = new FormData();
        formData.append("placeId", placeId);
        formData.append("customerId", customerId);

        fetch("/api/chat/read", {
            method: "POST",
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                updateTotalUnreadBadge();
            }
        });
    }

    function updateTotalUnreadBadge() {
        if (!isAuthenticated) return;

        if (isOwner) {
            fetch(`/api/chat/conversations?placeId=${placeId}`)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    var totalUnread = data.conversations.reduce(function(sum, conv) { return sum + conv.unreadCount; }, 0);
                    if (totalUnread > 0) {
                        unreadBadge.textContent = totalUnread;
                        unreadBadge.classList.remove("d-none");
                    } else {
                        unreadBadge.classList.add("d-none");
                    }
                }
            });
        } else {
            fetch(`/api/chat/messages?placeId=${placeId}`)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    var totalUnread = data.messages.filter(function(msg) {
                        return msg.senderId === placeOwnerId && !msg.isRead;
                    }).length;
                    if (totalUnread > 0) {
                        unreadBadge.textContent = totalUnread;
                        unreadBadge.classList.remove("d-none");
                    } else {
                        unreadBadge.classList.add("d-none");
                    }
                }
            });
        }
    }

    function scrollToBottom() {
        body.scrollTop = body.scrollHeight;
    }

    function escapeHtml(text) {
        var map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, function(m) { return map[m]; });
    }

    function toastHelper(msg, type) {
        if (typeof showToast === 'function') {
            showToast(msg, type);
        } else if (typeof showDetailsToast === 'function') {
            showDetailsToast(msg, type === 'error' ? '❌' : '⚠️');
        } else {
            alert(msg);
        }
    }

    // Tự động kiểm tra tin nhắn chưa đọc khi load trang
    if (isAuthenticated) {
        updateTotalUnreadBadge();
    }
})();
</script>
}
