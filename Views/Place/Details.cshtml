.slider-add-zone{position:absolute;bottom:14px;right:14px;z-index:20;}
.slider-add-btn{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;background:rgba(249,115,22,.85);color:#fff;font-size:1.5rem;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.35);border:2px solid rgba(255,255,255,.25);transition:background .2s,transform .2s;backdrop-filter:blur(6px);line-height:1;}
.slider-add-btn:hover{background:#ea580c;transform:scale(1.12);}
.slider-delete-form{position:absolute;top:12px;right:12px;z-index:20;}
.slider-delete-btn{display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:rgba(239,68,68,.8);color:#fff;border:2px solid rgba(255,255,255,.25);font-size:1.1rem;cursor:pointer;box-shadow:0 3px 10px rgba(0,0,0,.35);transition:background .2s,transform .2s;backdrop-filter:blur(6px);}
.slider-delete-btn:hover{background:#dc2626;transform:scale(1.1);}
</style>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    var placeLat = @Model.Latitude;
    var placeLng = @Model.Longitude;
    var map = L.map('details-map', { zoomControl: false }).setView([placeLat, placeLng], 16);

    // Sync tile với theme sáng/tối
    var isDark = document.documentElement.classList.contains('dark-theme');
    var lightTiles = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', { attribution: 'Tiles &copy; Esri', maxNativeZoom: 19, maxZoom: 20 });
    var darkTiles  = L.layerGroup([
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', { attribution: 'Tiles &copy; Esri', maxNativeZoom: 16, maxZoom: 20 }),
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', { maxNativeZoom: 16, maxZoom: 20 })
    ]);
    (isDark ? darkTiles : lightTiles).addTo(map);
    window.addEventListener('theme-changed', function(e) {
        if (e.detail.theme === 'dark') { map.removeLayer(lightTiles); darkTiles.addTo(map); }
        else { map.removeLayer(darkTiles); lightTiles.addTo(map); }
    });

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    // Marker địa điểm
    var catIcon = '@categoryIcon';
    var customIcon = L.divIcon({
        className: '',
        html: '<div style="width:32px;height:32px;background:linear-gradient(135deg,#f97316,#ea580c);border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:2px solid rgba(255,255,255,.4);box-shadow:0 3px 10px rgba(0,0,0,.4);"><span style="display:block;transform:rotate(45deg);text-align:center;line-height:28px;font-size:14px;">' + catIcon + '</span></div>',
        iconSize: [32, 32], iconAnchor: [16, 32]
    });
    L.marker([placeLat, placeLng], { icon: customIcon }).addTo(map)
     .bindPopup(Object.assign(document.createElement('b'), { textContent: @Json.Serialize(Model.Name) }));

    // ── OSRM Routing ──────────────────────────────────────────────────────────
    var routeLine  = null;
    var userMarker = null;

    function requestDirections() {
        var btn = document.getElementById('btn-directions-detail');
        if (!navigator.geolocation) {
            showToast('Trình duyệt không hỗ trợ định vị.', 'warning');
            return;
        }
        btn.textContent = '⏳ Đang lấy vị trí...';
        btn.disabled = true;

        navigator.geolocation.getCurrentPosition(function(pos) {
            var uLat = pos.coords.latitude;
            var uLng = pos.coords.longitude;

            // Marker vị trí người dùng
            if (userMarker) map.removeLayer(userMarker);
            userMarker = L.circleMarker([uLat, uLng], {
                radius: 9, color: '#3b82f6', fillColor: '#3b82f6',
                fillOpacity: 1, weight: 3, opacity: 0.5
            }).addTo(map).bindPopup('📍 Vị trí của bạn').openPopup();

            btn.textContent = '⏳ Đang tính đường...';

            // Gọi OSRM (miễn phí, không cần API key)
            var osrmUrl = 'https://router.project-osrm.org/route/v1/driving/' +
                uLng + ',' + uLat + ';' + placeLng + ',' + placeLat +
                '?overview=full&geometries=geojson';

            fetch(osrmUrl)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.routes || !data.routes.length) {
                    showToast('Không tìm thấy đường đi. Vui lòng thử lại.', 'warning');
                    resetBtn(); return;
                }
                var route  = data.routes[0];
                var coords = route.geometry.coordinates.map(function(c) { return [c[1], c[0]]; });

                if (routeLine) map.removeLayer(routeLine);

                // Vẽ đường đi màu cam
                routeLine = L.polyline(coords, {
                    color: '#f97316', weight: 5, opacity: 0.85,
                    lineJoin: 'round', lineCap: 'round'
                }).addTo(map);

                // Mở rộng bản đồ
                var mapEl = document.getElementById('details-map');
                mapEl.style.height = '420px';
                setTimeout(function() {
                    map.invalidateSize();
                    map.fitBounds(routeLine.getBounds(), { padding: [40, 40] });
                }, 420);

                // Hiển thị tóm tắt tuyến đường
                var distKm  = (route.distance / 1000).toFixed(1);
                var durMin  = Math.ceil(route.duration / 60);
                var durText = durMin >= 60
                    ? Math.floor(durMin / 60) + ' giờ ' + (durMin % 60) + ' phút'
                    : durMin + ' phút';
                document.getElementById('route-summary').innerHTML =
                    '🚗 <strong>' + distKm + ' km</strong>&nbsp;·&nbsp;⏱ <strong>' + durText + '</strong> lái xe';
                document.getElementById('route-info-bar').style.display = 'block';

                btn.textContent = '🔄 Tính lại đường';
                btn.disabled = false;
            })
            .catch(function() {
                showToast('Lỗi kết nối dịch vụ bản đồ. Vui lòng thử lại.', 'error');
                resetBtn();
            });
        }, function(err) {
            var msg = err.code === 1
                ? 'Bạn đã từ chối quyền định vị. Vui lòng cho phép trong cài đặt trình duyệt.'
                : 'Không lấy được vị trí hiện tại.';
            showToast(msg, 'warning');
            resetBtn();
        }, { timeout: 10000, enableHighAccuracy: true });
    }

    function clearRoute() {
        if (routeLine)  { map.removeLayer(routeLine);  routeLine = null; }
        if (userMarker) { map.removeLayer(userMarker); userMarker = null; }
        document.getElementById('route-info-bar').style.display = 'none';
        document.getElementById('details-map').style.height = '280px';
        setTimeout(function() {
            map.invalidateSize();
            map.setView([placeLat, placeLng], 16);
        }, 420);
        resetBtn();
    }

    function resetBtn() {
        var btn = document.getElementById('btn-directions-detail');
        if (btn) { btn.textContent = '🧭 Chỉ đường đến đây'; btn.disabled = false; }
    }
</script>

<script>
(function(){
    var hints=['','Tệ','Không hay','Bình thường','Tốt','Tuyệt vời'];
    var currentRating=5;
    var picker=document.getElementById('star-picker');
    var valInput=document.getElementById('rating-value');
    var hintEl=document.getElementById('star-hint');
    if(!picker) return;
    var btns=picker.querySelectorAll('.star-btn');
    function setRating(val){currentRating=val;if(valInput)valInput.value=val;if(hintEl)hintEl.textContent=hints[val]||'';btns.forEach(function(b){b.classList.toggle('active',parseInt(b.dataset.value)<=val);});}
    btns.forEach(function(btn){
        btn.addEventListener('mouseenter',function(){var v=parseInt(this.dataset.value);btns.forEach(function(b){b.classList.toggle('hover',parseInt(b.dataset.value)<=v);});if(hintEl)hintEl.textContent=hints[v]||'';});
        btn.addEventListener('mouseleave',function(){btns.forEach(function(b){b.classList.remove('hover');});if(hintEl)hintEl.textContent=hints[currentRating]||'';});
        btn.addEventListener('click',function(){setRating(parseInt(this.dataset.value));});
    });
    setRating(5);
})();
</script>
<script>
(function(){
    var slides=document.querySelectorAll('#restaurantSlider .slider-slide');
    var dots=document.querySelectorAll('#sliderDots .dot');
    var prevBtn=document.getElementById('sliderPrev');
    var nextBtn=document.getElementById('sliderNext');
    if(!slides.length) return;
    var current=0,total=slides.length,timer;
    function goTo(idx){slides[current].classList.remove('active');if(dots[current])dots[current].classList.remove('active');current=(idx+total)%total;slides[current].classList.add('active');if(dots[current])dots[current].classList.add('active');}
    function startAuto(){if(total<=1)return;timer=setInterval(function(){goTo(current+1);},4500);}
    function stopAuto(){clearInterval(timer);}
    if(prevBtn)prevBtn.addEventListener('click',function(){stopAuto();goTo(current-1);startAuto();});
    if(nextBtn)nextBtn.addEventListener('click',function(){stopAuto();goTo(current+1);startAuto();});
    dots.forEach(function(dot){dot.addEventListener('click',function(){stopAuto();goTo(parseInt(this.dataset.dot));startAuto();});});
    var slider=document.getElementById('restaurantSlider');
    if(slider){slider.addEventListener('mouseenter',stopAuto);slider.addEventListener('mouseleave',startAuto);}
    startAuto();
})();
</script>

