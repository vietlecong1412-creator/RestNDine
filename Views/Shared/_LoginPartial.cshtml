@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var username = UserManager.GetUserName(User) ?? "User";
    var initial = username.Length > 0 ? username[0].ToString().ToUpper() : "U";

    <a id="manage" class="user-badge"
       asp-area="Identity" asp-page="/Account/Manage/Index" title="Quản lý tài khoản">
        <span class="user-avatar">@initial</span>
        <span>@username</span>
    </a>

    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
          style="display:inline;">
        <button id="logout" type="submit" class="btn-logout">
            Đăng xuất
        </button>
    </form>
}
else
{
    <a class="btn-auth btn-auth-login" id="login"
       asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>

    <a class="btn-auth btn-auth-register" id="register"
       asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
}
