@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodRadar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="auth-page">
    <div class="auth-card" style="max-width: 440px;">
        <div class="auth-header">
            <div class="auth-logo">
                <i class="fa-solid fa-key"></i>
            </div>
            <h1 class="auth-title">Đặt lại mật khẩu</h1>
            <p class="auth-subtitle">Nhập email của bạn và thiết lập mật khẩu mới</p>
        </div>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="form-group mb-3">
                <label asp-for="Input.Email">Email của bạn</label>
                <input asp-for="Input.Email" class="form-control-custom" autocomplete="email" aria-required="true" placeholder="email@vi-du.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Password">Mật khẩu mới</label>
                <input asp-for="Input.Password" class="form-control-custom" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu mới</label>
                <input asp-for="Input.ConfirmPassword" class="form-control-custom" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="w-100 btn-primary-custom py-2 justify-content-center">
                Đặt lại mật khẩu <i class="fa-solid fa-check ms-2"></i>
            </button>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
