@page
@model LockoutModel
@{
    ViewData["Title"] = "Tài khoản bị khóa";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestNDine</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .lockout-logo {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            color: white;
            margin: 0 auto 1.5rem;
            box-shadow: 0 8px 24px rgba(239, 68, 68, 0.4);
            animation: pulse-red 2s infinite ease-in-out;
        }

        .lockout-alert {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.25);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            text-align: left;
        }

        @@keyframes pulse-red {
            0% {
                transform: scale(1);
                box-shadow: 0 8px 24px rgba(239, 68, 68, 0.4);
            }
            50% {
                transform: scale(1.05);
                box-shadow: 0 8px 32px rgba(239, 68, 68, 0.6), 0 0 15px rgba(239, 68, 68, 0.3);
            }
            100% {
                transform: scale(1);
                box-shadow: 0 8px 24px rgba(239, 68, 68, 0.4);
            }
        }

        .countdown-container {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        .countdown-timer {
            font-weight: 700;
            color: #ef4444;
            font-family: monospace;
            font-size: 1.1rem;
            background: rgba(239, 68, 68, 0.15);
            padding: 2px 8px;
            border-radius: 4px;
        }
    </style>
</head>
<body class="auth-page">
    <div class="auth-card text-center">
        <div class="auth-header">
            <div class="lockout-logo animate-in">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <h1 class="auth-title animate-in" style="color: #ef4444;">Tài khoản bị khóa</h1>
            <p class="auth-subtitle animate-in">Bảo vệ bảo mật hệ thống RestNDine</p>
        </div>

        <div class="lockout-alert animate-in" style="animation-delay: 0.1s;">
            <p class="mb-2 text-white font-weight-bold" style="font-size: 0.95rem;">
                <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i> Phát hiện hoạt động bất thường
            </p>
            <p class="text-secondary small mb-0" style="line-height: 1.5;">
                Tài khoản này đã bị tạm khóa do có nhiều lần thử đăng nhập thất bại liên tiếp (vượt quá 5 lần). Cơ chế này nhằm bảo vệ tài khoản của bạn khỏi các nỗ lực xâm nhập trái phép.
            </p>
        </div>

        <div class="countdown-container animate-in" style="animation-delay: 0.15s;">
            <i class="fa-regular fa-clock text-danger"></i>
            <span>Tự động mở khóa sau khoảng:</span>
            <span class="countdown-timer">05:00</span>
        </div>

        <div class="animate-in" style="animation-delay: 0.2s;">
            <a asp-page="./Login" class="btn-primary-custom w-100 py-2 justify-content-center text-decoration-none d-flex align-items-center mb-3">
                <i class="fa-solid fa-rotate-left me-2"></i> Quay lại Đăng nhập
            </a>
            
            <a href="/" class="text-decoration-none small text-muted hover-light" style="transition: color 0.2s;">
                <i class="fa-solid fa-house me-1"></i> Quay về Trang chủ
            </a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Hiệu ứng đếm ngược trực quan trong trang
        $(document).ready(function() {
            let timeLeft = 300; // 5 phút = 300 giây
            const timerDisplay = $('.countdown-timer');
            
            const interval = setInterval(function() {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(interval);
                    timerDisplay.text("00:00");
                    timerDisplay.css("background-color", "rgba(34, 197, 94, 0.15)");
                    timerDisplay.css("color", "#22c55e");
                    $('.countdown-container span:first').text("Bạn có thể thử đăng nhập lại ngay bây giờ!");
                    return;
                }
                
                let minutes = Math.floor(timeLeft / 60);
                let seconds = timeLeft % 60;
                
                minutes = minutes < 10 ? '0' + minutes : minutes;
                seconds = seconds < 10 ? '0' + seconds : seconds;
                
                timerDisplay.text(minutes + ':' + seconds);
            }, 1000);
        });
    </script>
</body>
</html>
