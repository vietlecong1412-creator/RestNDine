@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Xác nhận gửi email đặt lại mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodRadar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .confirmation-logo {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            margin: 0 auto 1.5rem;
            box-shadow: 0 8px 24px rgba(16, 185, 129, 0.3);
            animation: float-plane 3s infinite ease-in-out;
        }

        @@keyframes float-plane {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
            100% { transform: translateY(0px); }
        }

        .info-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            text-align: left;
        }
    </style>
</head>
<body class="auth-page">
    <div class="auth-card text-center" style="max-width: 440px;">
        <div class="auth-header">
            <div class="confirmation-logo animate-in">
                <i class="fa-solid fa-envelope-circle-check"></i>
            </div>
            <h1 class="auth-title animate-in">Đã gửi yêu cầu!</h1>
            <p class="auth-subtitle animate-in">Vui lòng kiểm tra hòm thư email của bạn</p>
        </div>

        <div class="info-box animate-in" style="animation-delay: 0.1s;">
            <p class="text-white small mb-2 font-weight-bold">
                <i class="fa-solid fa-circle-info text-success me-2"></i> Tiếp theo bạn cần làm gì?
            </p>
            <p class="text-secondary small mb-0" style="line-height: 1.6;">
                Nếu địa chỉ email bạn nhập tồn tại trong hệ thống FoodRadar và đã được xác thực, một liên kết đặt lại mật khẩu đã được gửi đi. Vui lòng mở hòm thư, tìm kiếm email từ <strong>FoodRadar Security</strong> và click vào nút **Đặt lại mật khẩu** để tiếp tục. <br/>
                <span class="text-muted font-italic small mt-2 d-block">*Đừng quên kiểm tra cả mục Thư rác (Spam) nếu không thấy ở hộp thư đến.</span>
            </p>
        </div>

        <div class="animate-in" style="animation-delay: 0.2s;">
            <a asp-page="./Login" class="btn-primary-custom w-100 py-2 justify-content-center text-decoration-none d-flex align-items-center mb-3">
                <i class="fa-solid fa-arrow-left me-2"></i> Quay lại Đăng nhập
            </a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
