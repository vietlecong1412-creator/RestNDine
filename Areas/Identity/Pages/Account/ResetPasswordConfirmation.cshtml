@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodRadar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .success-logo {
            width: 75px;
            height: 75px;
            background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: white;
            margin: 0 auto 1.5rem;
            box-shadow: 0 8px 24px rgba(16, 185, 129, 0.4);
            animation: bounce-check 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
        }

        @@keyframes bounce-check {
            0% { transform: scale(0); opacity: 0; }
            70% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        .status-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body class="auth-page">
    <div class="auth-card text-center" style="max-width: 440px;">
        <div class="auth-header">
            <div class="success-logo">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <h1 class="auth-title text-success">Đã đổi mật khẩu!</h1>
            <p class="auth-subtitle">Cập nhật mật khẩu tài khoản thành công</p>
        </div>

        <div class="status-box animate-in" style="animation-delay: 0.1s;">
            <p class="text-secondary small mb-0" style="line-height: 1.6;">
                Tuyệt vời! Mật khẩu tài khoản FoodRadar của bạn đã được thay đổi và đồng bộ thành công. Để đảm bảo an toàn, tất cả các phiên đăng nhập cũ (nếu có) có thể đã hết hiệu lực. Vui lòng bấm vào nút dưới đây để tiến hành đăng nhập bằng mật khẩu mới của bạn.
            </p>
        </div>

        <div class="animate-in" style="animation-delay: 0.2s;">
            <a asp-page="./Login" class="btn-primary-custom w-100 py-2 justify-content-center text-decoration-none d-flex align-items-center mb-3">
                Đăng nhập ngay <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
