@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; // We use a custom layout for the auth page to ensure full-screen effect
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DACS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        /* Allow scrolling when validation errors push content below the viewport */
        html, body.auth-page {
            overflow-y: auto !important;
            height: auto !important;
        }
        
        .password-wrapper {
            position: relative;
        }
        .btn-toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-toggle-password i {
            font-size: 1.1rem;
            color: var(--text-muted);
            transition: color 0.2s ease;
        }
        .btn-toggle-password:hover i {
            color: var(--primary);
        }
        
        /* Hide Microsoft Edge / IE default eye icon for password fields */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear,
        input::-ms-reveal,
        input::-ms-clear {
            display: none !important;
        }
    </style>
</head>
<body class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <i class="fa-solid fa-utensils"></i>
            </div>
            <h1 class="auth-title">Chào mừng trở lại</h1>
            <p class="auth-subtitle">Vui lòng đăng nhập để tiếp tục</p>
        </div>

        <form id="account" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control-custom" autocomplete="username" aria-required="true" placeholder="email@vi-du.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Password">Mật khẩu</label>
                <div class="password-wrapper">
                    <input asp-for="Input.Password" class="form-control-custom pe-5" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="btn-toggle-password" tabindex="-1">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                    <label class="form-check-label text-secondary small" style="text-transform: none; font-weight: 400; margin-bottom: 0;" for="rememberMe">
                        Ghi nhớ tôi
                    </label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="small text-primary text-decoration-none">Quên mật khẩu?</a>
            </div>

            <button id="login-submit" type="submit" class="w-100 btn-primary-custom py-2 justify-content-center">
                Đăng nhập <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
            </button>
        </form>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="auth-sep">Hoặc đăng nhập với</div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="auth-external-btns">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn-external" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                @if (provider.DisplayName == "Google") { <i class="fa-brands fa-google text-danger"></i> }
                                else if (provider.DisplayName == "Facebook") { <i class="fa-brands fa-facebook text-primary"></i> }
                                else { <i class="fa-solid fa-key"></i> }
                                <span>@provider.DisplayName</span>
                            </button>
                        }
                    </div>
                </form>
            }
        }

        <div class="auth-footer">
            Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.btn-toggle-password').click(function() {
                const passwordInput = $(this).siblings('input');
                const icon = $(this).find('i');
                
                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
