@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null; // Custom layout for auth page
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DACS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        /* Allow scrolling when validation errors push content below the viewport */
        html, body.auth-page {
            overflow-y: auto !important;
            height: auto !important;
        }
        
        .password-wrapper {
            position: relative;
        }
        .btn-toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-toggle-password i {
            font-size: 1.1rem;
            color: var(--text-muted);
            transition: color 0.2s ease;
        }
        .btn-toggle-password:hover i {
            color: var(--primary);
        }
        
        /* Hide Microsoft Edge / IE default eye icon for password fields */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear,
        input::-ms-reveal,
        input::-ms-clear {
            display: none !important;
        }

        /* Loading Overlay Styling */
        .loading-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .loading-box {
            background: white;
            padding: 2.5rem;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            text-align: center;
            max-width: 360px;
            width: 90%;
            animation: scaleUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        @@keyframes scaleUp {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body class="auth-page">
    <!-- Beautiful modern loading overlay -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="loading-box">
            <i class="fa-solid fa-circle-notch fa-spin text-primary mb-4" style="font-size: 3.5rem; color: #ea580c !important;"></i>
            <h4 class="fw-bold" style="color: #1e293b; font-size: 1.25rem;">Đang tạo tài khoản...</h4>
            <p class="text-muted small mb-0 mt-2">Vui lòng chờ trong giây lát để hệ thống khởi tạo.</p>
        </div>
    </div>

    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h1 class="auth-title">Tạo tài khoản</h1>
            <p class="auth-subtitle">Gia nhập cộng đồng người yêu ẩm thực</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control-custom" autocomplete="username" aria-required="true" placeholder="email@vi-du.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Password">Mật khẩu</label>
                <div class="password-wrapper">
                    <input asp-for="Input.Password" class="form-control-custom pe-5" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="btn-toggle-password" tabindex="-1">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                <div class="password-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="form-control-custom pe-5" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <button type="button" class="btn-toggle-password" tabindex="-1">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label class="form-label d-block mb-2">Tôi là...</label>
                <div class="role-selector">
                    <input type="radio" asp-for="Input.Role" value="Customer" id="role-customer" class="d-none" checked />
                    <label for="role-customer" class="role-option">
                        <i class="fa-solid fa-utensils"></i>
                        <span>Thực khách</span>
                    </label>

                    <input type="radio" asp-for="Input.Role" value="Owner" id="role-owner" class="d-none" />
                    <label for="role-owner" class="role-option">
                        <i class="fa-solid fa-shop"></i>
                        <span>Chủ quán</span>
                    </label>
                </div>
                <span asp-validation-for="Input.Role" class="text-danger small"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn-primary-custom py-2 justify-content-center">
                Đăng ký ngay <i class="fa-solid fa-check ms-2"></i>
            </button>
        </form>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="auth-sep">Hoặc đăng ký với</div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="auth-external-btns">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn-external" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                @if (provider.DisplayName == "Google") { <i class="fa-brands fa-google text-danger"></i> }
                                else if (provider.DisplayName == "Facebook") { <i class="fa-brands fa-facebook text-primary"></i> }
                                else { <i class="fa-solid fa-key"></i> }
                                <span>@provider.DisplayName</span>
                            </button>
                        }
                    </div>
                </form>
            }
        }

        <div class="auth-footer">
            Đã có tài khoản? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập ngay</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.btn-toggle-password').click(function() {
                const passwordInput = $(this).siblings('input');
                const icon = $(this).find('i');
                
                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Hiệu ứng load mượt mà khi submit form
            $('#registerForm').on('submit', function(e) {
                var $form = $(this);
                if ($form.valid()) {
                    var $submitBtn = $('#registerSubmit');
                    // Vô hiệu hóa nút bấm để tránh gửi trùng lặp và tạo cảm giác mượt mà
                    $submitBtn.prop('disabled', true);
                    $submitBtn.html('Đang xử lý... <i class="fa-solid fa-circle-notch fa-spin ms-2"></i>');
                    
                    // Hiển thị overlay làm mờ kính cường lực cao cấp
                    $('#loadingOverlay').css('display', 'flex').hide().fadeIn(200);
                }
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
