@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null; // Custom layout for auth page
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DACS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h1 class="auth-title">Tạo tài khoản</h1>
            <p class="auth-subtitle">Gia nhập cộng đồng người yêu ẩm thực</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control-custom" autocomplete="username" aria-required="true" placeholder="email@vi-du.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Password">Mật khẩu</label>
                <input asp-for="Input.Password" class="form-control-custom" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                <input asp-for="Input.ConfirmPassword" class="form-control-custom" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label class="form-label d-block mb-2">Tôi là...</label>
                <div class="role-selector">
                    <input type="radio" asp-for="Input.Role" value="Customer" id="role-customer" class="d-none" checked />
                    <label for="role-customer" class="role-option">
                        <i class="fa-solid fa-utensils"></i>
                        <span>Thực khách</span>
                    </label>

                    <input type="radio" asp-for="Input.Role" value="Owner" id="role-owner" class="d-none" />
                    <label for="role-owner" class="role-option">
                        <i class="fa-solid fa-shop"></i>
                        <span>Chủ quán</span>
                    </label>
                </div>
                <span asp-validation-for="Input.Role" class="text-danger small"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn-primary-custom py-2 justify-content-center">
                Đăng ký ngay <i class="fa-solid fa-check ms-2"></i>
            </button>
        </form>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="auth-sep">Hoặc đăng ký với</div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="auth-external-btns">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn-external" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                @if (provider.DisplayName == "Google") { <i class="fa-brands fa-google text-danger"></i> }
                                else if (provider.DisplayName == "Facebook") { <i class="fa-brands fa-facebook text-primary"></i> }
                                else { <i class="fa-solid fa-key"></i> }
                                <span>@provider.DisplayName</span>
                            </button>
                        }
                    </div>
                </form>
            }
        }

        <div class="auth-footer">
            Đã có tài khoản? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập ngay</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
