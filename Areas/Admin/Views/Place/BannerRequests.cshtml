@model IEnumerable<DACS.Models.Place>
@{
    ViewData["Title"] = "Duyệt Banner Quảng Cáo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .proof-thumb  { width:100px;height:64px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer;transition:transform .2s; }
    .proof-thumb:hover { transform:scale(1.08); }
    .banner-thumb { width:160px;height:60px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer;transition:transform .2s; }
    .banner-thumb:hover { transform:scale(1.05); }
    .lightbox-overlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:9999;align-items:center;justify-content:center;padding:2rem;cursor:zoom-out; }
    .lightbox-overlay.open { display:flex; }
    .lightbox-overlay img { max-width:90vw;max-height:85vh;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.5);cursor:default; }
    .lightbox-close { position:fixed;top:1.5rem;right:1.5rem;color:#fff;font-size:2rem;cursor:pointer;opacity:.7;transition:opacity .2s; }
    .lightbox-close:hover { opacity:1; }
    .pending-count-badge { display:inline-flex;align-items:center;justify-content:center;background:rgba(251,191,36,.15);border:1px solid rgba(251,191,36,.4);color:#fbbf24;font-size:.8rem;font-weight:700;border-radius:999px;padding:.2rem .7rem;margin-left:.5rem; }
    /* Bảng cuộn nội tại – thanh trượt ngang luôn hiển thị */
    .table-responsive {
        overflow: auto;
        max-height: calc(100vh - 220px);
        border-radius: 0 0 var(--radius, 12px) var(--radius, 12px);
    }
    .table-responsive thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--surface-light, #1e293b);
        box-shadow: 0 1px 0 rgba(255,255,255,0.08);
    }
</style>

<div class="admin-container animate-in">
    <div class="section-header">
        <h1 class="section-title">
            <span class="icon">🧾</span> Duyệt Banner Quảng Cáo
            <span class="pending-count-badge">@Model.Count() chờ duyệt</span>
        </h1>
        <a asp-action="Index" class="btn-outline-custom">← Về Quản lý địa điểm</a>
    </div>

    @if (TempData["Success"] != null)
    { <div class="alert-glass success mb-4">✅ @TempData["Success"]</div> }
    @if (TempData["Error"] != null)
    { <div class="alert-glass mb-4" style="background:rgba(239,68,68,.1);border-color:rgba(239,68,68,.3);color:#ef4444;">❌ @TempData["Error"]</div> }

    <div class="card-glass p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center">
                <div style="font-size:3rem;margin-bottom:1rem;">🎉</div>
                <h4 style="color:var(--text-primary)">Không có yêu cầu nào đang chờ</h4>
                <p style="color:var(--text-secondary)">Tất cả yêu cầu banner đã được xử lý.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Địa điểm</th>
                            <th>Loại</th>
                            <th>Banner đã upload</th>
                            <th>Biên lai TT</th>
                            <th>Thông tin TT</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                                        {
                                            <img src="@p.ImageUrl" style="width:36px;height:36px;border-radius:6px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div style="width:36px;height:36px;border-radius:6px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;">@(p.Category?.Icon ?? "📍")</div>
                                        }
                                        <div>
                                            <div style="font-weight:600;color:var(--text-primary);">@p.Name</div>
                                            <div style="font-size:.75rem;color:var(--text-muted);">#@p.Id · @p.Owner?.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="background:rgba(255,255,255,.08);color:var(--text-secondary);border:1px solid var(--border);">
                                        @(p.Category?.Icon) @(p.Category?.Name ?? "—")
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.BannerUrl))
                                    { <img src="@p.BannerUrl" class="banner-thumb" onclick="openLightbox('@p.BannerUrl')" title="Xem banner" alt="Banner" /> }
                                    else { <span style="color:var(--text-muted);font-size:.8rem;">Không có</span> }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.PaymentProofUrl))
                                    {
                                        if (p.PaymentProofUrl.StartsWith("vnpay:"))
                                        {
                                            <span class="badge" style="background:rgba(56,189,248,.15);color:#38bdf8;border:1px solid rgba(56,189,248,.3);font-size:.8rem;padding:.3rem .6rem;">
                                                💳 VNPay: @p.PaymentProofUrl.Substring(6)
                                            </span>
                                        }
                                        else
                                        {
                                            <img src="@p.PaymentProofUrl" class="proof-thumb" onclick="openLightbox('@p.PaymentProofUrl')" title="Xem biên lai" alt="Biên lai" />
                                        }
                                    }
                                    else { <span style="color:#ef4444;font-size:.8rem;">⚠️ Thiếu biên lai</span> }
                                </td>
                                <td>
                                    <div style="font-size:.8rem;color:var(--text-secondary);">
                                        <div>💰 <strong style="color:#fbbf24;">10,000 VNĐ</strong></div>
                                        <div style="margin-top:.25rem;font-family:monospace;color:var(--text-muted);">Nội dung: Quang cao @p.Id</div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <form asp-action="ApproveBanner" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn-success-custom" title="Duyệt banner">✅ Duyệt</button>
                                        </form>
                                        <button onclick="confirmReject(@p.Id, '@p.Name')" class="btn-danger-custom" title="Từ chối">❌ Từ chối</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="lightbox-overlay" id="lightbox" onclick="closeLightbox()">
    <span class="lightbox-close" onclick="closeLightbox()">✕</span>
    <img id="lightboxImg" src="" alt="Preview" onclick="event.stopPropagation()" />
</div>

<div id="rejectModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <div class="modal-title">Xác nhận từ chối</div>
        <div class="modal-desc">
            Bạn có chắc muốn từ chối banner của "<b id="rejectName"></b>"?
            <br /><span style="color:#ef4444;font-size:.85rem;">Banner và biên lai sẽ bị xóa.</span>
        </div>
        <div class="modal-actions">
            <button onclick="closeReject()" class="btn-outline-custom">Hủy</button>
            <form id="rejectForm" method="post" asp-action="RejectBanner">
                <input type="hidden" name="id" id="rejectId" />
                <button type="submit" class="btn-primary-custom" style="background:#ef4444;">❌ Từ chối</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openLightbox(src){document.getElementById('lightboxImg').src=src;document.getElementById('lightbox').classList.add('open');document.body.style.overflow='hidden';}
    function closeLightbox(){document.getElementById('lightbox').classList.remove('open');document.body.style.overflow='';}
    function confirmReject(id,name){document.getElementById('rejectId').value=id;document.getElementById('rejectName').textContent=name;document.getElementById('rejectModal').style.display='flex';}
    function closeReject(){document.getElementById('rejectModal').style.display='none';}
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeLightbox();closeReject();}});
</script>
}
